modul64() {
   15:	
   14:	R9 = 1L; 
   13:	ECX = EDI; ECX = ECX >>ls 63; 
   12:	EDI = EDI * 2 + 0 (long); 
   11:	R8 = ESI; R8 = R8 >>lu 63; 
   10:	EDI = EDI |l R8; 
    9:	ESI = ESI * 2 + 0 (long); 
    8:	EAX = EDI; EAX = EAX |l ECX; 
    7:	if (EAX >=lu EDX) goto 6 else goto 4
    6:	EDI = EDI -l EDX; 
    5:	ESI = ESI + 1 (long); 
    4:	R9 = R9 + 1 (long); 
    3:	if (R9 <=ls 64) goto 13 else goto 2
    2:	EAX = EDI; 
    1:	return
}

