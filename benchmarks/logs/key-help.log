      [<inputFiles>...]
      --auto                 start automatic prove procedure after
                               initialisation without GUI
      --auto-loadonly        load files automatically without proving (for
                               testing)
      --autosave=number      save intermediate proof states each n proof steps
                               to a temporary location (default: 0 = off)
      --clear-prefs          clear the GUI preferences
      --debug                start KeY in debug mode
      --examples=FOLDER      load the directory containing the example files on
                               startup
      --experimental         switch experimental features on
      --K-help               display help for technical/debug parameters
      --keep-fileRepos       disables the automatic deletion of
                               temporarydirectories of file repos (for
                               debugging)
      --last                 flag whether recent loaded file should be loaded
                               on startup
      --macro=STRING         apply automatic proof macro
      --no-jmlspecs          disable parsing JML specifications
      --no-pruning-closed    disables pruning and goal back in closed branches
                               (saves memory)
      --save-all             save all selected contracts for automatic execution
      --show-properties      list all Java properties and exit
      --tacletDir=FOLDER     load base taclets from a directory, not from
                               internal structures
      --timeout=INT          timeout for each automatic proof of a problem in
                               ms (default: -1, i.e., no timeout)
