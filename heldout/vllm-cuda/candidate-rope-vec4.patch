From 8de5ec90f348a4f8e73c83567590dc86a20b8472 Mon Sep 17 00:00:00 2001
From: veriop <hantaolou@berkeley.edu>
Date: Wed, 14 Oct 2026 17:21:21 -0700
Subject: [PATCH] [Kernel] 4-wide NeoX rotary_embedding path for 16-bit
 query/key/cache

Same CTA-per-token mapping and per-element formula as rotary_embedding_kernel;
8-byte vector loads/stores and a single query+key work list.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 csrc/libtorch_stable/pos_encoding_kernels.cu | 131 +++++++++++++++++++
 1 file changed, 131 insertions(+)

diff --git a/csrc/libtorch_stable/pos_encoding_kernels.cu b/csrc/libtorch_stable/pos_encoding_kernels.cu
index 74af743..d5b18e3 100644
--- a/csrc/libtorch_stable/pos_encoding_kernels.cu
+++ b/csrc/libtorch_stable/pos_encoding_kernels.cu
@@ -98,6 +98,90 @@ __global__ void rotary_embedding_kernel(
       inverse);
 }
 
+// 4-wide variant of rotary_embedding_kernel for 16-bit types with a cache of
+// the same dtype, GPT-NeoX style only. Same CTA-per-token mapping and the same
+// per-element formula; each work item covers four consecutive rotary offsets
+// of one query or key head, loaded and stored as 8-byte vectors, and query and
+// key heads share a single work list.
+template <typename scalar_t>
+__device__ __forceinline__ void load_vec4(const scalar_t* p, scalar_t (&v)[4]) {
+  const ushort4 b = *reinterpret_cast<const ushort4*>(p);
+  v[0] = scalar_t(b.x, scalar_t::from_bits());
+  v[1] = scalar_t(b.y, scalar_t::from_bits());
+  v[2] = scalar_t(b.z, scalar_t::from_bits());
+  v[3] = scalar_t(b.w, scalar_t::from_bits());
+}
+
+template <typename scalar_t>
+__device__ __forceinline__ void ldg_vec4(const scalar_t* p, scalar_t (&v)[4]) {
+  const ushort4 b = VLLM_LDG(reinterpret_cast<const ushort4*>(p));
+  v[0] = scalar_t(b.x, scalar_t::from_bits());
+  v[1] = scalar_t(b.y, scalar_t::from_bits());
+  v[2] = scalar_t(b.z, scalar_t::from_bits());
+  v[3] = scalar_t(b.w, scalar_t::from_bits());
+}
+
+template <typename scalar_t>
+__device__ __forceinline__ void store_vec4(scalar_t* p, const scalar_t (&v)[4]) {
+  *reinterpret_cast<ushort4*>(p) = make_ushort4(v[0].x, v[1].x, v[2].x, v[3].x);
+}
+
+template <typename scalar_t>
+__global__ void rotary_embedding_neox_vec4_kernel(
+    const int64_t* __restrict__ positions,  // [batch_size, seq_len] or
+                                            // [num_tokens]
+    scalar_t* __restrict__ query,  // [batch_size, seq_len, num_heads,
+                                   // head_size] or [num_tokens, num_heads,
+                                   // head_size]
+    scalar_t* __restrict__ key,    // nullptr or
+                                   // [batch_size, seq_len, num_kv_heads,
+                                   // head_size] or [num_tokens, num_kv_heads,
+                                   // head_size]
+    const scalar_t* __restrict__ cos_sin_cache,  // [max_position, rot_dim]
+    const int rot_dim, const int64_t query_stride, const int64_t key_stride,
+    const int64_t head_stride, const int num_heads, const int num_kv_heads,
+    const int head_size, const int64_t rope_dim_offset, const bool inverse) {
+  const int token_idx = blockIdx.x;
+  int64_t pos = positions[token_idx];
+  const scalar_t* cos_ptr = cos_sin_cache + pos * rot_dim;
+  const int embed_dim = rot_dim / 2;
+  const scalar_t* sin_ptr = cos_ptr + embed_dim;
+  const int chunks = embed_dim / 4;
+  const int nq = num_heads * chunks;
+  const int n_total = nq + (key != nullptr ? num_kv_heads * chunks : 0);
+
+  for (int i = threadIdx.x; i < n_total; i += blockDim.x) {
+    const bool is_q = i < nq;
+    const int ii = is_q ? i : i - nq;
+    const int head_idx = ii / chunks;
+    const int rot_offset = (ii % chunks) * 4;
+    scalar_t* arr =
+        is_q ? query + (token_idx * query_stride + head_idx * head_stride +
+                        rope_dim_offset)
+             : key + (token_idx * key_stride + head_idx * head_stride +
+                      rope_dim_offset);
+    scalar_t x[4], y[4], c[4], s[4];
+    load_vec4(arr + rot_offset, x);
+    load_vec4(arr + embed_dim + rot_offset, y);
+    ldg_vec4(cos_ptr + rot_offset, c);
+    ldg_vec4(sin_ptr + rot_offset, s);
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+      const float cos_f = static_cast<float>(c[j]);
+      float sin_f = static_cast<float>(s[j]);
+      if (inverse) {
+        sin_f = -sin_f;
+      }
+      const float x_f = static_cast<float>(x[j]);
+      const float y_f = static_cast<float>(y[j]);
+      x[j] = static_cast<scalar_t>(x_f * cos_f - y_f * sin_f);
+      y[j] = static_cast<scalar_t>(y_f * cos_f + x_f * sin_f);
+    }
+    store_vec4(arr + rot_offset, x);
+    store_vec4(arr + embed_dim + rot_offset, y);
+  }
+}
+
 }  // namespace vllm
 
 void rotary_embedding(
@@ -169,6 +253,53 @@ void rotary_embedding(
   const torch::stable::accelerator::DeviceGuard device_guard(
       query.get_device_index());
   const cudaStream_t stream = get_current_cuda_stream();
+
+  // 4-wide NeoX path: 16-bit query/key with a cache of the same dtype, all
+  // element offsets multiples of 4 and 8-byte aligned base pointers.
+  const bool is_16bit = query.scalar_type() == cos_sin_cache.scalar_type() &&
+                        (query.scalar_type() ==
+                             torch::headeronly::ScalarType::BFloat16 ||
+                         query.scalar_type() ==
+                             torch::headeronly::ScalarType::Half);
+  auto aligned8 = [](const void* p) {
+    return reinterpret_cast<std::uintptr_t>(p) % 8 == 0;
+  };
+  const int embed_dim = rot_dim / 2;
+  if (is_neox && is_16bit && embed_dim % 4 == 0 && query_stride % 4 == 0 &&
+      key_stride % 4 == 0 && head_stride % 4 == 0 && rope_dim_offset % 4 == 0 &&
+      aligned8(query.data_ptr()) &&
+      (!key.has_value() || aligned8(key->data_ptr())) &&
+      aligned8(cos_sin_cache.data_ptr())) {
+    const int64_t n_items =
+        static_cast<int64_t>(num_heads +
+                             (key.has_value() ? num_kv_heads : 0)) *
+        (embed_dim / 4);
+    dim3 vec_block(std::min<int64_t>((n_items + 31) / 32 * 32, 256));
+    THO_DISPATCH_SWITCH(
+        query.scalar_type(), "rotary_embedding_neox_vec4",
+        THO_DISPATCH_CASE(torch::headeronly::ScalarType::Half, [&] {
+          vllm::rotary_embedding_neox_vec4_kernel<scalar_t>
+              <<<grid, vec_block, 0, stream>>>(
+                  positions.const_data_ptr<int64_t>(),
+                  query.mutable_data_ptr<scalar_t>(),
+                  key.has_value() ? key->mutable_data_ptr<scalar_t>()
+                                  : nullptr,
+                  cos_sin_cache.const_data_ptr<scalar_t>(), rot_dim,
+                  query_stride, key_stride, head_stride, num_heads,
+                  num_kv_heads, head_size, rope_dim_offset, inverse);
+        }) THO_DISPATCH_CASE(torch::headeronly::ScalarType::BFloat16, [&] {
+          vllm::rotary_embedding_neox_vec4_kernel<scalar_t>
+              <<<grid, vec_block, 0, stream>>>(
+                  positions.const_data_ptr<int64_t>(),
+                  query.mutable_data_ptr<scalar_t>(),
+                  key.has_value() ? key->mutable_data_ptr<scalar_t>()
+                                  : nullptr,
+                  cos_sin_cache.const_data_ptr<scalar_t>(), rot_dim,
+                  query_stride, key_stride, head_stride, num_heads,
+                  num_kv_heads, head_size, rope_dim_offset, inverse);
+        }));
+    return;
+  }
   VLLM_STABLE_DISPATCH_FLOATING_TYPES(
       query.scalar_type(), "rotary_embedding", [&] {
         using query_t = scalar_t;
-- 
