+/// [veriop] Sorted element indices as inclusive runs "a-b,c-d" ("-" if empty).
+fn index_ranges(elems: &[(u64, volta_analysis::symbolic::ExprId)]) -> String {
+    let mut idx: Vec<u64> = elems.iter().map(|e| e.0).collect();
+    idx.sort_unstable();
+    idx.dedup();
+    let mut runs: Vec<String> = Vec::new();
+    let mut i = 0;
+    while i < idx.len() {
+        let mut j = i;
+        while j + 1 < idx.len() && idx[j + 1] == idx[j] + 1 {
+            j += 1;
+        }
+        runs.push(format!("{}-{}", idx[i], idx[j]));
+        i = j + 1;
+    }
+    if runs.is_empty() { "-".to_string() } else { runs.join(",") }
