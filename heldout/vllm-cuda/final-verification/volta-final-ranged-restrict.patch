@@ -0,0 +1,435 @@
+//! [veriop-ranged] Data-dependent global-load addressing through *ranged
+//! integer inputs* (opt-in; inert unless `AnalysisConfig::ranged_inputs` is
+//! non-empty).
+//!
+//! Upstream Volta requires every address to be concrete. A kernel such as
+//! vLLM's rotary embedding reads `pos = positions[blockIdx.x]` and then loads
+//! `cos_sin_cache[pos * rot_dim + j]`, so its addresses depend on input data.
+//! With a ranged input, `positions` elements stay symbolic atoms `P` known
+//! only to lie in `[lo, hi)`, and one symbolic run covers every such value.
+//!
+//! Soundness argument (each point is enforced below or in `interp.rs`):
+//!
+//! 1. A ranged atom may influence the run only through global-load
+//!    addresses. Stores of any value depending on it are rejected
+//!    (`ranged_write_check`), guards and other control values must be
+//!    concrete (upstream), and every other address must be concrete
+//!    (upstream `effective_addr`). A value read through a ranged address is
+//!    input *data* (a `SymbolicRead` atom), not a ranged-derived value.
+//! 2. A ranged address must be `c0 + c1 * P` for one atom `P`, built only
+//!    from integer constants, the atom itself, and nodes *created* by
+//!    integer `add/sub/mul/shl(by constant)/neg` instructions of width >= 32
+//!    bits (`int_nodes`). Float arithmetic, bit operations, division, min/max,
+//!    selects and narrow (< 32-bit) arithmetic never qualify, and conversions
+//!    of ranged values involving a float or a < 32-bit type are rejected.
+//! 3. Every non-leaf node of that expression, and the atom range itself, lies
+//!    in `[0, 2^31)` for every `P` in the range. PTX `add/sub/mul.lo/shl/neg`
+//!    of any width w >= 32 are exact modulo 2^w (ring homomorphisms), and a
+//!    value in `[0, 2^31)` is unchanged by sign or zero extension and by
+//!    truncation to >= 32 bits; so the typeless node values equal the
+//!    register values the hardware computes, for every `P` in range.
+//! 4. For every `P` in range the access lies inside one declared `in` array
+//!    (affine, so the two end points suffice), is naturally aligned
+//!    (`c0`, `c1` multiples of the access size) and element aligned.
+//!    That array is never written during the run (checked in both orders),
+//!    so the loaded value is the initial content `array[k0 + k1*P]`, which
+//!    is exactly what the `SymbolicRead` node denotes; the equivalence
+//!    checker treats it as an uninterpreted read, equal only for
+//!    syntactically equal canonical indices (sound). No race can involve a
+//!    never-written array.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::eval::ThreadId;
+use crate::eval::config::ArrayKind;
+use crate::eval::error::{EvalError, EvalResult};
+use crate::eval::interp::Interpreter;
+use crate::eval::value::Value;
+use crate::lowered::{InstrId, MemSpace, Operand};
+use crate::symbolic::{ExprId, ExprNode};
+
+/// Every non-leaf node of a ranged address must lie in `[0, 2^31)`.
+const AFFINE_BOUND: i128 = 1 << 31;
+
+/// Per-run bookkeeping for ranged inputs.
+#[derive(Default)]
+pub struct RangedState {
+    /// Memo for `contains_ranged`.
+    taint_memo: HashMap<ExprId, bool>,
+    /// Nodes freshly created by integer add/sub/mul/shl/neg of width >= 32.
+    int_nodes: HashSet<ExprId>,
+    /// Arrays (indices into `config.arrays`) read through a ranged address.
+    symread_arrays: HashSet<usize>,
+    /// Arrays written at least once.
+    written_arrays: HashSet<usize>,
+}
+
+/// `value = c0 + c1 * atom` (atom = None: the constant `c0`).
+#[derive(Clone, Copy)]
+struct Affine {
+    c0: i128,
+    c1: i128,
+    atom: Option<(ExprId, i64, i64)>,
+}
+
+fn unsupported(pc: InstrId, what: impl Into<String>) -> EvalError {
+    EvalError::Unsupported {
+        pc,
+        what: format!("[veriop-ranged] {}", what.into()),
+    }
+}
+
+impl<'p> Interpreter<'p> {
+    pub(in crate::eval) fn ranged_active(&self) -> bool {
+        !self.config.ranged_inputs.is_empty()
+    }
+
+    /// The `[lo, hi)` range if `e` is an element of a ranged input array.
+    fn ranged_bounds_of(&self, e: ExprId) -> Option<(i64, i64)> {
+        if let ExprNode::InputElement { array, .. } = self.arena.node(e) {
+            let name = self.arena.string(*array);
+            self.config
+                .ranged_inputs
+                .iter()
+                .find(|r| r.name == name)
+                .map(|r| (r.lo, r.hi))
+        } else {
+            None
+        }
+    }
+
+    /// Whether `e` depends on a ranged atom other than through the index of
+    /// a `SymbolicRead` (the value read there is input data).
+    pub(in crate::eval) fn contains_ranged(&mut self, e: ExprId) -> bool {
+        if let Some(&b) = self.ranged.taint_memo.get(&e) {
+            return b;
+        }
+        let mut stack = vec![(e, false)];
+        while let Some((x, expanded)) = stack.pop() {
+            if self.ranged.taint_memo.contains_key(&x) {
+                continue;
+            }
+            if matches!(self.arena.node(x), ExprNode::SymbolicRead { .. }) {
+                self.ranged.taint_memo.insert(x, false);
+                continue;
+            }
+            if self.ranged_bounds_of(x).is_some() {
+                self.ranged.taint_memo.insert(x, true);
+                continue;
+            }
+            let mut kids = Vec::new();
+            self.arena.node(x).for_each_child(|c| kids.push(c));
+            if expanded {
+                let b = kids.iter().any(|c| self.ranged.taint_memo[c]);
+                self.ranged.taint_memo.insert(x, b);
+            } else {
+                stack.push((x, true));
+                for c in kids {
+                    if !self.ranged.taint_memo.contains_key(&c) {
+                        stack.push((c, false));
+                    }
+                }
+            }
+        }
+        self.ranged.taint_memo[&e]
+    }
+
+    /// Reject a ranged-derived operand of an instruction whose type is a
+    /// float or narrower than 32 bits (`int_bits` = None for floats).
+    pub(in crate::eval) fn ranged_guard(
+        &mut self,
+        pc: InstrId,
+        int_bits: Option<u32>,
+        ops: &[ExprId],
+        what: &str,
+    ) -> EvalResult<()> {
+        if !self.ranged_active() || matches!(int_bits, Some(b) if b >= 32) {
+            return Ok(());
+        }
+        for &e in ops {
+            if self.contains_ranged(e) {
+                return Err(unsupported(
+                    pc,
+                    format!(
+                        "ranged-input-derived operand of a {} {}",
+                        match int_bits {
+                            Some(b) => format!("{}-bit integer", b),
+                            None => "float".to_string(),
+                        },
+                        what
+                    ),
+                ));
+            }
+        }
+        Ok(())
+    }
+
+    /// Record `r` as created by an integer add/sub/mul/shl/neg of width
+    /// `bits`, if it is a node pushed after `before` (a builder that
+    /// returns an existing operand node creates nothing new).
+    pub(in crate::eval) fn ranged_tag_int(&mut self, before: usize, bits: u32, r: ExprId) {
+        if self.ranged_active() && bits >= 32 && r.0 as usize >= before {
+            self.ranged.int_nodes.insert(r);
+        }
+    }
+
+    fn affine_of(&self, e: ExprId) -> Option<Affine> {
+        let node = self.arena.node(e);
+        if let ExprNode::IntConst(v) = node {
+            return Some(Affine { c0: *v as i128, c1: 0, atom: None });
+        }
+        let r = if let Some((lo, hi)) = self.ranged_bounds_of(e) {
+            Affine { c0: 0, c1: 1, atom: Some((e, lo, hi)) }
+        } else {
+            if !self.ranged.int_nodes.contains(&e) {
+                return None;
+            }
+            match node {
+                ExprNode::Add(a, b) | ExprNode::Sub(a, b) => {
+                    let (x, y) = (self.affine_of(*a)?, self.affine_of(*b)?);
+                    let atom = self.join_atoms(x.atom, y.atom)?;
+                    let (c0, c1) = if matches!(node, ExprNode::Add(..)) {
+                        (x.c0.checked_add(y.c0)?, x.c1.checked_add(y.c1)?)
+                    } else {
+                        (x.c0.checked_sub(y.c0)?, x.c1.checked_sub(y.c1)?)
+                    };
+                    Affine { c0, c1, atom }
+                }
+                ExprNode::Mul(a, b) => {
+                    let (x, y) = (self.affine_of(*a)?, self.affine_of(*b)?);
+                    let (k, v) = match (x.atom, y.atom) {
+                        (None, _) => (x.c0, y),
+                        (_, None) => (y.c0, x),
+                        _ => return None,
+                    };
+                    Affine { c0: v.c0.checked_mul(k)?, c1: v.c1.checked_mul(k)?, atom: v.atom }
+                }
+                ExprNode::Shl(a, b) => {
+                    let x = self.affine_of(*a)?;
+                    let k = self.arena.as_int_const(*b)?;
+                    if !(0..=62).contains(&k) {
+                        return None;
+                    }
+                    let m = 1i128 << k;
+                    Affine { c0: x.c0.checked_mul(m)?, c1: x.c1.checked_mul(m)?, atom: x.atom }
+                }
+                ExprNode::Neg(a) => {
+                    let x = self.affine_of(*a)?;
+                    Affine { c0: x.c0.checked_neg()?, c1: x.c1.checked_neg()?, atom: x.atom }
+                }
+                _ => return None,
+            }
+        };
+        // Non-leaf (and atom) value range must stay inside [0, 2^31).
+        let (vmin, vmax) = self.affine_range(&r)?;
+        if vmin < 0 || vmax >= AFFINE_BOUND {
+            return None;
+        }
+        Some(r)
+    }
+
+    fn join_atoms(
+        &self,
+        a: Option<(ExprId, i64, i64)>,
+        b: Option<(ExprId, i64, i64)>,
+    ) -> Option<Option<(ExprId, i64, i64)>> {
+        match (a, b) {
+            (None, x) | (x, None) => Some(x),
+            (Some(x), Some(y)) => {
+                // Same atom = same element of the same ranged array.
+                let key = |e: ExprId| match self.arena.node(e) {
+                    ExprNode::InputElement { array, index } => {
+                        Some((self.arena.string(*array).to_string(), *index))
+                    }
+                    _ => None,
+                };
+                if key(x.0)? == key(y.0)? { Some(Some(x)) } else { None }
+            }
+        }
+    }
+
+    fn affine_range(&self, r: &Affine) -> Option<(i128, i128)> {
+        match r.atom {
+            None => Some((r.c0, r.c0)),
+            Some((_, lo, hi)) => {
+                let a = r.c0.checked_add(r.c1.checked_mul(lo as i128)?)?;
+                let b = r.c0.checked_add(r.c1.checked_mul((hi - 1) as i128)?)?;
+                Some((a.min(b), a.max(b)))
+            }
+        }
+    }
+
+    /// A global load whose base is not concrete: if it is a ranged address
+    /// (see module docs), return the `count` loaded elements of width
+    /// `elem_w` each as `SymbolicRead` nodes; `Ok(None)` means the base is
+    /// concrete (or ranged inputs are off) and the normal path applies.
+    #[allow(clippy::too_many_arguments)]
+    pub(in crate::eval) fn try_ranged_load(
+        &mut self,
+        t: ThreadId,
+        pc: InstrId,
+        space: MemSpace,
+        base: &Operand,
+        offset: i64,
+        elem_w: u64,
+        count: u64,
+    ) -> EvalResult<Option<Vec<ExprId>>> {
+        if !self.ranged_active() {
+            return Ok(None);
+        }
+        let e = match self.operand_value(t, pc, base)? {
+            Value::Scalar(e) => e,
+            Value::Pair(..) => return Ok(None),
+        };
+        if self.arena.as_i64(e).is_some() {
+            return Ok(None);
+        }
+        if space != MemSpace::Global {
+            return Err(unsupported(pc, format!("symbolic {:?}-space address", space)));
+        }
+        let aff = self.affine_of(e).ok_or_else(|| {
+            unsupported(
+                pc,
+                "symbolic address is not an exact affine integer function of one ranged input",
+            )
+        })?;
+        let Some((atom, lo, hi)) = aff.atom else {
+            return Err(unsupported(pc, "symbolic address without a ranged atom"));
+        };
+        let c0 = aff.c0.checked_add(offset as i128).ok_or_else(|| unsupported(pc, "overflow"))?;
+        let c1 = aff.c1;
+        if c1 <= 0 {
+            return Err(unsupported(pc, "ranged address must increase with the ranged input"));
+        }
+        let total = (elem_w * count) as i128;
+        let amin = c0 + c1 * lo as i128;
+        let amax = c0 + c1 * (hi - 1) as i128;
+        let Some(ai) = self.config.arrays.iter().position(|a| {
+            (a.base as i128) <= amin && amax + total <= a.base as i128 + a.size_bytes() as i128
+        }) else {
+            return Err(unsupported(
+                pc,
+                format!(
+                    "ranged access [{:#x}+{}*P, P in [{}, {})) leaves every declared array \
+                     for some P (thread {})",
+                    c0, c1, lo, hi, t
+                ),
+            ));
+        };
+        let (name, base, ew, kind) = {
+            let a = &self.config.arrays[ai];
+            (a.name.clone(), a.base as i128, a.elem_width as i128, a.kind)
+        };
+        if kind != ArrayKind::Input {
+            return Err(unsupported(pc, format!("ranged read of non-`in` array '{}'", name)));
+        }
+        if ew != elem_w as i128 {
+            return Err(unsupported(
+                pc,
+                format!("ranged read of '{}' at width {} != element width {}", name, elem_w, ew),
+            ));
+        }
+        if c0 % total != 0 || c1 % total != 0 || (c0 - base) % ew != 0 || c1 % ew != 0 {
+            return Err(unsupported(pc, format!("ranged read of '{}' not aligned for every P", name)));
+        }
+        if self.ranged.written_arrays.contains(&ai) {
+            return Err(unsupported(pc, format!("ranged read of '{}', which this run writes", name)));
+        }
+        self.ranged.symread_arrays.insert(ai);
+        let (k0, k1) = ((c0 - base) / ew, c1 / ew);
+        let mut out = Vec::with_capacity(count as usize);
+        for j in 0..count as i128 {
+            let kc = self.arena.int((k0 + j) as i64);
+            let kk = self.arena.int(k1 as i64);
+            let m = self.arena.mul(kk, atom);
+            let ix = self.arena.add(kc, m);
+            out.push(self.arena.symbolic_read(&name, ix));
+        }
+        Ok(Some(out))
+    }
+
+    /// After a normal (concrete-address) load: a ranged element must be read
+    /// at exactly its element width.
+    pub(in crate::eval) fn ranged_check_loaded(
+        &mut self,
+        pc: InstrId,
+        width: u64,
+        v: Value,
+    ) -> EvalResult<()> {
+        if !self.ranged_active() {
+            return Ok(());
+        }
+        let parts = match v {
+            Value::Scalar(e) => vec![e],
+            Value::Pair(a, b) => vec![a, b],
+        };
+        for e in parts {
+            if self.contains_ranged(e) {
+                let full = matches!(v, Value::Scalar(_))
+                    && self.ranged_bounds_of(e).is_some()
+                    && self.ranged_elem_width(e) == Some(width);
+                if !full {
+                    return Err(unsupported(pc, "ranged element loaded at a width other than its own"));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn ranged_elem_width(&self, e: ExprId) -> Option<u64> {
+        if let ExprNode::InputElement { array, .. } = self.arena.node(e) {
+            self.config.array(self.arena.string(*array)).map(|a| a.elem_width)
+        } else {
+            None
+        }
+    }
+
+    /// Before every memory write: no ranged-derived value may be stored, and
+    /// no array read through a ranged address (or a ranged array) may be
+    /// written.
+    pub(in crate::eval) fn ranged_write_check(
+        &mut self,
+        pc: InstrId,
+        space: MemSpace,
+        addr: u64,
+        width: u64,
+        value: Value,
+    ) -> EvalResult<()> {
+        if !self.ranged_active() {
+            return Ok(());
+        }
+        let parts = match value {
+            Value::Scalar(e) => vec![e],
+            Value::Pair(a, b) => vec![a, b],
+        };
+        for e in parts {
+            if self.contains_ranged(e) {
+                return Err(unsupported(pc, "a ranged-input-derived value is stored to memory"));
+            }
+        }
+        if space == MemSpace::Global {
+            let end = addr as u128 + width as u128;
+            let hits: Vec<usize> = self
+                .config
+                .arrays
+                .iter()
+                .enumerate()
+                .filter(|(_, a)| (a.base as u128) < end && (addr as u128) < a.base as u128 + a.size_bytes() as u128)
+                .map(|(i, _)| i)
+                .collect();
+            for i in hits {
+                let name = self.config.arrays[i].name.clone();
+                if self.ranged.symread_arrays.contains(&i)
+                    || self.config.ranged_inputs.iter().any(|r| r.name == name)
+                {
+                    return Err(unsupported(
+                        pc,
+                        format!("write to '{}', which is ranged or read through a ranged address", name),
+                    ));
+                }
+                self.ranged.written_arrays.insert(i);
+            }
+        }
+        Ok(())
+    }
+}
