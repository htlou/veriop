+// =========================================================================
+// Syntactic (structural) identity of paired output expressions
+// =========================================================================
+
+/// Whether expression `a` in `ra` and expression `b` in `rb` are the same
+/// term: same node kinds, same constants, same input elements (by array
+/// name and index), same children in the same order, recursively. No
+/// algebraic reasoning at all (no commutativity, no reassociation). Fresh
+/// machine symbols, `Discarded` and `Undefined` never match (conservative).
+pub fn exprs_syntactically_identical(ra: &ExprArena, a: ExprId, rb: &ExprArena, b: ExprId) -> bool {
+    let mut memo: std::collections::HashSet<(u32, u32)> = std::collections::HashSet::new();
+    let mut stack = vec![(a, b)];
+    while let Some((x, y)) = stack.pop() {
+        if !memo.insert((x.0, y.0)) {
+            continue;
+        }
+        let (nx, ny) = (ra.node(x), rb.node(y));
+        if std::mem::discriminant(nx) != std::mem::discriminant(ny) {
+            return false;
+        }
+        let atoms_equal = match (nx, ny) {
+            (ExprNode::IntConst(p), ExprNode::IntConst(q)) => p == q,
+            (ExprNode::RealConst(p), ExprNode::RealConst(q)) => p == q,
+            (ExprNode::BoolConst(p), ExprNode::BoolConst(q)) => p == q,
+            (ExprNode::ParamSymbol(p), ExprNode::ParamSymbol(q)) => ra.string(*p) == rb.string(*q),
+            (
+                ExprNode::InputElement { array: p, index: i },
+                ExprNode::InputElement { array: q, index: j },
+            ) => ra.string(*p) == rb.string(*q) && i == j,
+            (ExprNode::SymbolicRead { array: p, .. }, ExprNode::SymbolicRead { array: q, .. }) => {
+                ra.string(*p) == rb.string(*q)
+            }
+            (ExprNode::Symbol(_), _) | (ExprNode::Discarded, _) | (ExprNode::Undefined, _) => false,
+            _ => true, // operator nodes: compared through their children below
+        };
+        if !atoms_equal {
+            return false;
+        }
+        let (mut cx, mut cy) = (Vec::new(), Vec::new());
+        nx.for_each_child(|c| cx.push(c));
+        ny.for_each_child(|c| cy.push(c));
+        if cx.len() != cy.len() {
+            return false;
+        }
+        stack.extend(cx.into_iter().zip(cy));
+    }
+    true
+}
+
+/// Count of paired elements (over `arrays`, all elements) whose reference
+/// and optimized expressions are syntactically identical, and the total.
+pub fn count_syntactically_identical(
+    reference: &AnalysisOutput,
+    optimized: &AnalysisOutput,
+    arrays: &[String],
+) -> Result<(usize, usize), EquivCheckError> {
+    let paired = paired_elements(reference, optimized, arrays)?;
+    let mut same = 0;
+    let mut total = 0;
+    for (_, elems) in &paired {
+        for &(_, ea, eb) in elems {
+            total += 1;
+            if exprs_syntactically_identical(&reference.arena, ea, &optimized.arena, eb) {
+                same += 1;
+            }
+        }
+    }
+    Ok((same, total))
+}
