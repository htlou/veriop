+// activation_kernel's 128-bit vector path with the same launch shape (one CTA
+// per token, min(d / VEC_SIZE, 1024) threads), but each thread issues the
+// loads of all of its (up to MAX_ITEMS) vectors before computing and storing
+// any of them, instead of one load-compute-store round trip per vector.
+template <typename scalar_t, scalar_t (*ACT_FN)(const scalar_t&),
+          int MAX_ITEMS>
+__global__ void activation_vec_prefetch_kernel(
+    scalar_t* __restrict__ out,          // [..., d]
+    const scalar_t* __restrict__ input,  // [..., d]
+    const int d) {
+  const int64_t token_idx = blockIdx.x;
+  const scalar_t* in_ptr = input + token_idx * d;
+  scalar_t* out_ptr = out + token_idx * d;
+  constexpr int VEC_SIZE = sizeof(int4) / sizeof(scalar_t);
+  const int4* in_vec = reinterpret_cast<const int4*>(in_ptr);
+  int4* out_vec = reinterpret_cast<int4*>(out_ptr);
+  const int num_vecs = d / VEC_SIZE;
+
+  int4 v[MAX_ITEMS];
+#pragma unroll
+  for (int j = 0; j < MAX_ITEMS; j++) {
+    const int i = threadIdx.x + j * blockDim.x;
+    if (i < num_vecs) {
+      v[j] = VLLM_LDG(&in_vec[i]);
+    }
+  }
+#pragma unroll
+  for (int j = 0; j < MAX_ITEMS; j++) {
+    const int i = threadIdx.x + j * blockDim.x;
+    if (i < num_vecs) {
+      auto* vp = reinterpret_cast<scalar_t*>(&v[j]);
+#pragma unroll
+      for (int k = 0; k < VEC_SIZE; k++) {
+        vp[k] = ACT_FN(vp[k]);
+      }
+      out_vec[i] = v[j];
+    }
+  }
+}
+
 }  // namespace vllm
 
