From 350db6cb2f19940f61cd468e740d887945aa2c86 Mon Sep 17 00:00:00 2001
From: veriop <hantaolou@berkeley.edu>
Date: Wed, 14 Oct 2026 17:54:21 -0700
Subject: [PATCH 1/2] [Kernel] flat grid-stride relu_squared path for
 small-batch fp32 rows

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 csrc/libtorch_stable/activation_kernels.cu | 39 ++++++++++++++++++++--
 1 file changed, 37 insertions(+), 2 deletions(-)

diff --git a/csrc/libtorch_stable/activation_kernels.cu b/csrc/libtorch_stable/activation_kernels.cu
index a7ee87b..b2d37ca 100644
--- a/csrc/libtorch_stable/activation_kernels.cu
+++ b/csrc/libtorch_stable/activation_kernels.cu
@@ -1348,10 +1348,35 @@ __global__ void activation_kernel(
   }
 }
 
+// Flat grid-stride variant of activation_kernel's 128-bit vector path over
+// all numel = num_tokens * d elements: rows are contiguous and
+// d % VEC_SIZE == 0, so the flattened vectors are exactly the per-row vectors.
+template <typename scalar_t, scalar_t (*ACT_FN)(const scalar_t&)>
+__global__ void activation_flat_vec_kernel(
+    scalar_t* __restrict__ out,          // [..., d]
+    const scalar_t* __restrict__ input,  // [..., d]
+    const int numel) {
+  constexpr int VEC_SIZE = sizeof(int4) / sizeof(scalar_t);
+  const int4* in_vec = reinterpret_cast<const int4*>(input);
+  int4* out_vec = reinterpret_cast<int4*>(out);
+  const int num_vecs = numel / VEC_SIZE;
+  for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < num_vecs;
+       i += gridDim.x * blockDim.x) {
+    int4 v = VLLM_LDG(&in_vec[i]);
+    auto* vp = reinterpret_cast<scalar_t*>(&v);
+#pragma unroll
+    for (int k = 0; k < VEC_SIZE; k++) {
+      vp[k] = ACT_FN(vp[k]);
+    }
+    out_vec[i] = v;
+  }
+}
+
 }  // namespace vllm
 
 // Launch element-wise activation kernel.
-#define LAUNCH_ACTIVATION_KERNEL(KERNEL)                                       \
+#define LAUNCH_ACTIVATION_KERNEL(KERNEL) LAUNCH_ACTIVATION_KERNEL_IMPL(KERNEL, false)
+#define LAUNCH_ACTIVATION_KERNEL_IMPL(KERNEL, FLAT_FP32)                                       \
   auto dtype = input.scalar_type();                                            \
   int d = input.size(-1);                                                      \
   int64_t num_tokens = input.numel() / input.size(-1);                         \
@@ -1377,6 +1402,16 @@ __global__ void activation_kernel(
             <<<grid, block, 0, stream>>>(out.mutable_data_ptr<scalar_t>(),     \
                                          input.const_data_ptr<scalar_t>(), d); \
       });                                                                      \
+    } else if (FLAT_FP32 && dtype == torch::headeronly::ScalarType::Float &&   \
+               d / vec_size > 1024 && num_tokens <= 256 &&                     \
+               num_tokens * d <= std::numeric_limits<int>::max()) {            \
+      const int numel = static_cast<int>(num_tokens * d);                      \
+      const int flat_blocks = std::min((numel / vec_size + 127) / 128,         \
+                                       8 * get_device_prop()->multiProcessorCount); \
+      vllm::activation_flat_vec_kernel<float, KERNEL<float>>                   \
+          <<<flat_blocks, 128, 0, stream>>>(out.mutable_data_ptr<float>(),     \
+                                            input.const_data_ptr<float>(),     \
+                                            numel);                            \
     } else {                                                                   \
       VLLM_STABLE_DISPATCH_FLOATING_TYPES(dtype, "activation_kernel", [&] {    \
         vllm::activation_kernel<scalar_t, KERNEL<scalar_t>, true, false>       \
@@ -1447,5 +1482,5 @@ void gelu_quick(torch::stable::Tensor& out,    // [..., d]
 void relu_squared(torch::stable::Tensor& out,    // [..., d]
                   torch::stable::Tensor& input)  // [..., d]
 {
-  LAUNCH_ACTIVATION_KERNEL(vllm::relu_squared_kernel);
+  LAUNCH_ACTIVATION_KERNEL_IMPL(vllm::relu_squared_kernel, true);
 }
-- 
