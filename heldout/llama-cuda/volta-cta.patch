+/// Parse a CTA index "x[,y[,z]]"; missing components are 0 (not 1 as for
+/// dimensions).
+fn parse_cta(s: &str) -> Result<(u32, u32, u32), String> {
+    let mut v = [0u32; 3];
+    let parts: Vec<&str> = s.split(',').collect();
+    if parts.len() > 3 {
+        return Err(format!("expected at most 3 components, got '{}'", s));
+    }
+    for (i, p) in parts.iter().enumerate() {
+        v[i] = p.trim().parse::<u32>().map_err(|e| e.to_string())?;
+    }
+    Ok((v[0], v[1], v[2]))
+}
