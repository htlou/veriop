+/// The decode table of the standard alphabet (checked against `decode_table(&STANDARD)` in tests).
+const STANDARD_DECODE_TABLE: [u8; 256] = [
+    255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255,
+    255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255,
