+    255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255, 255,
+];
+
+/// Two-symbol decode table for the standard alphabet, indexed by `first | second << 8`.
+/// Entries are `first_value << 6 | second_value` when both symbols decode to values below 64,
+/// and `0xFFFF` otherwise.
+static STANDARD_DECODE_PAIRS: [u16; 65536] = {
+    let mut pairs = [0_u16; 65536];
+    let mut i = 0;
+    while i < 65536 {
+        let first = STANDARD_DECODE_TABLE[i & 0xFF];
+        let second = STANDARD_DECODE_TABLE[i >> 8];
+        pairs[i] = if first < 64 && second < 64 {
+            (first as u16) << 6 | second as u16
+        } else {
+            0xFFFF
+        };
+        i += 1;
+    }
+    pairs
+};
+
+/// Decode 32 standard-alphabet symbols into 24 bytes using the two-symbol table.
+/// Returns `false`, leaving `output` unchanged, if any symbol is outside the alphabet.
+#[inline(always)]
+fn decode_chunk_32_pairs(input: &[u8], output: &mut [u8]) -> bool {
+    let p0 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[0], input[1]]))];
+    let p1 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[2], input[3]]))];
+    let p2 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[4], input[5]]))];
+    let p3 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[6], input[7]]))];
+    let p4 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[8], input[9]]))];
+    let p5 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[10], input[11]]))];
+    let p6 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[12], input[13]]))];
+    let p7 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[14], input[15]]))];
+    let p8 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[16], input[17]]))];
+    let p9 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[18], input[19]]))];
+    let p10 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[20], input[21]]))];
+    let p11 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[22], input[23]]))];
+    let p12 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[24], input[25]]))];
+    let p13 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[26], input[27]]))];
+    let p14 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[28], input[29]]))];
+    let p15 = STANDARD_DECODE_PAIRS[usize::from(u16::from_le_bytes([input[30], input[31]]))];
+    if (p0 | p1 | p2 | p3 | p4 | p5 | p6 | p7 | p8 | p9 | p10 | p11 | p12 | p13 | p14 | p15) >= 0x1000 {
+        return false;
+    }
+    let a0 = u64::from(p0) << 36 | u64::from(p1) << 24 | u64::from(p2) << 12 | u64::from(p3);
+    let a1 = u64::from(p4) << 36 | u64::from(p5) << 24 | u64::from(p6) << 12 | u64::from(p7);
+    let a2 = u64::from(p8) << 36 | u64::from(p9) << 24 | u64::from(p10) << 12 | u64::from(p11);
+    let a3 = u64::from(p12) << 36 | u64::from(p13) << 24 | u64::from(p14) << 12 | u64::from(p15);
+    output[0..6].copy_from_slice(&(a0 << 16).to_be_bytes()[..6]);
+    output[6..12].copy_from_slice(&(a1 << 16).to_be_bytes()[..6]);
+    output[12..18].copy_from_slice(&(a2 << 16).to_be_bytes()[..6]);
+    output[18..24].copy_from_slice(&(a3 << 16).to_be_bytes()[..6]);
+    true
+}
