+(** Builtin information of a trait declaration.
+
+    Specialized [FnOnce] traits (produced by Charon's partial monomorphization
+    with mutable-borrow arguments) can return updated mutable arguments: we
+    generate their signatures instead of using the generic builtin model, whose
+    [Output] parameter does not include that state. (Logic of the pilot's
+    aeneas-specialized-fnonce patch, moved to its own module.) *)
+let builtin_trait_decl_info (ctx : Contexts.decls_ctx) (name : Types.name) :
+    Pure.builtin_trait_decl_info option =
+  let builtin_info =
+    TranslateCore.match_name_find_opt ctx name
+      (ExtractBuiltin.builtin_trait_decls_map ())
+  in
+  match builtin_info with
+  | Some info
+    when info.extract_name = "core.ops.function.FnOnce"
+         && List.exists
+              (function
+                | Types.PeInstantiated _ -> true
+                | _ -> false)
+              name -> None
+  | _ -> builtin_info
