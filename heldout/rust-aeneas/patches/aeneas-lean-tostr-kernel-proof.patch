+/-- The UTF-8 byte size of a string is the sum of the UTF-8 sizes of its characters. -/
+theorem toStr_size_eq_sum_utf8Size (s : String) :
+    s.toByteArray.size = (s.toList.map Char.utf8Size).sum := by
+  have : s.toByteArray = s.toList.utf8Encode := by
+    rw [← String.toByteArray_ofList, String.ofList_toList]
+  rw [this, List.utf8Encode, List.size_toByteArray, List.length_flatMap]
+  simp only [String.length_utf8EncodeChar]
+
+/-- The size bound is first proved in the kernel (via `toStr_size_eq_sum_utf8Size`; `String.toList`
+    of a literal is computed by the `reduceToList` simproc), so that string literals in extracted
+    models do not depend on a `decide +native` axiom. `decide +native` remains as a fallback. -/
+def toStr (s : String) (h : s.toByteArray.size ≤ U32.max := by
+    first
+    | (rw [Aeneas.Std.toStr_size_eq_sum_utf8Size];
+       simp [Char.utf8Size, Aeneas.Std.U32.max, Aeneas.Std.U32.numBits]; done)
+    | decide +native) : Str :=
   .from (s.toByteArray.toList.map
     (fun x => ⟨ x.toNat, by cases x; simp only [UInt8.toNat_ofBitVec, UScalarTy.U8_numBits_eq, Nat.reducePow]; omega  ⟩))
