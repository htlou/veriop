+// Fast path for decimal uint16_t parsing from char when at least eight
+// bytes are readable. It handles the two common shapes -- exactly five or
+// exactly four decimal digits followed by a non-digit -- with one 8-byte load.
+// Any leading '0' is harmless here (it does not change the value and the
+// digits are consumed either way), and since the first byte is a digit no
+// white space, sign or base prefix can be present. Each shape returns a
+// constant pointer offset, so the caller's next parse does not depend on the
+// loaded bytes. Returns false, without touching `value` or `answer`,
+// whenever the general path must decide.
+fastfloat_really_inline bool
+try_parse_u16_fast(char const *p, char const *pend, uint16_t &value,
+                   from_chars_result_t<char> &answer) noexcept {
+  if (pend - p < 8) {
+    return false;
+  }
+  uint64_t const chunk = read8_to_u64(p);
+  // Bit 7 of byte k is set if byte k is not a digit; exact for the lowest
+  // non-digit byte (digits never generate a carry or borrow).
+  uint64_t const nondigit =
+      ((chunk + 0x4646464646464646) | (chunk - 0x3030303030303030)) &
+      0x8080808080808080;
+  uint32_t const four = parse_four_digits_unrolled(uint32_t(chunk));
+  if ((nondigit & 0x0000808080808080) == 0x0000800000000000) {
+    // d0 d1 d2 d3 d4 x
+    uint32_t const v = four * 10 + uint32_t((chunk >> 32) & 0xFF) - '0';
+    answer.ptr = p + 5;
+    if (v > 65535) {
+      answer.ec = std::errc::result_out_of_range;
+    } else {
+      value = uint16_t(v);
+      answer.ec = std::errc();
+    }
+    return true;
+  }
+  if ((nondigit & 0x0000008080808080) == 0x0000008000000000) {
+    // d0 d1 d2 d3 x
+    value = uint16_t(four);
+    answer.ptr = p + 4;
+    answer.ec = std::errc();
+    return true;
+  }
+  return false;
+}
