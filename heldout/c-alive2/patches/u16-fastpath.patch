+// Out-of-line copy of the general parser, used as the slow path of the
+// uint16_t/char fast path so that the fast path stays small (no spills).
+template <typename T, typename UC>
+fastfloat_never_inline FASTFLOAT_CONSTEXPR20 from_chars_result_t<UC>
+from_chars_int_advanced_slow(UC const *first, UC const *last, T &value,
+                             parse_options_t<UC> options) noexcept {
+  return from_chars_int_advanced_general(first, last, value, options);
+}
+
+template <typename T, typename UC>
+fastfloat_really_inline FASTFLOAT_CONSTEXPR20 from_chars_result_t<UC>
+from_chars_int_advanced_rest(UC const *first, UC const *last, T &value,
+                             parse_options_t<UC> options,
+                             std::true_type /* uint16_t/char */) noexcept {
+  return from_chars_int_advanced_slow(first, last, value, options);
+}
+
+template <typename T, typename UC>
+fastfloat_really_inline FASTFLOAT_CONSTEXPR20 from_chars_result_t<UC>
+from_chars_int_advanced_rest(UC const *first, UC const *last, T &value,
+                             parse_options_t<UC> options,
+                             std::false_type /* other types */) noexcept {
+  return from_chars_int_advanced_general(first, last, value, options);
+}
+
+template <typename T, typename UC>
+FASTFLOAT_CONSTEXPR20 from_chars_result_t<UC>
+from_chars_int_advanced(UC const *first, UC const *last, T &value,
+                        parse_options_t<UC> options) noexcept {
+  using is_u16_char =
+      std::integral_constant<bool, std::is_same<T, std::uint16_t>::value &&
+                                       std::is_same<UC, char>::value>;
+  FASTFLOAT_IF_CONSTEXPR17(is_u16_char::value) {
+    from_chars_result_t<UC> answer;
+    if (!cpp20_and_in_constexpr() && options.base == 10 &&
+        try_parse_u16_fast(
+            reinterpret_cast<char const *>(first),
+            reinterpret_cast<char const *>(last),
+            reinterpret_cast<uint16_t &>(value),
+            reinterpret_cast<from_chars_result_t<char> &>(answer))) {
+      return answer;
+    }
+  }
+  return from_chars_int_advanced_rest(first, last, value, options,
+                                      is_u16_char());
+}
