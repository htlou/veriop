+/* count trailing zeroes for nonzero 64-bit integers */
+fastfloat_really_inline FASTFLOAT_CONSTEXPR20 int
+countr_zero_64(uint64_t input_num) {
+  if (cpp20_and_in_constexpr()) {
+    int low = countr_zero_generic_32(uint32_t(input_num));
+    return low != 32 ? low
+                     : 32 + countr_zero_generic_32(uint32_t(input_num >> 32));
+  }
+#if defined(FASTFLOAT_VISUAL_STUDIO) && defined(_WIN64)
+  unsigned long trailing_zero = 0;
+  _BitScanForward64(&trailing_zero, input_num);
+  return static_cast<int>(trailing_zero);
+#elif defined(FASTFLOAT_VISUAL_STUDIO)
+  int low = countr_zero_32(uint32_t(input_num));
+  return low != 32 ? low : 32 + countr_zero_32(uint32_t(input_num >> 32));
+#else
+  return __builtin_ctzll(input_num);
+#endif
+}
