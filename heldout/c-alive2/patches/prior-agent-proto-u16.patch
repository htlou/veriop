+// Fast path for decimal uint16_t from char: at least eight readable bytes
+// and a first character in '1'..'9' (so no white space, sign or leading
+// zero can be present). Converts one to five digits with a single 8-byte
+// load and no branch on the digit count. Returns false, without touching
+// `value` or `answer`, whenever the general path must decide.
+fastfloat_really_inline bool
+try_parse_u16_digits8(char const *p, char const *pend, uint16_t &value,
+                      from_chars_result_t<char> &answer) noexcept {
+  if (pend - p < 8) {
+    return false;
+  }
+  uint64_t const chunk = read8_to_u64(p);
+  uint64_t const nondigit =
+      ((chunk + 0x4646464646464646) | (chunk - 0x3030303030303030)) &
+      0x8080808080808080;
+  uint32_t const lead = uint32_t(chunk & 0xFF) - uint32_t('1');
+  uint32_t const nd = nondigit ? uint32_t(countr_zero_64(nondigit) >> 3) : 8u;
+  if (lead > 8 || nd > 5) {
+    return false;
+  }
+  // Move the nd digits to the top bytes and pad the low bytes with '0'.
+  uint64_t const aligned =
+      (chunk << (64 - 8 * nd)) | (uint64_t(0x3030303030303030) >> (8 * nd));
+  uint32_t const v = parse_eight_digits_unrolled(aligned);
+#ifdef FF_BRANCH_PTR
+  // Branch on the (usually predictable) digit count so that the returned
+  // pointer does not depend on the loaded bytes.
+  if (nd == 5) {
+    answer.ptr = p + 5;
+  } else if (nd == 4) {
+    answer.ptr = p + 4;
+  } else {
+    answer.ptr = p + nd;
+  }
+#else
+  answer.ptr = p + nd;
+#endif
+  if (v > 65535) {
+    answer.ec = std::errc::result_out_of_range;
+  } else {
+    value = uint16_t(v);
+    answer.ec = std::errc();
+  }
+  return true;
+}
