+#[cfg(all(test, feature = "safe-decode"))]
+mod overlap_copy_tests {
+    use super::{Sink, SliceSink};
+
+    #[test]
+    fn overlap_matches_bytewise_copy() {
+        for pos in 0..65 {
+            for start in 0..=pos {
+                for count in 0..257 {
+                    let mut expected: Vec<u8> = (0..pos + count + 17)
+                        .map(|i| (i * 37 + 11) as u8).collect();
+                    let mut actual = expected.clone();
+                    for i in pos..pos + count {
+                        expected[i] = expected[i - (pos - start)];
+                    }
+                    let mut sink = SliceSink::new(&mut actual, pos);
+                    sink.extend_from_within_overlapping(start, count);
+                    assert_eq!(sink.pos(), pos + count);
+                    assert_eq!(actual, expected, "pos={pos}, start={start}, count={count}");
+                }
+            }
+        }
+    }
+}
