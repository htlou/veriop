diff --git a/src/symbolic/SymbolicToPure.ml b/src/symbolic/SymbolicToPure.ml
index c96eaf86..49e98ca7 100644
--- a/src/symbolic/SymbolicToPure.ml
+++ b/src/symbolic/SymbolicToPure.ml
@@ -219,6 +219,21 @@ let translate_trait_decl (ctx : Contexts.decls_ctx) (trait_decl : A.trait_decl)
     match_name_find_opt ctx trait_decl.item_meta.name
       (ExtractBuiltin.builtin_trait_decls_map ())
   in
+  let builtin_info =
+    match builtin_info with
+    | Some info
+      when info.extract_name = "core.ops.function.FnOnce"
+           && List.exists
+                (function
+                  | T.PeInstantiated _ -> true
+                  | _ -> false)
+                trait_decl.item_meta.name ->
+        (* Specialized FnOnce traits can return updated mutable arguments.
+           Generate their signatures instead of using the generic model,
+           whose Output parameter does not include that state. *)
+        None
+    | _ -> builtin_info
+  in
   if (not (T.AssocTypeId.Map.is_empty types)) && builtin_info = None then
     (* Most associated types are removed by Charon's `--remove-associated-types`. *)
     [%warn] span
