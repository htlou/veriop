", buf);"},{"DocComment":""},{"DocComment":"     buf.clear();"},{"DocComment":"     CUSTOM_ENGINE.encode_string(b\"hello internet~\", &mut buf);"},{"DocComment":"     println!(\"{}\", buf);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":187,"col":4},"end":{"line":187,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":286},{"Deduplicated":2},{"Value":[300,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":6},"Mut"]}]}],"output":{"Deduplicated":54}},"default":{"id":27,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":22},{"Deduplicated":2},{"Deduplicated":23},{"Deduplicated":28}],"const_generics":[],"trait_refs":[{"Deduplicated":45},{"Deduplicated":46}]}}},"kind":{"TraitMethod":[4,5]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":9},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":24}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"encode_slice","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["encode_slice",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":227,"col":4},"end":{"line":256,"col":5}},"generated_from_span":null}},"source_text":"fn encode_slice<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        output_buf: &mut [u8],\n    ) -> Result<usize, EncodeSliceError> {\n        #[inline(always)]\n        fn inner<E>(\n            engine: &E,\n            input_bytes: &[u8],\n            output_buf: &mut [u8],\n        ) -> Result<usize, EncodeSliceError>\n        where\n            E: Engine + ?Sized,\n        {\n            let encoded_size = encoded_len(input_bytes.len(), engine.config().encode_padding())\n                .expect(\"usize overflow when calculating buffer size\");\n\n            if output_buf.len() < encoded_size {\n                return Err(EncodeSliceError::OutputSliceTooSmall);\n            }\n\n            let b64_output = &mut output_buf[0..encoded_size];\n\n            encode_with_padding(input_bytes, b64_output, engine, encoded_size);\n\n            Ok(encoded_size)\n        }\n\n        inner(self, input.as_ref(), output_buf)\n    }","attr_info":{"attributes":[{"DocComment":" Encode arbitrary octets as base64 into a supplied slice."},{"DocComment":" Writes into the supplied output buffer."},{"DocComment":""},{"DocComment":" This is useful if you wish to avoid allocation entirely (e.g. encoding into a stack-resident"},{"DocComment":" or statically-allocated buffer)."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":"```"},{"DocComment":" use base64::{Engine as _, engine::general_purpose};"},{"DocComment":" let s = b\"hello internet!\";"},{"DocComment":" let mut buf = Vec::new();"},{"DocComment":" // make sure we'll have a slice big enough for base64 + padding"},{"DocComment":" buf.resize(s.len() * 4 / 3 + 4, 0);"},{"DocComment":""},{"DocComment":" let bytes_written = general_purpose::STANDARD.encode_slice(s, &mut buf).unwrap();"},{"DocComment":""},{"DocComment":" // shorten our vec down to just what was written"},{"DocComment":" buf.truncate(bytes_written);"},{"DocComment":""},{"DocComment":" assert_eq!(s, general_purpose::STANDARD.decode(&buf).unwrap().as_slice());"},{"DocComment":" ```"},{"Builtin":{"