et: usize,\n        /// The offending symbol\n        symbol: u8,\n        /// The bits the symbol corresponds to.\n        ///\n        /// Since this error is being reported, this value has high bits erroneously set.\n        /// For a 2-symbol suffix, only the first 2 bits may be set (6 + 2 = 8 bits,\n        /// 1 byte), and for a 3 symbol, only the first 4 (6 + 6 + 4 = 16, 2 bytes).\n        symbol_value: u8,\n    },\n    /// The nature of the padding was not as configured: absent or incorrect when it must be\n    /// canonical, or present when it must be absent, etc.\n    InvalidPadding,\n}","attr_info":{"attributes":[{"DocComment":" Errors that can occur while decoding."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Enum":[{"id":0,"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":18,"col":4},"end":{"line":18,"col":15}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" An invalid byte was found in the input. The offset and offending byte are provided."},{"DocComment":""},{"DocComment":" Padding characters (`=`) interspersed in the encoded form are invalid, as they may only"},{"DocComment":" be present as the last 0-2 bytes of input."},{"DocComment":""},{"DocComment":" This error may also indicate that extraneous trailing input bytes are present, causing"},{"DocComment":" otherwise valid padding to no longer be the last bytes of input."}],"inline":null,"rename":null,"public":true},"name":"InvalidByte","fields":[{"span":{"Untagged":{"data":{"file_id":15,"beg":{"line":18,"col":16},"end":{"line":18,"col":21}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"name":"_0","is_positional":t