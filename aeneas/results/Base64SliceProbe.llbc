}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":569,"col":4},"end":{"line":569,"col":67}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts a vector of bytes to a `String`."},{"DocComment":""},{"DocComment":" A string ([`String`]) is made of bytes ([`u8`]), and a vector of bytes"},{"DocComment":" ([`Vec<u8>`]) is made of bytes, so this function converts between the"},{"DocComment":" two. Not all byte slices are valid `String`s, however: `String`"},{"DocComment":" requires that it is valid UTF-8. `from_utf8()` checks to ensure that"},{"DocComment":" the bytes are valid UTF-8, and then does the conversion."},{"DocComment":""},{"DocComment":" If you are sure that the byte slice is valid UTF-8, and you don't want"},{"DocComment":" to incur the overhead of the validity check, there is an unsafe version"},{"DocComment":" of this function, [`from_utf8_unchecked`], which has the same behavior"},{"DocComment":" but skips the check."},{"DocComment":""},{"DocComment":" This method will take care to not copy the vector, for efficiency's"},{"DocComment":" sake."},{"DocComment":""},{"DocComment":" If you need a [`&str`] instead of a `String`, consider"},{"DocComment":" [`str::from_utf8`]."},{"DocComment":""},{"DocComment":" The inverse of this method is [`into_bytes`]."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns [`Err`] if the slice is not UTF-8 with a description as to why the"},{"DocComment":" provided bytes are not UTF-8. The vector you moved in is also included."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We know these bytes are valid, so we'll use `unwrap()`."},{"DocComment":" let sparkle_heart = String::from_utf8(sparkle_heart).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Incorrect bytes:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some invalid bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![0, 159, 146, 150];"},{"DocComment":""},{"DocComment":" assert!(String::from_utf8(sparkle_heart).is_err());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the docs for [`FromUtf8Error`] for more details on what you can do"},{"DocComment":" with this error."},{"DocComment":""},{"DocComment":" [`from_utf8_unchecked`]: String::from_utf8_unchecked"},{"DocComment":" [`Vec<u8>`]: crate::vec::Vec \"Vec\""},{"DocComment":" [`&str`]: prim@str \"&str\""},{"DocComment":" [`into_bytes`]: String::into_bytes"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"string_from_utf8","has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":150}],"output":{"Deduplicated":177}},"src":"Normal","body":"Opaque"},{"def_id":55,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"E","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":7},"kind":"InherentImplBlock"}}},{"Ident":["expect",0]}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":1178,"col":4},"end":{"line":1180,"col":22}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the contained [`Ok`] value, consuming the `self` value."},{"DocComment":""},{"DocComment":" Because this function may panic, its use is generally discouraged."},{"DocComment":" Instead, prefer to use pattern matching and handle the [`Err`]"},{"DocComment":" case explicitly, or call [`unwrap_or`], [`unwrap_or_else`], or"},{"DocComment":" [`unwrap_or_default`]."},{"DocComment":""},{"DocComment":" [`unwrap_or`]: Result::unwrap_or"},{"DocComment":" [`unwrap_or_else`]: Result::unwrap_or_else"},{"DocComment":" [`unwrap_or_default`]: Result::unwrap_or_default"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the value is an [`Err`], with a panic message including the"},{"DocComment":" passed message, and the content of the [`Err`]."},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let x: Result<u32, &str> = Err(\"emergency failure\");"},{"DocComment":" x.expect(\"Testing expect\"); // panics with `Testing expect: emergency failure`"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Recommended Message Style"},{"DocComment":""},{"DocComment":" We recommend that `expect` messages are used to describe the reason you"},{"DocComment":" _expect_ the `Result` should be `Ok`."},{"DocComment":""},{"DocComment":" ```should_panic"},{"DocComment":" let path = std::env::var(\"IMPORTANT_PATH\")"},{"DocComment":"     .expect(\"env variable `IMPORTANT_PATH` should be set by `wrapper_script.sh`\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" **Hint**: If you're having trouble remembering how to phrase expect"},{"DocComment":" error messages remember to focus on the word \"should\" as in \"env"},{"DocComment":" variable should be set by blah\" or \"the given binary should be available"},{"DocComment":" and executable by the current user\"."},{"DocComment":""},{"DocComment":" For more detail on expect message styles and the reasoning behind our recommendation please"},{"DocComment":" refer to the section on [\"Common Message"},{"DocComme