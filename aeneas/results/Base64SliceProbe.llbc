ue","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'e","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"E","variance":"Unknown"},{"index":1,"name":"Clause0_Config","variance":"Invariant"},{"index":2,"name":"Clause0_DecodeEstimate","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":0},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":22},{"Deduplicated":23},{"Deduplicated":28}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":22},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":40}],"output":{"Value":[250,{"Adt":{"id":30,"generics":{"regions":[{"Var":{"Free":0}}],"types":[{"Deduplicated":22},{"Deduplicated":23},{"Deduplicated":28}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":58,"item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["chunked_encoder",0]},{"Impl":{"Ty":{"params":{"regions":[{"index":0,"name":"'e","variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"E","variance":"Unknown"},{"index":1,"name":"Clause0_Config","variance":"Invariant"},{"index":2,"name":"Clause0_DecodeEstimate","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":0},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":10},{"Deduplicated":14},{"Deduplicated":15}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":16},"kind":"InherentImplBlock"}}},{"Ident":["encode",0]}],"span":{"Untagged":{"data":{"file_id":33,"beg":{"line":28,"col":4},"end":{"line":46,"col":5}},"generated_from_span":null}},"source_text":"pub fn encode<S: Sink>(&self, bytes: &[u8], sink: &mut S) -> Result<(), S::Error> {\n        const BUF_SIZE: usize = 1024;\n        const CHUNK_SIZE: usize = BUF_SIZE / 4 * 3;\n\n        let mut buf = [0; BUF_SIZE];\n        for chunk in bytes.chunks(CHUNK_SIZE) {\n            let mut len = self.engine.internal_encode(chunk, &mut buf);\n            if chunk.len() != CHUNK_SIZE && self.engine.config().encode_padding() {\n                // Final, potentially partial, chunk.\n                // Only need to consider if padding is needed on a partial chunk since full chunk\n                // is a multiple of 3, which therefore won't be padded.\n                // Pad output to multiple of four bytes if required by config.\n                len += add_padding(len, self.engine.padding(), &mut buf[len..]);\n            }\n            sink.write_encoded_bytes(&buf[..len])?;\n        }\n\n        Ok(())\n    }","attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":"'e","variance":"Unknown","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":3,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"E","variance":"Unknown"},{"index":1,"name":"S","variance":"Invariant"},{"index":2,"name":"Clause0_Config","variance":"Invariant"},{"index":3,"name":"Clause0_DecodeEstimate","variance":"Invariant"},{"index":4,"name":"Clause1_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":0},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":22},{"Deduplicated":28},{"Deduplic