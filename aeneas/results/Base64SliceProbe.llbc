    if output_buf.len() < encoded_size {\n                return Err(EncodeSliceError::OutputSliceTooSmall);\n            }\n\n            let b64_output = &mut output_buf[0..encoded_size];\n\n            encode_with_padding(input_bytes, b64_output, engine, encoded_size);\n\n            Ok(encoded_size)\n        }\n\n        inner(self, input.as_ref(), output_buf)\n    }","attr_info":{"attributes":[{"DocComment":" Encode arbitrary octets as base64 into a supplied slice."},{"DocComment":" Writes into the supplied output buffer."},{"DocComment":""},{"DocComment":" This is useful if you wish to avoid allocation entirely (e.g. encoding into a stack-resident"},{"DocComment":" or statically-allocated buffer)."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":"```"},{"DocComment":" use base64::{Engine as _, engine::general_purpose};"},{"DocComment":" let s = b\"hello internet!\";"},{"DocComment":" let mut buf = Vec::new();"},{"DocComment":" // make sure we'll have a slice big enough for base64 + padding"},{"DocComment":" buf.resize(s.len() * 4 / 3 + 4, 0);"},{"DocComment":""},{"DocComment":" let bytes_written = general_purpose::STANDARD.encode_slice(s, &mut buf).unwrap();"},{"DocComment":""},{"DocComment":" // shorten our vec down to just what was written"},{"DocComment":" buf.truncate(bytes_written);"},{"DocComment":""},{"DocComment":" assert_eq!(s, general_purpose::STANDARD.decode(&buf).unwrap().as_slice());"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":226,"col":4},"end":{"line":226,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"