mall => {\n                        unreachable!(\"Vec is sized conservatively\")\n                    }\n                })?\n                .decoded_len;\n\n            buffer.truncate(starting_output_len + bytes_written);\n\n            Ok(())\n        }\n\n        inner(self, input.as_ref(), buffer)\n    }","attr_info":{"attributes":[{"DocComment":" Decode the `input` into the supplied `buffer`."},{"DocComment":""},{"DocComment":" Writes into the supplied `Vec`, which may allocate if its internal buffer isn't big enough."},{"DocComment":" Returns a `Result` containing an empty tuple, aka `()`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use base64::{Engine as _, alphabet, engine::{self, general_purpose}};"},{"DocComment":" const CUSTOM_ENGINE: engine::GeneralPurpose ="},{"DocComment":"     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::PAD);"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     use base64::Engine;"},{"DocComment":"     let mut buffer = Vec::<u8>::new();"},{"DocComment":"     // with the default engine"},{"DocComment":"     general_purpose::STANDARD"},{"DocComment":"         .decode_vec(\"aGVsbG8gd29ybGR+Cg==\", &mut buffer,).unwrap();"},{"DocComment":"     println!(\"{:?}\", buffer);"},{"DocComment":""},{"DocComment":"     buffer.clear();"},{"DocComment":""},{"DocComment":"     // with a custom engine"},{"DocComment":"     CUSTOM_ENGINE.decode_vec("},{"DocComment":"         \"aGVsbG8gaW50ZXJuZXR-Cg==\","},{"DocComment":"         &mut buffer,"},{"DocComment":"     ).unwrap();"},{"DocComment":"     println!(\"{:?}\", buffer);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":335,"col":4},"end":{"line":335,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item"