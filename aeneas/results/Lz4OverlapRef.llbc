: the overflow happens"},{"DocComment":" in the call to `next` that yields the maximum value, as the range must be"},{"DocComment":" set to a state to yield the next value."},{"DocComment":""},{"DocComment":" [`Step`]: crate::iter::Step"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..` syntax is a `RangeFrom`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((2..), std::ops::RangeFrom { start: 2 });"},{"DocComment":" assert_eq!(2 + 3 + 4, (2..).take(3).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]); // This is a `RangeFrom`"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeFrom","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":205,"col":4},"end":{"line":205,"col":18}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","is_positional":false,"ty":{"Deduplicated":6}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Value":[71,{"AtLeast":{"Value":[72,{"AlignTo":{"base":{"Value":[73,{"Plus":[{"Value":[74,{"Constant":{"Value":[30,[{"OffsetOf":[{"id":52,