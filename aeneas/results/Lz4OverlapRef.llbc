would be obtained by taking the *successor*"},{"DocComment":" of `self` `count` times along with a boolean tracking whether overflow"},{"DocComment":" occurred."},{"DocComment":""},{"DocComment":" If this would overflow the range of values supported by `Self`, the"},{"DocComment":" value returned is unspecified and should not be relied on, though"},{"DocComment":" typically wrapping (modular arithmetic) is the most effective"},{"DocComment":" implementation to enable optimizations."},{"DocComment":""},{"DocComment":" # Invariants"},{"DocComment":""},{"DocComment":" For any `a`, `n`, and `m`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::forward_overflowing(Step::forward_overflowing(a, n).0, m) == Step::forward_overflowing(a, n + m)`"},{"DocComment":""},{"DocComment":" For any `a` and `n`, where no overflow occurs:"},{"DocComment":""},{"DocComment":" * `Step::forward_overflowing(a, n) == (Step::forward_checked(a, n).unwrap(), false)`"},{"DocComment":""},{"DocComment":" For any `a` and `n`:"},{"DocComment":""},{"DocComment":" * `Step::forward_overflowing(a, n) == (0..n).fold((a, false), |(x, y), _| { let (s, o) = Step::forward_overflowing(x, 1); (s, y || o) })`"},{"DocComment":"   * Corollary: `Step::forward_overflowing(a, 0) == (a, false)`"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":6},{"Deduplicated":0}],"output":{"Value":[172,{"Adt":{"id":0,"generics":{"regions":[],"types":[{"Deduplicated":6},{"Deduplicated":70}],"const_generics":[],"trait_refs":[]},"builtin":"Tuple"}}]}},"default":null},"kind":{"TraitMethod":[6,2]}},null,null,{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"backward_checked","item_met