chunks of data (e.g. a 64-byte","SHA-512 digest), so it would be nice if that fit in the unrolled loop at least once.","Plus, single-digit percentage performance differences might well be quite different","on different hardware."]],[231,["Encode what's left after the fast loop."]],[238,["start at the first index not handled by fast loop, which may be 0."]]]}}},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":4}},{"Ident":["get",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":183,"col":4},"end":{"line":183,"col":43}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":7},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0},{"Deduplicated":11}],"output":{"Value":[70,{"Adt":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":18}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":{"TraitImpl":{"impl_ref":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":7}],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":0},{"Deduplicated":12},{"Deduplicated":7}],"const_generics":[],"trait_refs":[]}},"item_id":0,"reuses_default":true}},"body":"Opaque"},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":4}},{"Ident":["get_mut",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":194,"col":4},"end":{"