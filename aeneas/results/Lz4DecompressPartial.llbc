xtend_from_within(&mut self, start: usize, wild_len: usize, copy_len: usize);\n\n    #[cfg(feature = \"safe-decode\")]\n    fn extend_from_within_overlapping(&mut self, start: usize, num_bytes: usize);\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"byte_at","item_meta":{"name":[{"Ident":["lz4_flex",0]},{"Ident":["sink",0]},{"Ident":["Sink",0]},{"Ident":["byte_at",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":53,"col":4},"end":{"line":53,"col":44}},"generated_from_span":null}},"source_text":"fn byte_at(&mut self, pos: usize) -> u8;","attr_info":{"attributes":[{"DocComment":" read byte at position"},{"Unknown":{"path":"allow","args":"dead_code"}}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[376,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":64},"Mut"]}]},{"Deduplicated":0}],"output":{"Deduplicated":22}},"default":null},"kind":{"TraitMethod":[4,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_const