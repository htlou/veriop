omments_before":[]},{"span":{"Deduplicated":332},"id":3380,"kind":{"StorageDead":188},"comments_before":[]},{"span":{"Deduplicated":332},"id":3381,"kind":{"StorageDead":178},"comments_before":[]},{"span":{"Deduplicated":332},"id":3382,"kind":{"StorageDead":119},"comments_before":[]},{"span":{"Deduplicated":332},"id":3383,"kind":{"StorageDead":20},"comments_before":[]},{"span":{"Deduplicated":444},"id":3384,"kind":{"Continue":0},"comments_before":[]}]}},"comments_before":["Exhaust the decoder by reading and decompressing all blocks until the remaining buffer is","empty."]},{"span":{"Deduplicated":332},"id":3386,"kind":{"StorageDead":20},"comments_before":[]},{"span":{"Deduplicated":397},"id":3388,"kind":{"StorageDead":12},"comments_before":[]},{"span":{"Deduplicated":397},"id":3389,"kind":{"StorageDead":7},"comments_before":[]},{"span":{"Deduplicated":397},"id":3390,"kind":{"StorageDead":5},"comments_before":[]},{"span":{"Deduplicated":397},"id":3391,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"Deduplicated":398},"id":3392,"kind":{"StorageDead":255},"comments_before":[]},{"span":{"Deduplicated":398},"id":3394,"kind":{"StorageDead":242},"comments_before":[]},{"span":{"Deduplicated":398},"id":3396,"kind":{"StorageDead":220},"comments_before":[]},{"span":{"Deduplicated":398},"id":3397,"kind":{"StorageDead":212},"comments_before":[]},{"span":{"Deduplicated":398},"id":3398,"kind":{"StorageDead":206},"comments_before":[]},{"span":{"Deduplicated":398},"id":3400,"kind":{"StorageDead":196},"comments_before":[]},{"span":{"Deduplicated":398},"id":3401,"kind":{"StorageDead":192},"comments_before":[]},{"span":{"Deduplicated":398},"id":3403,"kind":{"StorageDead":173},"comments_before":[]},{"span":{"Deduplicated":398},"id":3404,"kind":{"StorageDead":171},"comments_before":[]},{"span":{"Deduplicated":398},"id":3405,"kind":{"StorageDead":157},"comments_before":[]},{"span":{"Deduplicated":398},"id":3406,"kind":{"StorageDead":151},"comments_before":[]},{"span":{"Deduplicated":398},"id":3407,"kind":{"StorageDead":142},"comments_before":[]},{"span":{"Deduplicated":398},"id":3408,"kind":{"StorageDead":135},"comments_before":[]},{"span":{"Deduplicated":398},"id":3412,"kind":{"StorageDead":99},"comments_before":[]},{"span":{"Deduplicated":398},"id":3414,"kind":{"StorageDead":79},"comments_before":[]},{"span":{"Deduplicated":398},"id":3415,"kind":{"StorageDead":74},"comments_before":[]},{"span":{"Deduplicated":398},"id":3417,"kind":{"StorageDead":60},"comments_before":[]},{"span":{"Deduplicated":398},"id":3418,"kind":{"StorageDead":53},"comments_before":[]},{"span":{"Deduplicated":398},"id":3421,"kind":{"StorageDead":31},"comments_before":[]},{"span":{"Deduplicated":398},"id":3424,"kind":{"StorageDead":16},"comments_before":[]},{"span":{"Deduplicated":398},"id":3425,"kind":{"StorageDead":11},"comments_before":[]},{"span":{"Deduplicated":398},"id":3426,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"Deduplicated":398},"id":3427,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":398},"id":3428,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":398},"id":3429,"kind":"Return","comments_before":[]}]},"comments":[[114,["In the dictionary case the output pointer is moved by the match length in the dictionary.","This may be up to 17 bytes without exiting the loop. So we need to ensure that we have","at least additional 17 bytes of space left in the output buffer in the fast loop."]],[119,["Exhaust the decoder by reading and decompressing all blocks until the remaining buffer is","empty."]],[124,["Read the token. The token is the first byte in a block. It is divided into two 4-bit","subtokens, the higher and the lower.","This token contains to 4-bit \"fields\", a higher and a lower, representing the literals'","length and the back reference's length, respectively."]],[136,["Checking for hot-loop.","In most cases the metadata does fit in a single 1byte token (statistically) and we are in","a safe-distance to the end. This enables some optimized handling.","","Ideally we want to check for safe output pos like: output.pos() <= safe_output_pos; But","that doesn't work when the safe_output_pos is 0 due to saturated_sub. So we use","`<` instead of `<=`, which covers that case."]],[140,["casting to [u8;u16] doesn't seem to make a difference vs &[u8] (same assembly)"]],[145,["Copy the literal","The literal is at max 14 bytes, and the is_safe_distance check assures","that we are far away enough from the end so we can safely copy 16 bytes"]],[149,["clone as we don't want to mutate"]],[161,["match crosses ext_dict and output, offset is still correct as output pos","increased"]],[167,["In this branch we know that match_length is at most 18 (14 + MINMATCH).","But the blocks can overlap, so make sure they are at least 18 bytes apart","to enable an optimized copy of 18 bytes."]],[184,["Now, we read the literals section.","Literal Section","If the initial value is 15, it is indicated that another byte will be read and added to","it"]],[189,["The literal_length length took the maximal value, indicating that there is more","than 15 literal_length bytes. We read the extra integer."]],[196,["could be skipped with unchecked-decode"]],[208,["If the input stream is emptied, we break out of the loop. This is only the case","in the end of the stream, since the block is intact otherwise."]],[218,["Obtain the initial match length. The match length is the length of the duplicate segment","which will later be copied from data previously decompressed into the output buffer. The","initial length is derived from the second part of the token (the lower nibble), we read","earlier. Since having a match length of less than 4 would mean negative compression","ratio, we start at 4 (MINMATCH)."]],[221,["The initial match length can maximally be 19. As with the literal length, this indicates","that there are more bytes to read."]],[225,["The match length took the maximal value, indicating that there is more bytes. We","read the extra integer."]],[229,["could be skipped with unchecked-decode"]],[242,["match crosses ext_dict and output, offset is still correct as output_len was","increased"]],[246,["We now copy from the already decompressed buffer. This allows us for storing duplicates","by simply referencing the other location."]]]}}},{"def_id":231,"item_meta":{"name":[{"Ident":["lz4_flex",0]},{"Ident":["block",0]},{"Ident":["decompress_safe",0]},{"Ident":["copy_from_dict",0]},{"Instantiated":{"params":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown"},{"index":1,"name":null,"variance":"Unknown","mutability":"Unknown"},{"index":2,"name":null,"variance":"Unknown","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":1},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":35,"generics":{"regions":[{"Var":{"Bound":[1,2]}}],"types":[],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":14},{"Var":{"Bound":[1,0]}}]}],"trait_type_constraints":[]},"skip_binder":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":15}],"const_generics":[],"trait_refs":[{"Value":[32,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":35,"generics":{"regions":[{"Var":{"Bound":[1,2]}}],"types":[],"const_generics":[],"trait_refs":[]}}}}]}]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":252,"col":0},"end":{"line":269,"col":1}},"generated_from_span":null}},"source_text":"fn copy_from_dict(\n    output: &mut impl Sink,\n    ext_dict: &[u8],\n    offset: usize,\n    match_length: usize,\n) -> Result<usize, DecompressError> {\n    // If we're here we know offset > output.pos\n    debug_assert!(offset > output.pos());\n    let (dict_offset, did_overflow) = ext_dict.len().overflowing_sub(offset - output.pos());\n    if did_overflow {\n