:74}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates a native endian integer value from its representation"},{"DocComment":" as a byte array in big endian."},{"DocComment":""},{"DocComment":""},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"let value = u64::from_be_bytes([0x12, 0x34, 0x56, 0x78, 0x90, 0x12, 0x34, 0x56]);"},{"DocComment":"assert_eq!(value, 0x1234567890123456);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" When starting from a slice rather than an array, fallible conversion APIs can be used:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"fn read_be_u64(input: &mut &[u8]) -> u64 {"},{"DocComment":"    let (int_bytes, rest) = input.split_at(size_of::<u64>());"},{"DocComment":"     *input = rest;"},{"DocComment":"    u64::from_be_bytes(int_bytes.try_into().unwrap())"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":14}],"output":{"Deduplicated":18}},"src":"Normal","body":"Opaque"},{"def_id":48,"item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["general_purpose",0]},{"Ident":["encode_scalar_tail",0]},{"Ident":["LOW_SIX_BITS",0]}],"span":{"Untagged":{"data":{"file_id":8,"beg":{"line":159,"col":4},"end":{"line":159,"col":27}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions"