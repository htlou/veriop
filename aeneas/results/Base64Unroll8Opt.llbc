check, there is an unsafe version of"},{"DocComment":" this function, [`from_utf8_unchecked`], which has the same"},{"DocComment":" behavior but skips the check."},{"DocComment":""},{"DocComment":" If you need a `String` instead of a `&str`, consider"},{"DocComment":" [`String::from_utf8`][string]."},{"DocComment":""},{"DocComment":" [string]: ../../std/string/struct.String.html#method.from_utf8"},{"DocComment":""},{"DocComment":" Because you can stack-allocate a `[u8; N]`, and you can take a"},{"DocComment":" [`&[u8]`][byteslice] of it, this function is one way to have a"},{"DocComment":" stack-allocated string. There is an example of this in the"},{"DocComment":" examples section below."},{"DocComment":""},{"DocComment":" [byteslice]: slice"},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns `Err` if the slice is not UTF-8 with a description as to why the"},{"DocComment":" provided slice is not UTF-8."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::str;"},{"DocComment":""},{"DocComment":" // some bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We can use the ? (try) operator to check if the bytes are valid"},{"DocComment":" let sparkle_heart = str::from_utf8(&sparkle_heart)?;"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" # Ok::<_, str::Utf8Error>(())"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Incorrect bytes:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::str;"},{"DocComment":""},{"DocComment":" // some invalid bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![0, 159, 146, 150];"},{"DocComment":""},{"DocComment":" assert!(str::from_utf8(&sparkle_heart).is_err());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the docs for [`Utf8Error`] for more details on the kinds of"},{"DocComment":" errors that can be returned."},{"DocComment":""},{"DocComment":" A \"stack allocated string\":"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::str;"},{"DocComment":""},{"DocComment":" // some bytes, in a stack-allocated array"},{"DocComment":" let sparkle_heart = [240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We know these bytes are valid, so just use `unwrap()`."},{"DocComment":" let sparkle_heart: &str = str::from_utf8(&sparkle_heart).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"str_from_utf8","has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":136}],"output":{"Value":[678,{"Adt":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":510},{"Deduplicated":659}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":214,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":7},"kind":"InherentImplBlock"}}},{"Ident":["push_str",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":1122,"col":4},"end":{"line":1122,"col":44}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Appends a given string slice onto the end of this `String`."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the 