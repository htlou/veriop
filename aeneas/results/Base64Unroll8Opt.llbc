"Ident":["encode",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":148,"col":4},"end":{"line":164,"col":5}},"generated_from_span":null}},"source_text":"fn encode<T: AsRef<[u8]>>(&self, input: T) -> String {\n        fn inner<E>(engine: &E, input_bytes: &[u8]) -> String\n        where\n            E: Engine + ?Sized,\n        {\n            let encoded_size = encoded_len(input_bytes.len(), engine.config().encode_padding())\n                .expect(\"integer overflow when calculating buffer size\");\n\n            let mut buf = vec![0; encoded_size];\n\n            encode_with_padding(input_bytes, &mut buf[..], engine, encoded_size);\n\n            String::from_utf8(buf).expect(\"Invalid UTF8\")\n        }\n\n        inner(self, input.as_ref())\n    }","attr_info":{"attributes":[{"DocComment":" Encode arbitrary octets as base64 using the provided `Engine`."},{"DocComment":" Returns a `String`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use base64::{Engine as _, engine::{self, general_purpose}, alphabet};"},{"DocComment":""},{"DocComment":" let b64 = general_purpose::STANDARD.encode(b\"hello world~\");"},{"DocComment":" println!(\"{}\", b64);"},{"DocComment":""},{"DocComment":" const CUSTOM_ENGINE: engine::GeneralPurpose ="},{"DocComment":"     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::NO_PAD);"},{"DocComment":""},{"DocComment":" let b64_url = CUSTOM_ENGINE.encode(b\"hello internet~\");"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":6,"beg":{"line":147,"col":4},"end":{"line":147,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":705},{"Deduplicated":2}],"output":{"Deduplica