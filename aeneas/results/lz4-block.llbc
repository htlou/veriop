]},{"Ident":["Residual",0]}],"span":{"Untagged":{"data":{"file_id":45,"beg":{"line":364,"col":0},"end":{"line":364,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Allows retrieving the canonical type implementing [`Try`] that has this type"},{"DocComment":" as its residual and allows it to hold an `O` as its output."},{"DocComment":""},{"DocComment":" If you think of the `Try` trait as splitting a type into its [`Try::Output`]"},{"DocComment":" and [`Try::Residual`] components, this allows putting them back together."},{"DocComment":""},{"DocComment":" For example,"},{"DocComment":" `Result<T, E>: Try<Output = T, Residual = Result<!, E>>`,"},{"DocComment":" and in the other direction,"},{"DocComment":" `<Result<!, E> as Residual<T>>::TryType = Result<T, E>`."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"O","variance":"Unknown"},{"index":2,"name":"Self_TryType","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[{"regions":[],"skip_binder":{"trait_ref":{"Value":[125,{"kind":{"ParentClause":[{"Value":[126,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":19,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":29},{"Deduplicated":45}],"const_generics":[],"trait_refs":[]}}}}]},0]},"trait_decl_ref":{"regions":[],"skip_binder":{"id":17,"generics":{"regions":[],"types":[{"Deduplicated":45}],"const_generics":[],"trait_refs":[]}}}}]},"type_id":0,"ty":{"Deduplicated":29}}},{"regions":[],"skip_binder":{"trait_ref":{"Deduplicated":125},"type_id":1,"ty":{"Deduplicated":19}}}]},"implied_clauses":[{"clause_id":0,"span":{"Value":[2868,{"data":{"file_id":