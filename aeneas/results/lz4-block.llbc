erics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":176,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["skip",0]}],"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":1389,"col":4},"end":{"line":1391,"col":20}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that skips the first `n` elements."},{"DocComment":""},{"DocComment":" `skip(n)` skips elements until `n` elements are skipped or the end of the"},{"DocComment":" iterator is reached (whichever happens first). After that, all the remaining"},{"DocComment":" elements are yielded. In particular, if the original iterator is too short,"},{"DocComment":" then the returned iterator is empty."},{"DocComment":""},{"DocComment":" Rather than overriding this method directly, instead override the `nth` method."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().skip(2);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Clause0_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":0},"origin":"TraitSelf","trait_":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":29}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":19},{"Deduplicated":0}],"output":{"Value":[785,{"Adt":{"id":37,"generics":{"regions":[],"types":[{"Deduplicated":19}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":{"TraitDefault":{"trait_ref":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":19},{"Deduplicated":29}],"const_generics":[],"trait_refs":[]}},"item_id":21}},"body":"Opaque"},{"def_id":177,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["take_while",0]}],"span":{"Untagged":{"data":{"file_id":27,"beg":{"line":1272,"col":4},"end":{"line":1275,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Creates an iterator that yields elements based on a predicate."},{"DocComment":""},{"DocComment":" `take_while()` takes a closure as an argument. It will call this"},{"DocComment":" closure on each element of the iterator, and yield elements"},{"DocComment":" while it returns `true`."},{"DocComment":""},{"DocComment":" After `false` is returned, `take_while()`'s job is over, and the"},{"DocComment":" rest of the elements are ignored."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1i32, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take_while(|x| x.is_negative());"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because the closure passed to `take_while()` takes a reference, and many"},{"DocComment":" iterators iterate over references, this leads to a possibly confusing"},{"DocComment":" situation, where the type of the closure is a double reference:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s = &[-1, 0, 1];"},{"DocComment":""},{"DocComment":" let mut iter = s.iter().take_while(|x| **x < 0); // need two *s!"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(&-1));"},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Stopping after an initial `false`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [-1, 0, 1, -2];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter().take_while(|&x| x < 0);"},{"DocComment":""},{"DocComment":" assert_eq!(iter.next(), Some(-1));"},{"DocComment":""},{"DocComment":" // We have more elements that are less than zero, but since we already"},{"DocComment":" // got a false, take_while() ignores the remaining elements."},{"DocComment":" assert_eq!(iter.next(), None);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Because `take_while()` needs to look at the value in order to see if it"},{"DocComment":" should be included or not, consuming iterators will see that it is"},{"DocComment":" removed:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.by_ref().take_while(|&n| n != 3).collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [1, 2]);"},{"DocComment":""},{"DocComment":" let result: Vec<i32> = iter.collect();"},{"DocComment":""},{"DocComment":" assert_eq!(result, [4]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" The `3` is no longer there, because it was consumed in order to see if"},{"DocComment":" the iteration should stop, but wasn't placed back into the iterator."}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"P","variance":"Invariant"},{"index":2