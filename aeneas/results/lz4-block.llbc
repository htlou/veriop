}],"span":{"Untagged":{"data":{"file_id":9,"beg":{"line":109,"col":0},"end":{"line":131,"col":1}},"generated_from_span":null}},"source_text":"impl fmt::Display for DecompressError {\n    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {\n        match self {\n            DecompressError::OutputTooSmall { expected, actual } => {\n                write!(\n                    f,\n                    \"provided output is too small for the decompressed data, actual {actual}, expected \\\n                     {expected}\"\n                )\n            }\n            DecompressError::LiteralOutOfBounds => {\n                f.write_str(\"literal is out of bounds of the input\")\n            }\n            DecompressError::ExpectedAnotherByte => {\n                f.write_str(\"expected another byte, found none\")\n            }\n            DecompressError::OffsetZero => f.write_str(\"0 is not a valid match offset\"),\n            DecompressError::OffsetOutOfBounds => {\n                f.write_str(\"the offset to copy is not contained in the decompressed buffer\")\n            }\n        }\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":61}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outli