1,["Find a candidate in the dictionary with the hash of the current four bytes.","Unchecked is safe as long as the values from the hash function don't exceed the size","of the table. This is ensured by right shifting the hash values","(`dict_bitshift`) to fit them in the table"]],[393,["[Bounds Check]: Can be elided due to `end_pos_check` above"]],[398,["Sanity check: Matches can't be ahead of `cur`."]],[405,["Two requirements to the candidate exists:","- We should not return a position which is merely a hash collision, so that the","  candidate actually matches what we search for.","- We can address up to 16-bit offset, hence we are only able to address the candidate","  if its offset is less than or equals to 0xFFFF."]],[411,["match within input"]],[416,["Sanity check, which may fail if we lost history beyond MAX_DISTANCE"]],[421,["match within ext dict"]],[429,["Match is not reachable anymore","eg. compressing an independent block frame w/o clearing","the matches tables, only increasing input_stream_offset.","Sanity check"]],[434,["[Bounds Check]: Candidate is coming from the Hashmap. It can't be out of bounds, but","impossible to prove for the compiler and remove the bounds checks."]],[436,["[Bounds Check]: Should be able to be elided due to `end_pos_check`."]],[444,["Extend the match backwards if we can"]],[453,["The length (in bytes) of the literals section."]],[456,["Generate the higher half of the token."]],[462,["Note: The `- 2` offset was copied from the reference implementation, it could be","arbitrary."]],[468,["Push the token to the output stream."]],[471,["If we were unable to fit the literals length into the token, write the extensional","part."]],[480,["Now, write the actual literals.","","The unsafe version copies blocks of 8bytes, and therefore may copy up to 7bytes more than","needed. This is safe, because the last 12 bytes (MF_LIMIT) are handled in","handle_last_literals."]],[482,["write the offset in little endian."]],[486,["If we were unable to fit the duplicates length into the token, write the","extensional part."]]]}}},{"def_id":30,"item_meta":{"name":[{"Ident":["lz4_flex",0]},{"Ident":["block",0]},{"Ident":["compress",0]},{"Ident":["push_byte",0]}],"span":{"Untagged":{"data":{"file_id":12,"beg":{"line":495,"col":0},"end":{"line":497,"col":1}},"generated_from_span":null}},"source_text":"fn push_byte(output: &mut impl Sink, el: u8) {\n    output.push(el);\n}","attr_info":{"attributes":[{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":12,"beg":{"line":493,"col":0},"end":{"line":493,"col":9}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T0","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[723,{"data":{"file_id":12,"beg":{"line":495,"col":31},"end":{"line":495,"col":35}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":14,"generics":{"regions":[],"types":[{"Deduplicated":19}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":19},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":49},{"Deduplicated":28}],"output":{"Deduplicated":159}},"src":"Normal","body":{"Structured":{"span":{"Value":[724,{"data":{"file_id":12,"beg":{"line":495,"col":0},"end":{"line":497,"col":1}},"generated_from_span":null}]},"bound_body_regions":4,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[725,{"data":{"file_id":12,"beg":{"line":495,"col":44},"end":{"line":495,"col":44}},"generated_from_span":null}]},"ty":{"Deduplicated":159},"drop_flag_for":null},{"i