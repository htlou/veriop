{"Signed":"I32"}},"value":4},{"key":{"Integer":{"Signed":"I64"}},"value":8},{"key":{"Integer":{"Signed":"I128"}},"value":16},{"key":{"Integer":{"Signed":"Isize"}},"value":8},{"key":{"Integer":{"Unsigned":"U8"}},"value":1},{"key":{"Integer":{"Unsigned":"U16"}},"value":2},{"key":{"Integer":{"Unsigned":"U32"}},"value":4},{"key":{"Integer":{"Unsigned":"U64"}},"value":8},{"key":{"Integer":{"Unsigned":"U128"}},"value":16},{"key":{"Integer":{"Unsigned":"Usize"}},"value":8},{"key":{"Float":"F16"},"value":2},{"key":{"Float":"F32"},"value":4},{"key":{"Float":"F64"},"value":8},{"key":{"Float":"F128"},"value":16},{"key":"Char","value":4}]}}],"files":[{"id":0,"name":{"Local":"lib.rs"},"crate_name":"sink_reborrow","contents":"pub struct SliceSink<'a> {\n    output: &'a mut [u8],\n    pos: usize,\n}\n\npub trait Sink {\n    fn byte_at(&mut self, index: usize) -> u8;\n    fn push(&mut self, byte: u8);\n}\n\nimpl Sink for SliceSink<'_> {\n    fn byte_at(&mut self, index: usize) -> u8 {\n        self.output[index]\n    }\n\n    fn push(&mut self, byte: u8) {\n        self.output[self.pos] = byte;\n        self.pos += 1;\n    }\n}\n\npub fn through_trait(sink: &mut SliceSink<'_>, index: usize) {\n    let byte = sink.byte_at(index);\n    sink.push(byte);\n}\n\npub fn directly(sink: &mut SliceSink<'_>, index: usize) {\n    let byte = sink.output[index];\n    sink.output[sink.pos] = byte;\n    sink.pos += 1;\n}\n\npub fn generic<S: Sink>(sink: &mut S, index: usize) {\n    let byte = sink.byte_at(index);\n    sink.push(byte);\n}\n\npub fn through_generic(sink: &mut SliceSink<'_>, index: usize) {\n    generic(sink, index);\n}\n"},{"id":1,"name":{"Local":"/rustc/library/core/src/lib.rs"},"crate_name":"core","contents":null},{"id":2,"name":{"Local":"/rustc/library/core/src/array/mod.rs"},"crate_name":"core","contents":null},{"id":3,"name":{"Local":"/rustc/library/core/src/slice/mod.rs"},"crate_name":"core","contents":null},{"id":4,"name":{"Local":"/rustc/library/core/src/slice/index.rs"},"cr