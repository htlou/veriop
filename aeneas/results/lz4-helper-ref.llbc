a byte lower than 255 is read.\n    loop {\n        // We add the next byte until we get a byte which we add to the counting variable.\n        let extra: u8 = *input\n            .get(*input_pos)\n            .ok_or(DecompressError::ExpectedAnotherByte)?;\n        *input_pos += 1;\n        n += extra as usize;\n\n        // We continue if we got 255, break otherwise.\n        if extra != 0xFF {\n            break;\n        }\n    }\n\n    // 255, 255, 255, 8\n    // 111, 111, 111, 101\n\n    Ok(n)\n}","attr_info":{"attributes":[{"DocComment":" Read an integer."},{"DocComment":""},{"DocComment":" In LZ4, we encode small integers in a way that we can have an arbitrary number of bytes. In"},{"DocComment":" particular, we add the bytes repeatedly until we hit a non-0xFF byte. When we do, we add"},{"DocComment":" this byte to our sum and terminate the loop."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```notest"},{"DocComment":"     255, 255, 255, 4, 2, 3, 4, 6, 7"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" is encoded to _255 + 255 + 255 + 4 = 769_. The bytes after the first 4 is ignored, because"},{"DocComment":" 4 is the first non-0xFF byte."},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":6,"beg":{"line":29,"col":0},"end":{"line":29,"col":9}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[19,{"Ref":[{"Var":{"Free":0}},{"Value":[20,{"Slice":[{"Value":[21,{"Scalar":{"Integer":{"U