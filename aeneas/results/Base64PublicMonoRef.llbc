ol":4},"end":{"line":1399,"col":96}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Splits the slice into a slice of `N`-element arrays,"},{"DocComment":" starting at the beginning of the slice,"},{"DocComment":" and a remainder slice with length strictly less than `N`."},{"DocComment":""},{"DocComment":" The remainder is meaningful in the division sense.  Given"},{"DocComment":" `let (chunks, remainder) = slice.as_chunks()`, then:"},{"DocComment":" - `chunks.len()` equals `slice.len() / N`,"},{"DocComment":" - `remainder.len()` equals `slice.len() % N`, and"},{"DocComment":" - `slice.len()` equals `chunks.len() * N + remainder.len()`."},{"DocComment":""},{"DocComment":" You can flatten the chunks back into a slice-of-`T` with [`as_flattened`]."},{"DocComment":""},{"DocComment":" [`as_flattened`]: slice::as_flattened"},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if `N` is zero."},{"DocComment":""},{"DocComment":" Note that this check is against a const generic parameter, not a runtime"},{"DocComment":" value, and thus a particular monomorphization will either always panic"},{"DocComment":" or it will never panic."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let slice = ['l', 'o', 'r', 'e', 'm'];"},{"DocComment":" let (chunks, remainder) = slice.as_chunks();"},{"DocComment":" assert_eq!(chunks, &[['l', 'o'], ['r', 'e']]);"},{"DocComment":" assert_eq!(remainder, &['m']);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you expect the slice to be an exact multiple, you can combine"},{"DocComment":" `let`-`else` with an empty slice pattern:"},{"DocComment":" ```"},{"DocComment":" let slice = ['R', 'u', 's', 't'];"},{"DocComment":" let (chunks, []) = slice.as_chunks::<2>() else {"},{"DocComment":"     panic!(\"slice didn't have even length\")"},{"DocComment":" };"},{"DocComment":" assert_eq!(chunks, &[['R', 'u'], ['