ptr::NonNull;"},{"DocComment":""},{"DocComment":" let mut x = 0u32;"},{"DocComment":" let ptr = NonNull::new(&mut x).expect(\"pointer should not be null\");"},{"DocComment":""},{"DocComment":" let x_value = unsafe { *ptr.as_ptr() };"},{"DocComment":" assert_eq!(x_value, 0);"},{"DocComment":""},{"DocComment":" unsafe { *ptr.as_ptr() += 2; }"},{"DocComment":" let x_value = unsafe { *ptr.as_ptr() };"},{"DocComment":" assert_eq!(x_value, 2);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":126}],"output":{"Deduplicated":1605}},"src":"Normal","body":{"Structured":{"span":{"Deduplicated":1966},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Deduplicated":1967},"ty":{"Deduplicated":1605},"drop_flag_for":null},{"index":1,"name":"self","span":{"Deduplicated":1968},"ty":{"Deduplicated":126},"drop_flag_for":null},{"index":2,"name":null,"span":{"Deduplicated":1969},"ty":{"Deduplicated":126},"drop_flag_for":null}]},"body":{"span":{"Deduplicated":1970},"id":5737,"statements":[{"span":{"Deduplicated":1969},"id":32892,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"Deduplicated":1969},"id":32893,"kind":{"StorageLive":2},"comments_before":[]},{"span":{"Deduplicated":1969},"id":32894,"kind":{"Assign":[{"kind":{"Local":2},"ty":{"Deduplicated":126}},{"Use":[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":126}}},"Yes"]}]},"comments_before":[]},{"span":{"Deduplicated":1971},"id":32895,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":1605}},{"UnaryOp":[{"Cast":{"Transmute":[{"Deduplicated":126},{"Deduplicated":1605}]}},{"Move":{"kind":{"Local":2},"ty":{"Deduplicated":126}}}]}]},"comments_before":[]},{"span":{"Deduplicated":1972},"id":32896,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":1973},"id":32897,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":1973},"id":32898,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":589,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["const_ptr",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":68},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_offset",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":7}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":60,"beg":{"line":469,"col":4},"end":{"line":471,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Adds a signed offset to a pointer using wrapping arithmetic."},{"DocComment":""},{"DocComment":" `count` is in units of T; e.g., a `count` of 3 represents a pointer"},{"DocComment":" offset of `3 * size_of::<T>()` bytes."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" This operation itself is always safe, but using the resulting pointer is not."},{"DocComment":""},{"DocComment":" The resulting pointer \"remembers\" the [allocation] that `self` points to"},{"DocComment":" (this is called \"[Provenance](ptr/index.html#provenance)\")."},{"DocComment":" The pointer must not be used to read or write other allocations."},{"DocComment":""},{"DocComment":" In other words, `let z = x.wrapping_offset((y as isize) - (x as isize))` does *not* make `z`"},{"DocComment":" the same as `y` even if we assume `T` has size `1` and there is no overflow: `z` is still"},{"DocComment":" attached to the object `x` is attached to, and dereferencing it is Undefined Behavior unless"},{"DocComment":" `x` and `y` point into the same allocation."},{"DocComment":""},{"DocComment":" Compared to [`offset`], this method basically delays the requirement of staying within the"},{"DocComment":" same allocation: [`offset`] is immediate Undefined Behavior when crossing object"},{"DocComment":" boundaries; `wrapping_offset` produces a pointer but still leads to Undefined Behavior if a"},{"DocComment":" pointer is dereferenced when it is out-of-bounds of the object it is attached to. [`offset`]"},{"DocComment":" can be optimized better and is thus preferable in performance-sensitive code."},{"DocComment":""},{"DocComment":" The delayed check only considers the value of the pointer that was dereferenced, not the"},{"DocComment":" intermediate values used during the computation of the final result. For example,"},{"DocComment":" `x.wrapping_offset(o).wrapping_offset(o.wrapping_neg())` is always the same as `x`. In other"},{"DocComment":" words, leaving the allocation and then re-entering it later is permitted."},{"DocComment":""},{"DocComment":" [`offset`]: #method.offset"},{"DocComment":" [allocation]: crate::ptr#allocation"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt::Write;"},{"DocComment":" // Iterate using a raw pointer in increments of two elements"},{"DocComment":" let data = [1u8, 2, 3, 4, 5];"},{"DocComment":" let mut ptr: *const u8 = data.as_ptr();"},{"DocComment":" let step = 2;"},{"DocComment":" let end_rounded_up = ptr.wrapping_offset(6);"},{"DocComment":""},{"DocComment":" let mut out = String::new();"},{"DocComment":" while ptr != end_rounded_up {"},{"DocComment":"     unsafe {"},{"DocComment":"         write!(&mut out, \"{}, \", *ptr)?;"},{"DocComment":"     }"},{"DocComment":"     ptr = ptr.wrapping_offset(step);"},{"DocComment":" }"},{"DocComment":" assert_eq!(out.as_str(), \"1, 3, 5, \");"},{"DocComment":" # std::fmt::Result::Ok(())"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":68},{"Deduplicated":82}],"output":{"Deduplicated":68}},"src":"Normal","body":{"Structured":{"span":{"Value":[7394,{"data":{"file_id":60,"beg":{"line":469,"col":4},"end":{"line":475,"col":5}},"generated_from_span":null}]},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[7395,{"data":{"file_id":60,"beg":{"line":469,"col":56},"end":{"line":469,"col":64}},"generated_from_span":null}]},"ty":{"Deduplicated":68},"drop_flag_for":null},{"index":1,"name":"self","span":{"Value":[7396,{"data":{"file_id":60,"beg":{"line":469,"col":33},"end":{"line":469,"col":37}},"generated_from_span":null}]},"ty":{"Deduplicated":68},"drop_flag_for":null},{"index":2,"name":"count","span":{"Value":[7397,{"data":{"file_id":60,"beg":{"line":469,"col":39},"end":{"line":469,"col":44}},"generated_from_span":null}]},"ty":{"Deduplicated":82},"drop_flag_for":null},{"index":3,"name":null,"span":{"Value":[7398,{"data":{"file_id":60,"beg":{"line":474,"col":42},"end":{"line":474,"col":46}},"generated_from_span":null}]},"ty":{"Deduplicated":68},"drop_flag_for":null},{"index":4,"name":null,"span":{"Value":[7399,{"data":{"file_id":60,"beg":{"line":474,"col":48},"end":{"line":474,"col":53}},"generated_from_span":null}]},"ty":{"Deduplicated":82},"drop_flag_for":null}]},"body":{"span":{"Value":[7400,{"data":{"file_id":60,"beg":{"line":474,"col":42},"end":{"line":475,"col":5}},"generated_from_span":null}]},"id":574