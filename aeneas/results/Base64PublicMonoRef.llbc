 value of the `MaybeUninit<T>`."},{"DocComment":""},{"DocComment":" This overwrites any previous value without dropping it, so be careful"},{"DocComment":" not to use this twice unless you want to skip running the destructor."},{"DocComment":" For your convenience, this also returns a mutable reference to the"},{"DocComment":" (now safely initialized) contents of `self`."},{"DocComment":""},{"DocComment":" As the content is stored inside a `ManuallyDrop`, the destructor is not"},{"DocComment":" run for the inner data if the MaybeUninit leaves scope without a call to"},{"DocComment":" [`assume_init`], [`assume_init_drop`], or similar. Code that receives"},{"DocComment":" the mutable reference returned by this function needs to keep this in"},{"DocComment":" mind. The safety model of Rust regards leaks as safe, but they are"},{"DocComment":" usually still undesirable. This being said, the mutable reference"},{"DocComment":" behaves like any other mutable reference would, so assigning a new value"},{"DocComment":" to it will drop the old content."},{"DocComment":""},{"DocComment":" [`assume_init`]: Self::assume_init"},{"DocComment":" [`assume_init_drop`]: Self::assume_init_drop"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Correct usage of this method:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<Vec<u8>>::uninit();"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let hello = x.write((&b\"Hello, world!\").to_vec());"},{"DocComment":"     // Setting hello does not leak prior allocations, but drops them"},{"DocComment":"     *hello = (&b\"Hello\").to_vec();"},{"DocComment":"     hello[0] = 'h' as u8;"},{"DocComment":" }"},{"DocComment":" // x is initialized now:"},{"DocComment":" let s = unsafe { x.assume_init() };"},{"DocComment":" assert_eq!(b\"hello\", s.as_slice());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This usage of the method causes a leak:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut x = MaybeUninit::<String>::uninit();"},{"DocComment":""},{"DocComment":" x.write(\"Hello\".to_string());"},{"DocComment":" # // FIXME(https://github.com/rust-lang/miri/issues/3670):"},{"DocComment":" # // use -Zmiri-disable-leak-check instead of unleaking in tests meant to leak."},{"DocComment":" # unsafe { MaybeUninit::assume_init_drop(&mut x); }"},{"DocComment":" // This leaks the contained string:"},{"DocComment":" x.write(\"hello\".to_string());"},{"DocComment":" // x is initialized now:"},{"DocComment":" let s = unsafe { x.assume_init() };"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This method can be used to avoid unsafe in some cases. The example below"},{"DocComment":" shows a part of an implementation of a fixed sized arena that lends out"},{"DocComment":" pinned references."},{"DocComment":" With `write`, we can avoid the need to write through a raw pointer:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use core::pin::Pin;"},{"DocComment":" use core::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" struct PinArena<T> {"},{"DocComment":"     memory: Box<[MaybeUninit<T>]>,"},{"DocComment":"     len: usize,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl <T> PinArena<T> {"},{"DocComment":"     pub fn capacity(&self) -> usize {"},{"DocComment":"         self.memory.len()"},{"DocComment":"     }"},{"DocComment":"     pub fn push(&mut self, val: T) -> Pin<&mut T> {"},{"DocComment":"         if self.len >= self.capacity() {"},{"DocComment":"             panic!(\"Attempted to push to a full pin arena!\");"},{"DocComment":"         }"},{"DocComment":"         let ref_ = self.memory[self.len].write(val);"},{"DocComment":"         self.len += 1;"},{"DocComment":"         unsafe { Pin::new_unchecked(ref_) }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[987,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":49},"Mut"]}]},{"Deduplicated":7}],"output":{"Value":[988,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":7},"Mut"]}]}},"src":"Normal","body":{"Structured":{"span":{"Value":[3728,{"data":{"file_id":50,"beg":{"line":574,"col":4},"end":{"line":578,"col":5}},"generated_from_span":null}]},"bound_body_regions":10,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[3729,{"data":{"file_id":50,"beg":{"line":574,"col":45},"end":{"line":574,"col":51}},"generated_from_span":null}]},"ty":{"Value":[989,{"Ref":[{"Body":1},{"Deduplicated":7},"Mut"]}]},"drop_flag_for":null},{"index":1,"name":"self","span":{"Value":[3730,{"data":{"file_id":50,"beg":{"line":574,"col":23},"end":{"line":574,"col":32}},"generated_from_span":null}]},"ty":{"Value":[990,{"Ref":[{"Body":3},{"Deduplicated":49},"Mut"]}]},"drop_flag_for":null},{"index":2,"name":"val","span":{"Value":[3731,{"data":{"file_id":50,"beg":{"line":574,"col":34},"end":{"line":574,"col":37}},"generated_from_span":null}]},"ty":{"Deduplicated":7},"drop_flag_for":null},{"index":3,"name":null,"span":{"Value":[3732,{"data":{"file_id":50,"beg":{"line":577,"col":8},"end":{"line":577,"col":41}},"generated_from_span":null}]},"ty":{"Value":[991,{"Ref":[{"Body":4},{"Deduplicated":7},"Mut"]}]},"drop_flag_for":null},{"index":4,"name":null,"span":{"Value":[3733,{"data":{"file_id":50,"beg":{"line":575,"col":16},"end":{"line":575,"col":37}},"generated_from_span":null}]},"ty":{"Dedup