lements."},{"DocComment":""},{"DocComment":" This method will eagerly skip `n` elements by calling [`next`] up to `n`"},{"DocComment":" times until [`None`] is encountered."},{"DocComment":""},{"DocComment":" `advance_by(n)` will return `Ok(())` if the iterator successfully advances by"},{"DocComment":" `n` elements, or a `Err(NonZero<usize>)` with value `k` if [`None`] is encountered,"},{"DocComment":" where `k` is remaining number of steps that could not be advanced because the iterator ran out."},{"DocComment":" If `self` is empty and `n` is non-zero, then this returns `Err(n)`."},{"DocComment":" Otherwise, `k` is always less than `n`."},{"DocComment":""},{"DocComment":" Calling `advance_by(0)` can do meaningful work, for example [`Flatten`]"},{"DocComment":" can advance its outer iterator until it finds an inner iterator that is not empty, which"},{"DocComment":" then often allows it to return a more accurate `size_hint()` than in its initial state."},{"DocComment":""},{"DocComment":" [`Flatten`]: crate::iter::Flatten"},{"DocComment":" [`next`]: Iterator::next"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(iter_advance_by)]"},{"DocComment":""},{"DocComment":" use std::num::NonZero;"},{"DocComment":""},{"DocComment":" let a = [1, 2, 3, 4];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" assert_eq!(iter.advance_by(2), Ok(()));"},{"DocComment":" assert_eq!(iter.next(), Some(3));"},{"DocComment":" assert_eq!(iter.advance_by(0), Ok(()));"},{"DocComment":" assert_eq!(iter.advance_by(100), Err(NonZero::new(99).unwrap())); // only `4` was skipped"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_gene