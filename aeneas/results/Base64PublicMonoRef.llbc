s":[]},"builtin":null},0,null]},[{"Move":{"kind":{"Local":17},"ty":{"Deduplicated":17}}}]]}]},"comments_before":[]},{"span":{"Value":[2710,{"data":{"file_id":23,"beg":{"line":1759,"col":13},"end":{"line":1759,"col":14}},"generated_from_span":null}]},"id":14011,"kind":{"StorageDead":17},"comments_before":[]},{"span":{"Deduplicated":2708},"id":14012,"kind":{"StorageDead":18},"comments_before":[]},{"span":{"Deduplicated":2708},"id":14016,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":2708},"id":14017,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":2708},"id":33029,"kind":{"StorageDead":19},"comments_before":[]},{"span":{"Deduplicated":2708},"id":14018,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":147,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["raw",0]},{"Ident":["from_raw_parts",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":["Erased"],"types":[{"Deduplicated":7}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":46,"beg":{"line":124,"col":0},"end":{"line":124,"col":80}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Forms a slice from a pointer and a length."},{"DocComment":""},{"DocComment":" The `len` argument is the number of **elements**, not the number of bytes."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" Behavior is undefined if any of the following conditions are violated:"},{"DocComment":""},{"DocComment":" * `data` must be non-null, [valid] for reads for `len * size_of::<T>()` many bytes,"},{"DocComment":"   and it must be properly aligned. This means in particular:"},{"DocComment":""},{"DocComment":"     * The entire memory range of this slice must be contained within a single allocation!"},{"DocComment":"       Slices can never span across multiple allocations. See [below](#incorrect-usage)"},{"DocComment":"       for an example incorrectly not taking this into account."},{"DocComment":"     * `data` must be non-null and aligned even for zero-length slices or slices of ZSTs. One"},{"DocComment":"       reason for this is that enum layout optimizations may rely on references"},{"DocComment":"       (including slices of any length) being aligned and non-null to distinguish"},{"DocComment":"       them from other data. You can obtain a pointer that is usable as `data`"},{"DocComment":"       for zero-length slices using [`NonNull::dangling()`]."},{"DocComment":""},{"DocComment":" * `data` must point to `len` consecutive properly initialized values of type `T`."},{"DocComment":""},{"DocComment":" * The memory referenced by the returned slice must not be mutated for the duration"},{"DocComment":"   of lifetime `'a`, except inside an `UnsafeCell`."},{"DocComment":""},{"DocComment":" * The total size `len * size_of::<T>()` of the slice must be no larger than `isize::MAX`,"},{"DocComment":"   and adding that size to `data` must not \"wrap around\" the address space."},{"DocComment":"   See the safety documentation of [`pointer::offset`]."},{"DocComment":""},{"DocComment":" # Caveat"},{"DocComment":""},{"DocComment":" The lifetime for the returned slice is inferred from its usage. To"},{"DocComment":" prevent accidental misuse, it's suggested to tie the lifetime to whichever"},{"DocComment":" source lifetime is safe in the context, such as by providing a helper"},{"DocComment":" function taking the lifetime of a host value for the slice, or by explicit"},{"DocComment":" annotation."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" // manifest a slice for a single element"},{"DocComment":" let x = 42;"},{"DocComment":" let ptr = &x as *const _;"},{"DocComment":" let slice = unsafe { slice::from_raw_parts(ptr, 1) };"},{"DocComment":" assert_eq!(slice[0], 42);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### Incorrect usage"},{"DocComment":""},{"DocComment":" The following `join_slices` function is **unsound** ⚠️"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" fn join_slices<'a, T>(fst: &'a [T], snd: &'a [T]) -> &'a [T] {"},{"DocComment":"     let fst_end = fst.as_ptr().wrapping_add(fst.len());"},{"DocComment":"     let snd_start = snd.as_ptr();"},{"DocComment":"     assert_eq!(fst_end, snd_start, \"Slices must be contiguous!\");"},{"DocComment":"     unsafe {"},{"DocComment":"         // The assertion above ensures `fst` and `snd` are contiguous, but they might"},{"DocComment":"         // still be contained within _different allocations_, in which case"},{"DocComment":"         // creating this slice is undefined behavior."},{"DocComment":"         slice::from_raw_parts(fst.as_ptr(), fst.len() + snd.len())"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     // `a` and `b` are different allocations..."},{"DocComment":"     let a = 42;"},{"DocComment":"     let b = 27;"},{"DocComment":"     // ... which may nevertheless be laid out contiguously in memory: | a | b |"},{"DocComment":"     let _ = join_slices(slice::from_ref(&a), slice::from_ref(&b)); // UB"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### FFI: Handling null pointers"},{"DocComment":""},{"DocComment":" In languages such as C++, pointers to empty collections are not guaranteed to be non-null."},{"DocComment":" When accepting such pointers, they have to be checked for null-ness to avoid undefined"},{"DocComment":" behavior."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::slice;"},{"DocComment":""},{"DocComment":" /// Sum the elements of an FFI slice."},{"DocComment":" ///"},{"DocComment":" /// # Safety"},{"DocComment":" ///"},{"DocComment":" /// If ptr is not NULL, it must be correctly aligned and"},{"DocComment":" /// point to `len` initialized items of type `f32`."},{"DocComment":" unsafe extern \"C\" fn sum_slice(ptr: *const f32, len: usize) -> f32 {"},{"DocComment":"     let data = if ptr.is_null() {"},{"DocComment":"         // `len` is assumed to be 0."},{"DocComment":"         &[]"},{"DocComment":"     } else {"},{"DocComment":"         // SAFETY: see function docstring."},{"DocComment":"         unsafe { slice::from_raw_parts(ptr, len) }"},{"DocComment":"     };"},{"DocComment":"     data.into_iter().sum()"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // This could be the result of C++'s std::vector::data():"},{"DocComment":" let ptr = std::ptr::null();"},{"DocComment":" // And this could be std::vector::size():"},{"DocComment":" let len = 0;"},{"DocComment":" assert_eq!(unsafe { sum_slice(ptr, len) }, 0.0);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [valid]: ptr#safety"},{"DocComment":" [`NonNull::dangling()`]: ptr::NonNull::dangling"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":46,"beg":{"line":123,"col":0},"end":{"line":123,"col":15}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":"slice_from_raw_parts","has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":68},{"Deduplicated":0}],"output":{"Deduplicated":5}},"src":"Normal","body":{"Structured":{"span":{"Value":[2711,{"data":{"file_id":46,"beg":{"line":124,"col":0},"end":{"line":141,"col":1}},"generated_from_span":null}]},"bound_body_regions":2,"locals":{"arg_count":2,"locals":[{"index":0,"name":nu