null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Divides one slice into two at an index, returning `None` if the slice is"},{"DocComment":" too short."},{"DocComment":""},{"DocComment":" If `mid ≤ len` returns a pair of slices where the first will contain all"},{"DocComment":" indices from `[0, mid)` (excluding the index `mid` itself) and the"},{"DocComment":" second will contain all indices from `[mid, len)` (excluding the index"},{"DocComment":" `len` itself)."},{"DocComment":""},{"DocComment":" Otherwise, if `mid > len`, returns `None`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let v = [1, -2, 3, -4, 5, -6];"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"    let (left, right) = v.split_at_checked(0).unwrap();"},{"DocComment":"    assert_eq!(left, []);"},{"DocComment":"    assert_eq!(right, [1, -2, 3, -4, 5, -6]);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let (left, right) = v.split_at_checked(2).unwrap();"},{"DocComment":"     assert_eq!(left, [1, -2]);"},{"DocComment":"     assert_eq!(right, [3, -4, 5, -6]);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" {"},{"DocComment":"     let (left, right) = v.split_at_checked(6).unwrap();"},{"DocComment":"     assert_eq!(left, [1, -2, 3, -4, 5, -6]);"},{"DocComment":"     assert_eq!(right, []);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(None, v.split_at_checked(7));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Dedupli