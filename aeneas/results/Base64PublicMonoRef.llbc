T`."},{"DocComment":""},{"DocComment":" Note that even if `T` has size `0`, the pointer must be properly aligned."},{"DocComment":""},{"DocComment":" Care must be taken around [ownership of the returned value](#ownership-of-the-returned-value)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = 12;"},{"DocComment":" let y = &x as *const i32;"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     assert_eq!(std::ptr::read(y), 12);"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implement [`mem::swap`]:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":""},{"DocComment":" fn swap<T>(a: &mut T, b: &mut T) {"},{"DocComment":"     unsafe {"},{"DocComment":"         // Create a bitwise copy of the value at `a` in `tmp`."},{"DocComment":"         let tmp = ptr::read(a);"},{"DocComment":""},{"DocComment":"         // Exiting at this point (either by explicitly returning or by"},{"DocComment":"         // calling a function which panics) would cause the value in `tmp` to"},{"DocComment":"         // be dropped while the same value is still referenced by `a`. This"},{"DocComment":"         // could trigger undefined behavior if `T` is not `Copy`."},{"DocComment":""},{"DocComment":"         // Create a bitwise copy of the value at `b` in `a`."},{"DocComment":"         // This is safe because mutable references cannot alias."},{"DocComment":"         ptr::copy_nonoverlapping(b, a, 1);"},{"DocComment":""},{"DocComment":"         // As above, exiting here could trigger undefined behavior because"},{"DocComment":"         // the same value is referenced by `a` and `b`."},{"DocComment":""},{"DocComment":"         // Move `tmp` into `b`."},{"DocComment":"         ptr::write(b, tmp);"},{"DocComment":""},{"DocComment":"         // `tmp` has been moved (`write` takes ownership of its second argument),"},{"DocComment":"         // so nothing is dropped implicitly here."},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut foo = \"foo\".to_owned();"},{"DocComment":" let mut bar = \"bar\".to_owned();"},{"DocComment":""},{"DocComment":" swap(&mut foo, &mut bar);"},{"DocComment":""},{"DocComment":" assert_eq!(foo, \"bar\");"},{"DocComment":" assert_eq!(bar, \"foo\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## Ownership of the Returned Value"},{"DocComment":""},{"DocComment":" `read` creates a bitwise copy of `T`, regardless of whether `T` is [`Copy`]."},{"DocComment":" If `T` is not [`Copy`], using both the returned value and the value at"},{"DocComment":" `*src` can violate memory safety. Note that assigning to `*src` counts as a"},{"DocComment":" use because it will attempt to drop the value at `*src`."},{"DocComment":""},{"DocComment":" [`write()`] can be used to overwrite data without causing it to be dropped."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr;"},{"DocComment":""},{"DocComment":" let mut s = String::from(\"foo\");"},{"DocComment":" unsafe {"},{"DocComment":"     // `s2` now points to the same underlying memory as `s`."},{"DocComment":"     let mut s2: String = ptr::read(&s);"},{"DocComment":""},{"DocComment":"     assert_eq!(s2, \"foo\");"},{"DocComment":""},{"DocComment":"     // Assigning to `s2` causes its original value to be dropped. Beyond"},{"DocComment":"     // this point, `s` must no longer be used, as the underlying memory has"},{"DocComment":"     // been freed."},{"DocComment":"     s2 = String::default();"},{"DocComment":"     assert_eq!(s2, \"\");"},{"DocComment":""},{"DocComment":"     // Assigning to `s` would cause the old value to be dropped again,"},{"DocComment":"     // resulting in undefined behavior."},{"DocComment":"     // s = String::from(\"bar\"); // ERROR"},{"DocComment":""},{"DocComment":"     // `ptr::write` can be used to overwrite a value without dropping it."},{"DocComment":"     ptr::write(&mut s, String::from(\"bar\"));"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" assert_eq!(s, \"bar\");"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [valid]: self#safety"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":18,"beg":{"line":1717,"col":0},"end":{"line":1717,"col":15}},"generated_from_span":null}}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":"ptr_read","has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":68}],"output":{"Deduplicated":7}},"src":"Normal","body":{"Structured":{"span":{"Value":[2736,{"data":{"file_id":18,"beg":{"line":1719,"col":0},"end":{"line":1760,"col":1}},"generated_from_span":null}]},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Value":[2737,{"data":{"file_id":18,"beg":{"line":1719,"col":46},"end":{"line":1719,"col":47}},"generated_from_span":null}]},"ty":{"Deduplicated":7},"drop_flag_for":null},{"index":1,"name":"src","span":{"Value":[2738,{"data":{"file_id":18,"beg":{"line":1719,"col":28},"end":{"line":1719,"col":31}},"generated_from_span":null}]},"ty":{"Deduplicated":68},"drop_flag_for":null},{"index":2,"name":null,"span":{"Value":[2739,{"data":{"file_id":18,"beg":{"line":1758,"col":41},"end":{"line":1758,"col":44}},"generated_from_span":null}]},"ty":{"Deduplicated":68},"drop_flag_for":null}]},"body":{"span":{"Value":[2740,{"data":{"file_id":18,"beg":{"line":1758,"col":8},"end":{"line":1760,"col":1}},"generated_from_span":null}]},"id":1620,"statements":[{"span":{"Deduplicated":2739},"id":14083,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"Deduplicated":2739},"id":14084,"kind":