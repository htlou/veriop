":{"line":391,"col":49},"end":{"line":391,"col":50}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null}]},"body":{"span":{"Value":[3908,{"data":{"file_id":45,"beg":{"line":391,"col":17},"end":{"line":392,"col":5}},"generated_from_span":null}]},"id":2577,"statements":[{"span":{"Deduplicated":3907},"id":20489,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"Deduplicated":3907},"id":20490,"kind":{"StorageLive":2},"comments_before":[]},{"span":{"Deduplicated":3907},"id":20491,"kind":{"Assign":[{"kind":{"Local":2},"ty":{"Deduplicated":0}},{"Use":[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":0}}},"Yes"]}]},"comments_before":[]},{"span":{"Value":[3909,{"data":{"file_id":45,"beg":{"line":391,"col":17},"end":{"line":391,"col":51}},"generated_from_span":null}]},"id":20492,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":64}},{"UnaryOp":[{"Cast":{"Transmute":[{"Deduplicated":0},{"Deduplicated":64}]}},{"Move":{"kind":{"Local":2},"ty":{"Deduplicated":0}}}]}]},"comments_before":[]},{"span":{"Value":[3910,{"data":{"file_id":45,"beg":{"line":391,"col":50},"end":{"line":391,"col":51}},"generated_from_span":null}]},"id":20493,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Value":[3911,{"data":{"file_id":45,"beg":{"line":392,"col":5},"end":{"line":392,"col":5}},"generated_from_span":null}]},"id":20494,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":3911},"id":20495,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":232,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["try_fold",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":47},{"Deduplicated":45},{"Deduplicated":63},{"Deduplicated":64}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":33,"beg":{"line":2496,"col":4},"end":{"line":2500,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An iterator method that applies a function as long as it returns"},{"DocComment":" successfully, producing a single, final value."},{"DocComment":""},{"DocComment":" `try_fold()` takes two arguments: an initial value, and a closure with"},{"DocComment":" two arguments: an 'accumulator', and an element. The closure either"},{"DocComment":" returns successfully, with the value that the accumulator should have"},{"DocComment":" for the next iteration, or it returns failure, with an error value that"},{"DocComment":" is propagated back to the caller immediately (short-circuiting)."},{"DocComment":""},{"DocComment":" The initial value is the value the accumulator will have on the first"},{"DocComment":" call. If applying the closure succeeded against every element of the"},{"DocComment":" iterator, `try_fold()` returns the final accumulator as success."},{"DocComment":""},{"DocComment":" Folding is useful whenever you have a collection of something, and want"},{"DocComment":" to produce a single value from it."},{"DocComment":""},{"DocComment":" # Note to Implementors"},{"DocComment":""},{"DocComment":" Several of the other (forward) methods have default implementations in"},{"DocComment":" terms of this one, so try to implement this explicitly if it can"},{"DocComment":" do something better than the default `for` loop implementation."},{"DocComment":""},{"DocComment":" In particular, try to have this call `try_fold()` on the internal parts"},{"DocComment":" from which this iterator is composed. If multiple calls are needed,"},{"DocComment":" the `?` operator may be convenient for chaining the accumulator value"},{"DocComment":" along, but beware any invariants that need to be upheld before those"},{"DocComment":" early returns. This is a `&mut self` method, so iteration needs to be"},{"DocComment":" resumable after hitting an error here."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" // the checked sum of all of the elements of the array"},{"DocComment":" let sum = a.into_iter().try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":""},{"DocComment":" assert_eq!(sum, Some(6));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Short-circuiting:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [10, 20, 30, 100, 40, 50];"},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // This sum overflows when adding the 100 element"},{"DocComment":" let sum = iter.try_fold(0i8, |acc, x| acc.checked_add(x));"},{"DocComment":" assert_eq!(sum, None);"},{"DocComment":""},{"DocComment":" // Because it short-circuited, the remaining elements are still"},{"DocComment":" // available through the iterator."},{"DocComment":" assert_eq!(iter.len(), 2);"},{"DocComment":" assert_eq!(iter.next(), Some(40));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" While you cannot `break` from a closure, the [`ControlFlow`] type allows"},{"DocComment":" a similar idea:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::ControlFlow;"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_i8, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Continue(next)"},{"DocComment":"     } else {"},{"DocComment":"         ControlFlow::Break(prev)"},{"DocComment":"     }"},{"DocComment":" });"},{"DocComment":" assert_eq!(triangular, ControlFlow::Break(120));"},{"DocComment":""},{"DocComment":" let triangular = (1..30).try_fold(0_u64, |prev, x| {"},{"DocComment":"     if let Some(next) = prev.checked_add(x) {"},{"DocComment":"         ControlFlow::Cont