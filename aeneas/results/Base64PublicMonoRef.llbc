},{"DocComment":"assert!(!5_usize.is_multiple_of(2));"},{"DocComment":""},{"DocComment":"assert!(0_usize.is_multiple_of(0));"},{"DocComment":"assert!(!6_usize.is_multiple_of(0));"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0},{"Deduplicated":0}],"output":{"Deduplicated":124}},"src":"Normal","body":{"Structured":{"span":{"Value":[5736,{"data":{"file_id":19,"beg":{"line":3902,"col":8},"end":{"line":3907,"col":9}},"generated_from_span":null}]},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[5737,{"data":{"file_id":19,"beg":{"line":3902,"col":56},"end":{"line":3902,"col":60}},"generated_from_span":null}]},"ty":{"Deduplicated":124},"drop_flag_for":null},{"index":1,"name":"self","span":{"Value":[5738,{"data":{"file_id":19,"beg":{"line":3902,"col":36},"end":{"line":3902,"col":40}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":2,"name":"rhs","span":{"Value":[5739,{"data":{"file_id":19,"beg":{"line":3902,"col":42},"end":{"line":3902,"col":45}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":3,"name":null,"span":{"Value":[5740,{"data":{"file_id":19,"beg":{"line":3904,"col":21},"end":{"line":3904,"col":25}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":4,"name":null,"span":{"Value":[5741,{"data":{"file_id":19,"beg":{"line":3905,"col":21},"end":{"line":3905,"col":31}},"generated_from_span":null}]},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":5,"name":null,"span":{"Value":[5742,{"data":{"file_id":19,"beg":{"line":39