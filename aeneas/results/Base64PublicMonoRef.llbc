mment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" # unsafe extern \"C\" fn initialize_buffer(buf: *mut [u8; 1024]) { unsafe { *buf = [0; 1024] } }"},{"DocComment":" # #[cfg(FALSE)]"},{"DocComment":" extern \"C\" {"},{"DocComment":"     /// Initializes *all* the bytes of the input buffer."},{"DocComment":"     fn initialize_buffer(buf: *mut [u8; 1024]);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut buf = MaybeUninit::<[u8; 1024]>::uninit();"},{"DocComment":""},{"DocComment":" // Initialize `buf`:"},{"DocComment":" unsafe { initialize_buffer(buf.as_mut_ptr()); }"},{"DocComment":" // Now we know that `buf` has been initialized, so we could `.assume_init()` it."},{"DocComment":" // However, using `.assume_init()` may trigger a `memcpy` of the 1024 bytes."},{"DocComment":" // To assert our buffer has been initialized without copying it, we upgrade"},{"DocComment":" // the `&mut MaybeUninit<[u8; 1024]>` to a `&mut [u8; 1024]`:"},{"DocComment":" let buf: &mut [u8; 1024] = unsafe {"},{"DocComment":"     // SAFETY: `buf` has been initialized."},{"DocComment":"     buf.assume_init_mut()"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // Now we can use `buf` as a normal slice:"},{"DocComment":" buf.sort_unstable();"},{"DocComment":" assert!("},{"DocComment":"     buf.windows(2).all(|pair| pair[0] <= pair[1]),"},{"DocComment":"     \"buffer is sorted\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ### *Incorrect* usages of this method:"},{"DocComment":""},{"DocComment":" You cannot use `.assume_init_mut()` to initialize a value:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::mem::MaybeUninit;"},{"DocComment":""},{"DocComment":" let mut b = MaybeUninit::<bool>::uninit();"},{"DocComment":" unsafe {"},{"DocComment":"     *b.assume_init_mut() = true;"},{"DocComment":"     // We have created a (mutable) reference to an uninitialized `bool`!"},{"DocComment":"     // This is undefined behavior. ⚠️"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" For instance, you cannot [`Read`] into an uninitialized buffer:"},{"DocComment":""},{"DocComment":" [`Read`]: ../../std/io/trait.Read.html"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::{io, mem::MaybeUninit};"},{"DocComment":""},{"DocComment":" fn read_chunk (reader: &'_ mut dyn io::Read) -> io::Result<[u8; 64]>"},{"DocComment":" {"},{"DocComment":"     let mut buffer = MaybeUninit::<[u8; 64]>::uninit();"},{"DocComment":"     reader.read_exact(unsafe { buffer.assume_init_mut() })?;"},{"DocComment":"     //                         ^^^^^^^^^^^^^^^^^^^^^^^^"},{"DocComment":"     // (mutable) reference to uninitialized memory!"},{"DocComment":"     // This is undefined behavior."},{"DocComment":"     Ok(unsafe { buffer.assume_init() })"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Nor can you use direct field access to do field-by-field gradual initialization:"},{"DocComment":""},{"DocComment":" ```rust,no_run"},{"DocComment":" use std::{mem::MaybeUninit, ptr};"},{"DocComment":""},{"DocComment":" struct Foo {"},{"DocComment":"     a: u32,"},{"DocComment":"     b: u8,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let foo: Foo = unsafe {"},{"DocComment":"     let mut foo = MaybeUninit::<Foo>::uninit();"},{"DocComment":"     ptr::write(&mut foo.assume_init_mut().a as *mut u32, 1337);"},{"DocComment":"     //              ^^^^^^^^^^^^^^^^^^^^^"},{"DocComment":"     // (mutable) reference to uninitialized memory!"},{"DocComment":"     // This is undefined behavior."},{"DocComment":"     ptr::write(&mut foo.assume_init_mut().b as *mut u8, 42);"},{"DocComment":"     //              ^^^^^^^^^^^^^^^^^^^^^"},{"DocComment":"     // (mutable) reference to uninitialized memory!"},{"DocComment":"     // This is undefined behavior."},{"DocComment":"     foo.assume_init()"},{"DocComment":" };"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":987}],"output":{"Deduplicated":988}},"src":"Normal","body":{"Structured":{"span":{"Value":[4126,{"data":{"file_id":50,"beg":{"line":1011,"col":4},"end":{"line":1018,"col":5}},"generated_from_span":null}]},"bound_body_regions":10,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Value":[4127,{"data":{"file_id":50,"beg":{"line":1011,"col":54},"end":{"line":1011,"col":60}},"generated_from_span":null}]},"ty":{"Deduplicated":989},"drop_flag_for":null},{"index":1,"name":"self","span":{"Value":[4128,{"data":{"file_id":50,"beg":{"line":1011,"col":40},"end":{"line":1011,"col":49}},"generated_from_span":null}]},"ty":{"Deduplicated":990},"drop_flag_for":null},{"index":2,"name":null,"span":{"Value":[4129,{"data":{"file_id":50,"beg":{"line":1014,"col":8},"end":{"line":1017,"col":9}},"generated_from_span":null}]},"ty":{"Deduplicated":991},"drop_flag_for":null},{"index":3,"name":null,"span":{"Value":[4130,{"data":{"file_id":50,"beg":{"line":1016,"col":12},"end":{"line":1016,"col":35}},"generated_from_span":null}]},"ty":{"Deduplicated":992},"drop_flag_for":null},{"index":4,"name":null,"span":{"Value":[4131,{"data":{"file_id":50,"beg":{"line":1015,"col":12},"end":{"line":1015,"col":47}},"generated_from_span":null}]},"ty":{"Deduplicated":17},"drop_flag_for":null},{"index":5,"name":null,"span":{"Deduplicated":4130},"ty":{"Deduplicated":993},"drop_flag_for":null},{"index":6,"name":null,"span":{"Value":[4132,{"data":{"file_id":50,"beg":{"line":1016,"col":18},"end":{"line":1016,"col":3