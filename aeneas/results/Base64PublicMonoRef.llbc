contain addresses\nrepresentable by `usize`, so technically the last condition implies the first two. This implies, for\ninstance, that `vec.as_ptr().add(vec.len())` (for `vec: Vec<T>`) is always safe.\n\n[allocation]: crate::ptr#allocation\n"},{"DocComment":""},{"DocComment":" Consider using [`wrapping_add`](#method.wrapping_add) instead if these constraints are"},{"DocComment":" difficult to satisfy. The only advantage of this method is that it"},{"DocComment":" enables more aggressive compiler optimizations."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let s: &str = \"123\";"},{"DocComment":" let ptr: *const u8 = s.as_ptr();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     assert_eq!(*ptr.add(1), b'2');"},{"DocComment":"     assert_eq!(*ptr.add(2), b'3');"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":60,"beg":{"line":837,"col":4},"end":{"line":837,"col":19}},"generated_from_span":null}}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":90},{"Deduplicated":0}],"output":{"Deduplicated":90}},"src":"Normal","body":{"Structured":{"span":{"Deduplicated":4630},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Deduplicated":4631},"ty":{"Deduplicated":90},"drop_flag_for":null},{"index":1,"name":"self","span":{"Deduplicated":4632},"ty":{"Deduplicated":90},"drop_flag_for":null},{"index":2,"name":"count","span":{"Deduplicated":4633},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":3,"name":null,"span":{"Deduplicated":4634},"ty":{"Dedu