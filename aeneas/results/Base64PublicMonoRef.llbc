live":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":74}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":619,"col":4},"end":{"line":621,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Adds an unsigned offset to a pointer.\n\nThis can only move the pointer forward (or not move it). If you need to move forward or\nbackward depending on the value, then you might want [`offset`](#method.offset) instead\nwhich takes a signed offset.\n\n`count` is in units of T; e.g., a `count` of 3 represents a pointer\noffset of `3 * size_of::<T>()` bytes.\n\n# Safety\n\nIf any of the following conditions are violated, the result is Undefined Behavior:\n\n* The offset in bytes, `count * size_of::<T>()`, computed on mathematical integers (without\n\"wrapping around\"), must fit in an `isize`.\n\n* Let `result` be `self.addr() + count * size_of::<T>()`, computed on mathematical integers.\nThis must fit in a `usize`.\n\n* If the computed offset is non-zero, then `self` must be [derived from][crate::ptr#provenance] a pointer to some\n[allocation], and the entire memory range between `self` and `result`\n(i.e., `self.addr()..result`) must be in bounds of that allocation.\n\nAllocations can never be larger than `isize::MAX` bytes and they can only contain addresses\nrepresentable by `usize`, so technically the last condition implies the first two. This implies, for\ninstance, that `vec.as_ptr().add(vec.len())` (for `vec: Vec<T>`) is always safe.\n\n[allocation]: crate::ptr#allocation\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr::NonNull;"},{"DocComment":""},{"DocComment":" let s: &str = \"123\";"},{"DocComment":" let ptr: NonNull<u8> = NonNull::new(s.as_ptr().cast_mut()).unwrap();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     println!(\"{}\", ptr.add(1).read() as char);"},{"DocComment":"     println!(\"{}\", ptr.add(2).read() as char);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":25,"beg":{"line":615,"col":21},"end":{"line":615,"col":33}},"generated_from_span":null}}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":89},{"Deduplicated":0}],"output":{"Deduplicated":89}},"src":"Normal","body":{"Structured":{"span":{"Deduplicated":2247},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Deduplicated":2248},"ty":{"Deduplicated":89},"drop_flag_for":null},{"index":1,"name":"self","span":{"Deduplicated":2249},"ty":{"Deduplicated":89},"drop_flag_for":null},{"index":2,"name":"count","span":{"Deduplicated":2250},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":3,"name":null,"span":{"Deduplicated":2251},"ty":{"Deduplicated":98},"drop_flag_for":null},{"index":4,"name":null,"span":{"Deduplicated":2252},"ty":{"Deduplicated":98},"drop_flag_for":null},{"index":5,"name":null,"span":{"Deduplicated":2253},"ty":{"Deduplicated":89},"drop_flag_for":null},{"index":6,"name":null,"span":{"Deduplicated":2254},"ty":{"Deduplicated":0},"drop_flag_for":null}]},"body":{"span":{"Deduplicated":2255},"id":3554,"statements":[{"span":{"Deduplicated":2251},"id":24033,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"Deduplicated":2251},"id":24034,"kind":{"StorageLive":3},"comments_before":[]},{"span":{"Deduplicated":2252},"id":24035,"kind":{"StorageLive":4},"comments_before":[]},{"span":{"Deduplicated":2253},"id":24036,"kind":{"StorageLive":5},"comments_b