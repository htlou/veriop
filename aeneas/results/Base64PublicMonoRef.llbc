ust fit in an `isize`.\n\n* Let `result` be `self.addr() + count * size_of::<T>()`, computed on mathematical integers.\nThis must fit in a `usize`.\n\n* If the computed offset is non-zero, then `self` must be [derived from][crate::ptr#provenance] a pointer to some\n[allocation], and the entire memory range between `self` and `result`\n(i.e., `self.addr()..result`) must be in bounds of that allocation.\n\nAllocations can never be larger than `isize::MAX` bytes and they can only contain addresses\nrepresentable by `usize`, so technically the last condition implies the first two. This implies, for\ninstance, that `vec.as_ptr().add(vec.len())` (for `vec: Vec<T>`) is always safe.\n\n[allocation]: crate::ptr#allocation\n"},{"DocComment":""},{"DocComment":" Consider using [`wrapping_add`](#method.wrapping_add) instead if these constraints are"},{"DocComment":" difficult to satisfy. The only advantage of this method is that it"},{"DocComment":" enables more aggressive compiler optimizations."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s: String = \"123\".to_string();"},{"DocComment":" let ptr: *mut u8 = s.as_mut_ptr();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     assert_eq!('2', *ptr.add(1) as char);"},{"DocComment":"     assert_eq!('3', *ptr.add(2) as char);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":48,"beg":{"line":936,"col":4},"end":{"line":936,"col":19}},"generated_from_span":null}}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":100},{"Deduplicated":0}],