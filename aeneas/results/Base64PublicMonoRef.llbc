ble to tools\nthat check for compliance with the Rust memory model.\n\nOn most platforms this will produce a value with the same bytes as the original\npointer, because all the bytes are dedicated to describing the address.\nPlatforms which need to store additional information in the pointer may\nperform a change of representation to produce a value containing only the address\nportion of the pointer. What that means is up to the platform to define.\n\nThis is a [Strict Provenance][crate::ptr#strict-provenance] API.\n"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":90}],"output":{"Deduplicated":0}},"src":"Normal","body":{"Structured":{"span":{"Deduplicated":4797},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Deduplicated":4798},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":1,"name":"self","span":{"Deduplicated":4799},"ty":{"Deduplicated":90},"drop_flag_for":null},{"index":2,"name":null,"span":{"Deduplicated":4800},"ty":{"Deduplicated":81},"drop_flag_for":null},{"index":3,"name":null,"span":{"Deduplicated":4801},"ty":{"Deduplicated":90},"drop_flag_for":null}]},"body":{"span":{"Deduplicated":4802},"id":3576,"statements":[{"span":{"Deduplicated":4800},"id":24100,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"Deduplicated":4800},"id":24101,"kind":{"StorageLive":2},"comments_before":[]},{"span":{"Deduplicated":4801},"id":24102,"kind":{"StorageLive":3},"comments_before":[]},{"span":{"Deduplicated":4801},"id":24103,"kind":{"Assign":[{"kind":{"Local":3},"ty":{"Deduplicated":90}},{"Use":[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":90}}},"Ye