Comment":" Unsafe code may not rely on `is_val_statically_known` returning any"},{"DocComment":" particular value, ever. However, the compiler will generally make it"},{"DocComment":" return `true` only if the value of the argument is actually known."},{"DocComment":""},{"DocComment":" # Type Requirements"},{"DocComment":""},{"DocComment":" `T` must be either a `bool`, a `char`, a primitive numeric type (e.g. `f32`,"},{"DocComment":" but not `NonZeroISize`), or any thin pointer (e.g. `*mut String`)."},{"DocComment":" Any other argument types *may* cause a compiler error."},{"DocComment":""},{"DocComment":" ## Pointers"},{"DocComment":""},{"DocComment":" When the input is a pointer, only the pointer itself is"},{"DocComment":" ever considered. The pointee has no effect. Currently, these functions"},{"DocComment":" behave identically:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #![feature(core_intrinsics)]"},{"DocComment":" # #![allow(internal_features)]"},{"DocComment":" use std::intrinsics::is_val_statically_known;"},{"DocComment":""},{"DocComment":" fn foo(x: &i32) -> bool {"},{"DocComment":"     is_val_statically_known(x)"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" fn bar(x: &i32) -> bool {"},{"DocComment":"     is_val_statically_known("},{"DocComment":"         (x as *const i32).addr()"},{"DocComment":"     )"},{"DocComment":" }"},{"DocComment":" # _ = foo(&5_i32);"},{"DocComment":" # _ = bar(&5_i32);"},{"DocComment":" ```"},{"Builtin":"RustcIntrinsic"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":124}],"output":{"Deduplicated":124}},"src":"Normal","body":{"Intrinsic":{"n