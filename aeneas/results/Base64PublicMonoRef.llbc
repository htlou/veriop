,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["range",0]},{"Ident":["Range",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":36}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":86,"col":0},"end":{"line":86,"col":21}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A (half-open) range bounded inclusively below and exclusively above"},{"DocComment":" (`start..end`)."},{"DocComment":""},{"DocComment":" The range `start..end` contains all values with `start <= x < end`."},{"DocComment":" It is empty if `start >= end`."},{"DocComment":""},{"DocComment":" Note that this type is not suited to represent all possible ranges. For example, `Range<u8>`"},{"DocComment":" cannot represent the range that covers all of `u8`. Use [`(Bound<T>, Bound<T>)`][Bound] if you"},{"DocComment":" need a type that can store an arbitrary range."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" The `start..end` syntax is a `Range`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" assert_eq!((3..5), std::ops::Range { start: 3, end: 5 });"},{"DocComment":" assert_eq!(3 + 4 + 5, (3..6).sum());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]);"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]); // This is a `Range`"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":"Range","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":89,"col":4},"end":{"line":89,"col":18}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The lower bound of the range (inclusive)."}],"inline":null,"rename":null,"public":true},"name":"start","is_positional":false,"ty":{"Deduplicated":36}},{"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":92,"col":4},"end":{"line":92,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","is_positional":false,"ty":{"Deduplicated":36}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":241},"guarantee":{"Value":[424,{"AtLeast":{"Value":[425,{"AlignTo":{"base":{"Value":[426,{"Max":[{"Value":[427,{"Plus":[{"Value":[428,{"Constant":{"Value":[204,[{"OffsetOf":[{"id":72,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null},null,0]},{"Deduplicated":0}]]}}]},{"Deduplicated":153}]}]},{"Value":[429,{"Plus":[{"Value":[430,{"Constant":{"Value":[205,[{"OffsetOf":[{"id":72,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null},null,1]},{"Deduplicated":0}]]}}]},{"Deduplicated":153}]}]}]}]},"target_align":{"Value":[431,{"Max":[{"Deduplicated":158},{"Deduplicated":158}]}]}}}]}}]}},"align":{"chosen":{"Deduplicated":121},"guarantee":{"Value":[432,{"AtLeast":{"Deduplicated":431}}]}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":158}},"chosen":0},{"guarantee":{"GuaranteedAlignment":{"Deduplicated":158}},"chosen":2}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":false,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":73,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["mem",0]},{"Ident":["manually_drop",0]},{"Ident":["ManuallyDrop",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":7}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":56,"beg":{"line":156,"col":0},"end":{"line":156,"col":34}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A wrapper to inhibit the compiler from automatically calling `T`’s"},{"DocComment":" destructor. This wrapper is 0-cost."},{"DocComment":""},{"DocComment":" `ManuallyDrop<T>` is guaranteed to have the same layout and bit validity as"},{"DocComment":" `T`, and is subject to the same layout optimizations as `T`. As a"},{"DocComment":" consequence, it has *no effect* on the assumptions that the compiler makes"},{"DocComment":" about its contents. For example, initializing a `ManuallyDrop<&mut T>` with"},{"DocComment":" [`mem::zeroed`] is undefined behavior. If you need to handle uninitialized"},{"DocComment":" data, use [`MaybeUninit<T>`] instead."},{"DocComment":""},{"DocComment":" Note that accessing the value inside a `ManuallyDrop<T>` is safe. This means"},{"DocComment":" that a `ManuallyDrop<T>` whose content has been dropped must not be exposed"},{"DocComment":" through a public safe API. Correspondingly, `ManuallyDrop::drop` is unsafe."},{"DocComment":""},{"DocComment":" # `ManuallyDrop` and drop order"},{"DocComment":""},{"DocComment":" Rust has a well-defined [drop order] of values. To make sure that fields or"},{"DocComment":" locals are dropped in a specific order, reorder the declarations such that"},{"DocComment":" the implicit drop order is the correct one."},{"DocComment":""},{"DocComment":" It is possible to use `ManuallyDrop` to control the drop order, but this"},{"DocComment":" requires unsafe code and is hard to do correctly in the presence of"},{"DocComment":" unwinding."},{"DocComment":""},{"DocComment":" For example, if you want to make sure that a specific field is dropped after"},{"DocComment":" the others, make it the last field of a struct:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" struct Context;"},{"DocComment":""},{"DocComment":" struct Widget {"},{"DocComment":"     children: Vec<Widget>,"},{"DocComment":"     // `context` will be dropped after `children`."},{"DocComment":"     // Rust guarantees that fields are dropped in the order of declaration."},{"DocComment":"     context: Context,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Safety hazards when storing `ManuallyDrop` in a struct or an enum."},{"DocComment":""},{"DocComment":" Special care is needed when all of the conditions below are met:"},{"DocComment":" * A struct or enum contains a `ManuallyDrop`."},{"DocComment":" * The `ManuallyDrop` is not inside a `union`."},{"DocComment":" * The struct or enum is part of public API, or is stored in a struct or an"},{"DocComment":"   enum that is part of public API."},{"DocComment":" * There is a _safe_ function that drops the contents of the `ManuallyDrop`"},{"DocComment":"   field, and it can be called outside the struct or enum's `Drop` implementation."},{"DocComment":""},{"DocComment":" In particular, deriving `Debug`, `Clone`, `PartialEq`, `PartialOrd`, `Ord`,"},{"DocComment":" or `Hash` on the struct or enum could be unsound, since the derived"},{"DocComment":" implementations of these traits would access the `ManuallyDrop` field."},{"DocComment":""},{"DocComment":" For example, in the following code, `derive(Debug)` is unsound in combination"},{"DocComment":" with the `ManuallyDrop::drop` call in `Foo::new`:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" # use std::mem::ManuallyDrop;"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" pub struct Foo {"},{"DocComment":"     /// Invariant: this value may have been dropped!"},{"DocComment":"     value: ManuallyDrop<String>,"},{"DocComment":" }"},{"DocComment":" impl Foo {"},{"DocComment":"     pub fn new() -> Self {"},{"DocComment":"         let mut temp = Self {"},{"DocComment":"             value: ManuallyDrop::new(String::from(\"Unsafe rust is hard.\"))"},{"DocComment":"         };"},{"DocComment":"         unsafe {"},{"DocComment":"             // SAFETY: `value` hasn't been dropped yet."},{"DocComment":"             ManuallyDrop::drop(&mut temp.value);"},{"DocComment":"         }"},{"DocComment":"         temp"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" As one could use the `Debug` implementation to access an already dropped"},{"DocComment":" field:"},{"DocComment":""},{"DocComment":" ```rust,ignore (uses-type-from-separate-snippet)"},{"DocComment":" let foo = Foo::new();"},{"DocComment":" println!(\"{foo:?}\"); // Undefined behavior!"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that similar unsoundness can arise without `derive`. The cause of the"},{"DocComment":" unsoundness are public APIs which allow to access an already dropped value"},{"DocComment":" inside `ManuallyDrop`."},{"DocComment":""},{"DocComment":" # Pre-`1.96` Interaction with `Box`"},{"DocComment":""},{"DocComment":" Before Rust `1.96.0`, if you had a `ManuallyDrop<T>`, where the type `T`"},{"DocComment":" was a `Box` or contained a `Box` inside, then dropping the `T` followed by"},{"DocComment":" moving the `ManuallyDrop<T>` was [considered to be undefined"},{"DocComment":" behavior](https://github.com/rust-lang/unsafe-code-guidelines/issues/245)."},{"DocComment":" That is, the following code caused undefined behavior:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" let mut x = ManuallyDrop::new(Box::new(42));"},{"DocComment":" unsafe {"},{"DocComment":"     ManuallyDrop::drop(&mut x);"},{"DocComment":" }"},{"DocComment":" let y = x; // Undefined behavior! (pre 1.96.0)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Note that this could also have happen with a generic type where the user of"},{"DocComment":" the library providing it could substitute the generic for a `Box<_>` and"},{"DocComment":" then move the library type:"},{"DocComment":""},{"DocComment":" ```no_run"},{"DocComment":" use std::mem::ManuallyDrop;"},{"DocComment":""},{"DocComment":" pub struct BadOption<T> {"},{"DocComment":"     // Invariant: Has been dropped if `is_some` is false."},{"DocComment":"     value: ManuallyDrop<T>,"},{"DocComment":"     is_some: bool,"},{"DocComment":" }"},{"DocComment":" impl<T> BadOption<T> {"},{"DocComment":"     pub fn new(value: T) -> Self {"},{"DocComment":"         Self { value: ManuallyDrop::new(value), is_some: true }"},{"DocComment":"     }"},{"DocComment":"     pub fn change_to_none(&mut self) {"},{"DocComment":"         if self.is_some {"},{"DocComment":"             self.is_some = false;"},{"DocComment":"             unsafe {"},{"DocComment":"                 // SAFETY: `value` hasn't been dropped yet, as per the invariant"},{"DocComment":"                 // (This is actually unsound pre rust 1.96.0!)"},{"DocComment":"                 ManuallyDrop::drop(&mut self.value);"},{"DocComment":"             }"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // In another crate:"},{"DocComment":""},{"DocComment":" let mut option = BadOption::new(Box::new(42));"},{"DocComment":" option.change_to_none();"},{"DocComment":" let option2 = option; // Undefined behavior! (pre 1.96)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [drop order]: https://doc.rust-lang.org/reference/destructors.html"},{"DocComment":" [`mem::zeroed`]: crate::mem::zeroed"},{"DocComment":" [`MaybeUninit<T>`]: crate::mem::MaybeUninit"},{"DocComment":" [`MaybeUninit`]: crate::mem::MaybeUninit"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":"ManuallyDrop","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":56,"beg":{"line":157,"col":4},"end":{"line":157,"col":12}},"generated_from_span":null}},"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"name":"value","is_positional":false,"ty":{"Deduplicated":7}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":45}},"align":{"chosen":{"Deduplicated":1},"guarantee":{"Deduplicated":46}},"discriminator":{"Known":0},"inhabited":{"Deduplicated":0},"variant_layouts":[{"field_offsets":[{"guarantee":{"GuaranteedAlignment":{"Deduplicated":46}},"chosen":0}],"inhabited":{"Deduplicated":0},"tagger":[]}],"repr":{"repr_algo":"Rust","align_modif":null,"transparent":true,"explicit_discr_type":null}}}],"ptr_metadata":"None","marker_traits":{"is_sized":true,"is_send":true,"is_sync":true,"is_freeze":true,"is_unpin":true}},{"def_id":74,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["option",0]},{"Ident":["Option",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":56}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line