lar":{"kind":{"Fun":152},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"args":[{"Move":{"kind":{"Local":4},"ty":{"Deduplicated":38}}}],"dest":{"kind":{"Local":3},"ty":{"Deduplicated":768}},"safety":"Inherit"},"on_unwind":{"span":{"Deduplicated":2240},"id":1244,"statements":[{"span":{"Deduplicated":2240},"id":12790,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":2240},"id":12791,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"Deduplicated":2240},"id":12793,"kind":{"Assign":[{"kind":{"Local":2},"ty":{"Deduplicated":158}},{"UnaryOp":[{"Cast":{"RawPtr":[{"Deduplicated":768},{"Deduplicated":158}]}},{"Move":{"kind":{"Local":3},"ty":{"Deduplicated":768}}}]}]},"comments_before":[]},{"span":{"Deduplicated":2243},"id":12794,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"Deduplicated":2243},"id":12795,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"Deduplicated":2244},"id":12798,"kind":{"Call":{"call":{"func":{"Regular":{"kind":{"Fun":153},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"args":[{"Move":{"kind":{"Local":2},"ty":{"Deduplicated":158}}}],"dest":{"kind":{"Local":0},"ty":{"Deduplicated":34}},"safety":"Inherit"},"on_unwind":{"span":{"Deduplicated":2244},"id":1246,"statements":[{"span":{"Deduplicated":2244},"id":12796,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":2244},"id":12797,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"Deduplicated":2245},"id":12799,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":2246},"id":12800,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":2246},"id":12801,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":110,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ptr",0]},{"Ident":["non_null",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":39},"kind":"InherentImplBlock"}}},{"Ident":["add",0]},{"Instantiated":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":14}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":25,"beg":{"line":619,"col":4},"end":{"line":621,"col":17}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Adds an unsigned offset to a pointer.\n\nThis can only move the pointer forward (or not move it). If you need to move forward or\nbackward depending on the value, then you might want [`offset`](#method.offset) instead\nwhich takes a signed offset.\n\n`count` is in units of T; e.g., a `count` of 3 represents a pointer\noffset of `3 * size_of::<T>()` bytes.\n\n# Safety\n\nIf any of the following conditions are violated, the result is Undefined Behavior:\n\n* The offset in bytes, `count * size_of::<T>()`, computed on mathematical integers (without\n\"wrapping around\"), must fit in an `isize`.\n\n* Let `result` be `self.addr() + count * size_of::<T>()`, computed on mathematical integers.\nThis must fit in a `usize`.\n\n* If the computed offset is non-zero, then `self` must be [derived from][crate::ptr#provenance] a pointer to some\n[allocation], and the entire memory range between `self` and `result`\n(i.e., `self.addr()..result`) must be in bounds of that allocation.\n\nAllocations can never be larger than `isize::MAX` bytes and they can only contain addresses\nrepresentable by `usize`, so technically the last condition implies the first two. This implies, for\ninstance, that `vec.as_ptr().add(vec.len())` (for `vec: Vec<T>`) is always safe.\n\n[allocation]: crate::ptr#allocation\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ptr::NonNull;"},{"DocComment":""},{"DocComment":" let s: &str = \"123\";"},{"DocComment":" let ptr: NonNull<u8> = NonNull::new(s.as_ptr().cast_mut()).unwrap();"},{"DocComment":""},{"DocComment":" unsafe {"},{"DocComment":"     println!(\"{}\", ptr.add(1).read() as char);"},{"DocComment":"     println!(\"{}\", ptr.add(2).read() as char);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":25,"beg":{"line":615,"col":21},"end":{"line":615,"col":33}},"generated_from_span":null}}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":39},{"Deduplicated":0}],"output":{"Deduplicated":39}},"src":"Normal","body":{"Structured":{"span":{"Deduplicated":2247},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Deduplicated":2248},"ty":{"Deduplicated":39},"drop_flag_for":null},{"index":1,"name":"self","span":{"Deduplicated":2249},"ty":{"Deduplicated":39},"drop_flag_for":null},{"index":2,"name":"count","span":{"Deduplicated":2250},"ty":{"Deduplicated":0},"drop_flag_for":null},{"index":3,"name":null,"span":{"Deduplicated":2251},"ty":{"Deduplicated":48},"drop_flag_for":null},{"index":4,"name":null,"span":{"Deduplicated":2252},"ty":{"Deduplicated":48},"drop_flag_for":null},{"index":5,"name":null,"span":{"Deduplicated":2253},"ty":{"Deduplicated":39},"drop_flag_for":null},{"index":6,"name":null,"span":{"Deduplicated":2254},"ty":{"Deduplicated":0},"drop_flag_for":null}]},"body":{"span":{"Deduplicated":2255},"id":1255,"statements":[{"span":{"Deduplicated":2251},"id":12802,"kind":{"StorageLive":0},"comments_before":[]},{"span":{"Deduplicated":2251},"id":12803,"kind":{"StorageLive":3},"comments_before":[]},{"span":{"Deduplicated":2252},"id":12804,"kind":{"StorageLive":4},"comments_before":[]},{"span":{"Deduplicated":2253},"id":12805,"kind":{"StorageLive":5},"comments_before":[]},{"span":{"Deduplicated":2253},"id":12806,"kind":{"Assign":[{"kind":{"Local":5},"ty":{"Deduplicated":39}},{"Use":[{"Copy":{"kind":{"Local":1},"ty":{"Deduplicated":39}}},"Yes"]}]},"comments_before":[]},{"span":{"Deduplicated":2252},"id":12810,"kind":{"Call":{"call":{"func":{"Regular":{"kind":{"Fun":154},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"args":[{"Move":{"kind":{"Local":5},"ty":{"Deduplicated":39}}}],"dest":{"kind":{"Local":4},"ty":{"Deduplicated":48}},"safety":"Inherit"},"on_unwind":{"span":{"Deduplicated":2252},"id":1252,"statements":[{"span":{"Deduplicated":2252},"id":12807,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":2252},"id":12808,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":2252},"id":12809,"kind":"UnwindResume","comments_before":[]}]}}},"comments_before":[]},{"span":{"Deduplicated":2256},"id":12811,"kind":{"StorageDead":5},"comments_before":[]},{"span":{"Deduplicated":2254},"id":12812,"kind":{"StorageLive":6},"comments_before":[]},{"span":{"Deduplicated":2254},"id":12813,"kind":{"Assign":[{"kind":{"Local":6},"ty":{"Deduplicated":0}},{"Use":[{"Copy":{"kind":{"Local":2},"ty":{"Deduplicated":0}}},"Yes"]}]},"comments_before":[]},{"span":{"Deduplicated":2251},"id":12814,"kind":{"Assign":[{"kind":{"Local":3},"ty":{"Deduplicated":48}},{"BinaryOp":["Offset",{"Move":{"kind":{"Local":4},"ty":{"Deduplicated":48}}},{"Move":{"kind":{"Local":6},"ty":{"Deduplicated":0}}}]}]},"comments_before":[]},{"span":{"Deduplicated":2257},"id":12815,"kind":{"StorageDead":6},"comments_before":[]},{"span":{"Deduplicated":2257},"id":12816,"kind":{"StorageDead":4},"comments_before":[]},{"span":{"Deduplicated":2258},"id":12817,"kind":{"Assign":[{"kind":{"Local":0},"ty":{"Deduplicated":39}},{"UnaryOp":[{"Cast":{"Transmute":[{"Deduplicated":48},{"Deduplicated":39}]}},{"Move":{"kind":{"Local":3},"ty":{"Deduplicated":48}}}]}]},"comments_before":[]},{"span":{"Deduplicated":2259},"id":12818,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"Deduplicated":2260},"id":12819,"kind":{"StorageDead":2},"comments_before":[]},{"span":{"Deduplicated":2260},"id":12820,"kind":{"StorageDead":1},"comments_before":[]},{"span":{"Deduplicated":2260},"id":12821,"kind":"Return","comments_before":[]}]},"comments":[]}}},{"def_id":111,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hint",0]},{"Ident":["assert_unchecked",0]}],"span":{"Untagged":{"data":{"file_id":40,"beg":{"line":202,"col":0},"end":{"line":202,"col":48}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Makes a *soundness* promise to the compiler that `cond` holds."},{"DocComment":""},{"DocComment":" This may allow the optimizer to simplify things, but it might also make the generated code"},{"DocComment":" slower. Either way, calling it will most likely make compilation take longer."},{"DocComment":""},{"DocComment":" You may know this from other places as"},{"DocComment":" [`llvm.assume`](https://llvm.org/docs/LangRef.html#llvm-assume-intrinsic) or, in C,"},{"DocComment":" [`__builtin_assume`](https://clang.llvm.org/docs/LanguageExtensions.html#builtin-assume)."},{"DocComment":""},{"DocComment":" This promotes a correctness requirement to a soundness requirement. Don't do that without"},{"DocComment":" very good reason."},{"DocComment":""},{"DocComment":" # Usage"},{"DocComment":""},{"DocComment":" This is a situational tool for micro-optimization, and is allowed to do nothing. Any use"},{"DocComment":" should come with a repeatable benchmark to show the value, with the expectation to drop it"},{"DocComment":" later should the optimizer get smarter and no longer need it."},{"DocComment":""},{"DocComment":" The more complicated the condition, the less likely this is to be useful. For example,"},{"DocComment":" `assert_unchecked(foo.is_sorted())` is a complex enough value that the compiler is unlikely"},{"DocComment":" to be able to take advantage of it."},{"DocComment":""},{"DocComment":" There's also no need to `assert_unchecked` basic properties of things.  For example, the"},{"DocComment":" compiler already knows the range of `count_ones`, so there is no benefit to"},{"DocComment":" `let n = u32::count_ones(x); assert_unchecked(n <= u32::BITS);`."},{"DocComment":""},{"DocComment":" `assert_unchecked` is logically equivalent to `if !cond { unreachable_unchecked(); }`. If"},{"DocComment":" ever you are tempted to write `assert_unchecked(false)`, you should instead use"},{"DocComment":" [`unreachable_unchecked()`] directly."},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" `cond` must be `true`. It is immediate UB to call this with `false`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use core::hint;"},{"DocComment":""},{"DocComment":" /// # Safety"},{"DocComment":" ///"},{"DocComment":" /// `p` must be nonnull and valid"},{"DocComment":" pub unsafe fn next_value(p: *const i32) -> i32 {"},{"DocComment":"     // SAFETY: caller invariants guarantee that `p` is not null"},{"DocComment":"     unsafe { hint::assert_unchecked(!p.is_null()) }"},{"DocComment":""},{"DocComment":"     if p.is_null() {"},{"DocComment":"         return -1;"},{"DocComment":"     } else {"},{"DocComment":"         // SAFETY: caller invariants guarantee that `p` is valid"},{"DocComment":"         unsafe { *p + 1 }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Without the `assert_unchecked`, the above function produces the following with optimizations"},{"DocComment":" enabled:"},{"DocComment":""},{"DocComment":" ```asm"},{"DocComment":" next_value:"},{"DocComment":"         test    rdi, rdi"},{"DocComment":"         je      .LBB0_1"},{"DocComment":"         mov     eax, dword ptr [rdi]"},{"DocComment":"         inc     eax"},{"DocComment":"         ret"},{"DocComment":" .LBB0_1:"},{"DocComment":"         mov     eax, -1"},{"DocComment":"         ret"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Adding the assertion allows the optimizer to remove the extra check:"},{"DocComment":""},{"DocComment":" ```asm"},{"DocComment":" next_value:"},{"DocComment":"         mov     eax, dword ptr [rdi]"},{"DocComment":"         inc     eax"},{"DocComment":"         ret"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This example is quite unlike anything that would be used in the real world: it is redundant"},{"DocComment":" to put an assertion right next to code that checks the same thing, and dereferencing a"},{"DocComment":" pointer already has the builtin assumption that it is nonnull. However, it illustrates the"},{"DocComment":" kind of changes the optimizer can make even when the behavior is less obviously related."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":40,"beg":{"line":197,"col":0},"end":{"line":197,"col":15}},"generated_from_span":null}}}}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":124}],"output":{"Deduplicated":17}},"src":"Normal","body":{"Structured":{"span":{"Value":[2280,{"data":{"file_id":40,"beg":{"line":202,"col":0},"end":{"line":212,"col":1}},"generated_from_span":null}]},"bound_body_regions":0,"locals":{"arg_count":1,"locals":[{"index":0,"name":null,"span":{"Value":[2281,{"data":{"file_id":40,"beg":{"line":202,"col":48}