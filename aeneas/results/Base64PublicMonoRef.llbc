he distance between two pointers within the same allocation, *where it's known that"},{"DocComment":" `self` is equal to or greater than `origin`*. The returned value is in"},{"DocComment":" units of T: the distance in bytes is divided by `size_of::<T>()`."},{"DocComment":""},{"DocComment":" This computes the same value that [`offset_from`](#method.offset_from)"},{"DocComment":" would compute, but with the added precondition that the offset is"},{"DocComment":" guaranteed to be non-negative.  This method is equivalent to"},{"DocComment":" `usize::try_from(self.offset_from(origin)).unwrap_unchecked()`,"},{"DocComment":" but it provides slightly more information to the optimizer, which can"},{"DocComment":" sometimes allow it to optimize slightly better with some backends."},{"DocComment":""},{"DocComment":" This method can be thought of as recovering the `count` that was passed"},{"DocComment":" to [`add`](#method.add) (or, with the parameters in the other order,"},{"DocComment":" to [`sub`](#method.sub)).  The following are all equivalent, assuming"},{"DocComment":" that their safety preconditions are met:"},{"DocComment":" ```rust"},{"DocComment":" # unsafe fn blah(ptr: *mut i32, origin: *mut i32, count: usize) -> bool { unsafe {"},{"DocComment":" ptr.offset_from_unsigned(origin) == count"},{"DocComment":" # &&"},{"DocComment":" origin.add(count) == ptr"},{"DocComment":" # &&"},{"DocComment":" ptr.sub(count) == origin"},{"DocComment":" # } }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Safety"},{"DocComment":""},{"DocComment":" - The distance between the pointers must be non-negative (`self >= origin`)"},{"DocComment":""},{"DocComment":" - *All* the safety conditions of [`offset_from`](#method.offset_from)"},{"DocComment":"   apply to this method as well; see it for the full details."},{"DocComment":""},{"DocComment":" Importantly, despite the return type of this method being able to represent"},{"DocComment":" a larger offset, it's still *not permitted* to pass pointers which differ"},{"DocComment":" by more than `isize::MAX` *bytes*.  As such, the result of this method will"},{"DocComment":" always be less than or equal to `isize::MAX as usize`."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" This function panics if `T` is a Zero-Sized Type (\"ZST\")."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut a = [0; 5];"},{"DocComment":" let p: *mut i32 = a.as_mut_ptr();"},{"DocComment":" unsafe {"},{"DocComment":"     let ptr1: *mut i32 = p.add(1);"},{"DocComment":"     let ptr2: *mut i32 = p.add(3);"},{"DocComment":""},{"DocComment":"     assert_eq!(ptr2.offset_from_unsigned(ptr1), 2);"},{"DocComment":"     assert_eq!(ptr1.add(2), ptr2);"},{"DocComment":"     assert_eq!(ptr2.sub(2), ptr1);"},{"DocComment":"     assert_eq!(ptr2.offset_from_unsigned(ptr2), 0);"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" // This would be incorrect, as the pointers are not correctly ordered:"},{"DocComment":" // ptr1.offset_from(ptr2)"},{"DocComment":" ```"},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":48,"beg":{"line":887,"col":4},"end":{"line":887,"col":19}},"generated_from_span":null}}}}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":70},{"Deduplicated":68}],"output":{"Deduplicated":0}},"src":"Normal","body":{"Structured":{"span":{"Value":[5315,{"data":{"file_id":48,"beg":{"line":888,"col":4},"end":{"line":894,"col":5}},"generated_from_span":null}]},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[5316,