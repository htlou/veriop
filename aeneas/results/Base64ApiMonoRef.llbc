{"},{"DocComment":"    let (int_bytes, rest) = input.split_at(size_of::<u64>());"},{"DocComment":"     *input = rest;"},{"DocComment":"    u64::from_be_bytes(int_bytes.try_into().unwrap())"},{"DocComment":" }"},{"DocComment":" ```"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":10}],"output":{"Deduplicated":15}},"src":"Normal","body":"Opaque"}],"global_decls":[null,null,null,{"def_id":3,"item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["general_purpose",0]},{"Ident":["encode_scalar_tail",0]},{"Ident":["BLOCKS_PER_FAST_LOOP",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":158,"col":4},"end":{"line":158,"col":42}},"generated_from_span":null}},"source_text":"const BLOCKS_PER_FAST_LOOP: usize = 4;","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"ty":{"Deduplicated":0},"size":{"chosen":{"Deduplicated":64},"guarantee":null},"align":{"chosen":{"Deduplicated":68},"guarantee":null},"ptr_metadata":{"Const":{"Deduplicated":47}},"src":"Normal","global_kind":"NamedConst","value":{"Value":[91,[{"Call":[{"kind":{"Fun":24},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}},[]]},{"Deduplicated":0}]]}},{"def_id":4,"item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["general_purpose",0]},{"Ident":["encode_scalar_tail",0]},{"Ident":["L