params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Ident":["SliceIndex",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":173,"col":4},"end":{"line":173,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns a mutable reference to the output at this location, panicking"},{"DocComment":" if out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":4,"beg":{"line":172,"col":4},"end":{"line":172,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":18},{"Deduplicated":406}],"output":{"Deduplicated":408}},"default":null},"kind":{"TraitMethod":[2,5]}}],"vtable":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":23},{"Deduplicated":39}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":3,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":170,"col":0},"end":{"line":170,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used for indexing operations (`container[index]`) in mutable contexts."},{"DocComment":""},{"DocComment":" `container[index]` is actually syntactic sugar for"},{"DocComment":" `*container.index_mut(index)`, but only when used as a mutable value. If"},{"DocComment":" an immutable value is requested, the [`Index`] trait is used instead. This"},{"DocComment":" allows nice things such as `v[index] = value`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" A very simple implementation of a `Balance` struct that has two sides, where"},{"DocComment":" each can be indexed mutably and immutably."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::ops::{Index, IndexMut};"},{"DocComment":""},{"DocComment":" #[derive(Debug)]"},{"DocComment":" enum Side {"},{"DocComment":"     Left,"},{"DocComment":"     Right,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" #[derive(Debug, PartialEq)]"},{"DocComment":" enum Weight {"},{"DocComment":"     Kilogram(f32),"},{"DocComment":"     Pound(f32),"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" struct Balance {"},{"DocComment":"     pub left: Weight,"},{"DocComment":"     pub right: Weight,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Index<Side> for Balance {"},{"DocComment":"     type Output = Weight;"},{"DocComment":""},{"DocComment":"     fn index(&self, index: Side) -> &Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance immutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &self.left,"},{"DocComment":"             Side::Right => &self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl IndexMut<Side> for Balance {"},{"DocComment":"     fn index_mut(&mut self, index: Side) -> &mut Self::Output {"},{"DocComment":"         println!(\"Accessing {index:?}-side of balance mutably\");"},{"DocComment":"         match index {"},{"DocComment":"             Side::Left => &mut self.left,"},{"DocComment":"             Side::Right => &mut self.right,"},{"DocComment":"         }"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let mut balance = Balance {"},{"DocComment":"     right: Weight::Kilogram(2.5),"},{"DocComment":"     left: Weight::Pound(1.5),"},{"DocComment":" };"},{"DocComment":""},{"DocComment":" // In this case, `balance[Side::Right]` is sugar for"},{"DocComment":" // `*balance.index(Side::Right)`, since we are only *reading*"},{"DocComment":" // `balance[Side::Right]`, not writing it."},{"DocComment":" assert_eq!(balance[Side::Right], Weight::Kilogram(2.5));"},{"DocComment":""},{"DocComment":" // However, in this case `balance[Side::Left]` is sugar for"},{"DocComment":" // `*balance.index_mut(Side::Left)`, since we are writing"},{"DocComment":" // `balance[Side::Left]`."},{"DocComment":" balance[Side::Left] = Weight::Kilogram(3.0);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IndexMut","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Idx","variance":"Unknown"},{"index":2,"name":"Self_Clause0_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1535,{"data":{"file_id":7,"beg":{"line":170,"col":39},"end":{"line":170,"col":57}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":18},{"Deduplicated":23},{"Deduplicated":39}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"index_mut","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["index",0]},{"Ident":["IndexMut",0]},{"Ident":["index_mut",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":179,"col":4},"end":{"line":179,"col":61}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the mutable indexing (`container[index]`) operation."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" May panic if the index is out of bounds."},{"Builtin":{"TrackCaller":{"Untagged":{"data":{"file_id":7,"beg":{"line":178,"col":4},"end":{"line":178,"col":19}},"generated_from_span":null}}}}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[413,{"Ref":[{"Var":{"Bound":[0,0]}},{"Deduplicated":18},"Mut"]}]},{"Deduplicated":23}],"output":{"Deduplicated":408}},"default":null},"kind":{"TraitMethod":[3,0]}}],"vtable":{"id":2,"generics":{"regions":[],"types":[{"Deduplicated":23},{"Deduplicated":39}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":4,"item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":72,"col":0},"end":{"line":458,"col":1}},"generated_from_span":null}},"source_text":"pub trait Engine: Send + Sync {\n    /// The config type used by this engine\n    type Config: Config;\n    /// The decode estimate used by this engine\n    type DecodeEstimate: DecodeEstimate;\n\n    /// This is not meant to be called directly; it is only for `Engine` implementors.\n    /// See the other `encode*` functions on this trait.\n    ///\n    /// Encode the `input` bytes into the `output` buffer based on the mapping in `encode_table`.\n    ///\n    /// `output` will be long enough to hold the encoded data.\n    ///\n    /// Returns the number of bytes written.\n    ///\n    /// No padding should be written; that is handled separately.\n    ///\n    /// Must not write any bytes into the output slice other than the encoded data.\n    #[doc(hidden)]\n    fn internal_encode(&self, input: &[u8], output: &mut [u8]) -> usize;\n\n    /// This is not meant to be called directly; it is only for `Engine` implementors.\n    ///\n    /// As an optimization to prevent the decoded length from being calculated twice, it is\n    /// sometimes helpful to have a conservative estimate of the decoded size before doing the\n    /// decoding, so this calculation is done separately and passed to [Engine::decode()] as needed.\n    #[doc(hidden)]\n    fn internal_decoded_len_estimate(&self, input_len: usize) -> Self::DecodeEstimate;\n\n    /// This is not meant to be called directly; it is only for `Engine` implementors.\n    /// See the other `decode*` functions on this trait.\n    ///\n    /// Decode `input` base64 bytes into the `output` buffer.\n    ///\n    /// `decode_estimate` is the result of [Engine::internal_decoded_len_estimate()], which is passed in to avoid\n    /// calculating it again (expensive on short inputs).`\n    ///\n    /// Each complete 4-byte chunk of encoded data decodes to 3 bytes of decoded data, but this\n    /// function must also handle the final possibly partial chunk.\n    /// If the input length is not a multiple of 4, or uses padding bytes to reach a multiple of 4,\n    /// the trailing 2 or 3 bytes must decode to 1 or 2 bytes, respectively, as per the\n    /// [RFC](https://tools.ietf.org/html/rfc4648#section-3.5).\n    ///\n    /// Decoding must not write any bytes into the output slice other than the decoded data.\n    ///\n    /// Non-canonical trailing bits in the final symbols or non-canonical padding must be reported as\n    /// errors unless the engine is configured otherwise.\n    #[doc(hidden)]\n    fn internal_decode(\n        &self,\n        input: &[u8],\n        output: &mut [u8],\n        decode_estimate: Self::DecodeEstimate,\n    ) -> Result<DecodeMetadata, DecodeSliceError>;\n\n    /// Returns the config for this engine.\n    fn config(&self) -> &Self::Config;\n\n    /// Encode arbitrary octets as base64 using the provided `Engine`.\n    /// Returns a `String`.\n    ///\n    /// # Example\n    ///\n    /// ```rust\n    /// use base64::{Engine as _, engine::{self, general_purpose}, alphabet};\n    ///\n    /// let b64 = general_purpose::STANDARD.encode(b\"hello world~\");\n    /// println!(\"{}\", b64);\n    ///\n    /// const CUSTOM_ENGINE: engine::GeneralPurpose =\n    ///     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::NO_PAD);\n    ///\n    /// let b64_url = CUSTOM_ENGINE.encode(b\"hello internet~\");\n    /// ```\n    #[cfg(any(feature = \"alloc\", test))]\n    #[inline]\n    fn encode<T: AsRef<[u8]>>(&self, input: T) -> String {\n        fn inner<E>(engine: &E, input_bytes: &[u8]) -> String\n        where\n            E: Engine + ?Sized,\n        {\n            let encoded_size = encoded_len(input_bytes.len(), engine.config().encode_padding())\n                .expect(\"integer overflow when calculating buffer size\");\n\n            let mut buf = vec![0; encoded_size];\n\n            encode_with_padding(input_bytes, &mut buf[..], engine, encoded_size);\n\n            String::from_utf8(buf).expect(\"Invalid UTF8\")\n        }\n\n        inner(self, input.as_ref())\n    }\n\n    /// Encode arbitrary octets as base64 into a supplied `String`.\n    /// Writes into the supplied `String`, which may allocate if its internal buffer isn't big enough.\n    ///\n    /// # Example\n    ///\n    /// ```rust\n    /// use base64::{Engine as _, engine::{self, general_purpose}, alphabet};\n    /// const CUSTOM_ENGINE: engine::GeneralPurpose =\n    ///     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::NO_PAD);\n    ///\n    /// fn main() {\n    ///     let mut buf = String::new();\n    ///     general_purpose::STANDARD.encode_string(b\"hello world~\", &mut buf);\n    ///     println!(\"{}\", buf);\n    ///\n    ///     buf.clear();\n    ///     CUSTOM_ENGINE.encode_string(b\"hello internet~\", &mut buf);\n    ///     println!(\"{}\", buf);\n    /// }\n    /// ```\n    #[cfg(any(feature = \"alloc\", test))]\n    #[inline]\n    fn encode_string<T: AsRef<[u8]>>(&self, input: T, output_buf: &mut String) {\n        fn inner<E>(engine: &E, input_bytes: &[u8], output_buf: &mut String)\n        where\n            E: Engine + ?Sized,\n        {\n            let mut sink = chunked_encoder::StringSink::new(output_buf);\n\n            chunked_encoder::ChunkedEncoder::new(engine)\n                .encode(input_bytes, &mut sink)\n                .expect(\"Writing to a String shouldn't fail\");\n        }\n\n        inner(self, input.as_ref(), output_buf);\n    }\n\n    /// Encode arbitrary octets as base64 into a supplied slice.\n    /// Writes into the supplied output buffer.\n    ///\n    /// This is useful if you wish to avoid allocation entirely (e.g. encoding into a stack-resident\n    /// or statically-allocated buffer).\n    ///\n    /// # Example\n    ///\n    #[cfg_attr(feature = \"alloc\", doc = \"```\")]\n    #[cfg_attr(not(feature = \"alloc\"), doc = \"```ignore\")]\n    /// use base64::{Engine as _, engine::general_purpose};\n    /// let s = b\"hello internet!\";\n    /// let mut buf = Vec::new();\n    /// // make sure we'll have a slice big enough for base64 + padding\n    /// buf.resize(s.len() * 4 / 3 + 4, 0);\n    ///\n    /// let bytes_written = general_purpose::STANDARD.encode_slice(s, &mut buf).unwrap();\n    ///\n    /// // shorten our vec down to just what was written\n    /// buf.truncate(bytes_written);\n    ///\n    /// assert_eq!(s, general_purpose::STANDARD.decode(&buf).unwrap().as_slice());\n    /// ```\n    #[inline]\n    fn encode_slice<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        output_buf: &mut [u8],\n    ) -> Result<usize, EncodeSliceError> {\n        #[inline(always)]\n        fn inner<E>(\n            engine: &E,\n            input_bytes: &[u8],\n            output_buf: &mut [u8],\n        ) -> Result<usize, EncodeSliceError>\n        where\n            E: Engine + ?Sized,\n        {\n            let encoded_size = encoded_len(input_bytes.len(), engine.config().encode_padding())\n                .expect(\"usize overflow when calculating buffer size\");\n\n            if output_buf.len() < encoded_size {\n                return Err(EncodeSliceError::OutputSliceTooSmall);\n            }\n\n            let b64_output = &mut output_buf[0..encoded_size];\n\n            encode_with_padding(input_bytes, b64_output, engine, encoded_size);\n\n            Ok(encoded_size)\n        }\n\n        inner(self, input.as_ref(), output_buf)\n    }\n\n    /// Decode the input into a new `Vec`.\n    ///\n    /// # Example\n    ///\n    /// ```rust\n    /// use base64::{Engine as _, alphabet, engine::{self, general_purpose}};\n    ///\n    /// let bytes = general_purpose::STANDARD\n    ///     .decode(\"aGVsbG8gd29ybGR+Cg==\").unwrap();\n    /// println!(\"{:?}\", bytes);\n    ///\n    /// // custom engine setup\n    /// let bytes_url = engine::GeneralPurpose::new(\n    ///              &alphabet::URL_SAFE,\n    ///              general_purpose::NO_PAD)\n    ///     .decode(\"aGVsbG8gaW50ZXJuZXR-Cg\").unwrap();\n    /// println!(\"{:?}\", bytes_url);\n    /// ```\n    #[cfg(any(feature = \"alloc\", test))]\n    #[inline]\n    fn decode<T: AsRef<[u8]>>(&self, input: T) -> Result<Vec<u8>, DecodeError> {\n        fn inner<E>(engine: &E, input_bytes: &[u8]) -> Result<Vec<u8>, DecodeError>\n        where\n            E: Engine + ?Sized,\n        {\n            let estimate = engine.internal_decoded_len_estimate(input_bytes.len());\n            let mut buffer = vec![0; estimate.decoded_len_estimate()];\n\n            let bytes_written = engine\n                .internal_decode(input_bytes, &mut buffer, estimate)\n                .map_err(|e| match e {\n                    DecodeSliceError::DecodeError(e) => e,\n                    DecodeSliceError::OutputSliceTooSmall => {\n                        unreachable!(\"Vec is sized conservatively\")\n                    }\n                })?\n                .decoded_len;\n\n            buffer.truncate(bytes_written);\n\n            Ok(buffer)\n        }\n\n        inner(self, input.as_ref())\n    }\n\n    /// Decode the `input` into the supplied `buffer`.\n    ///\n    /// Writes into the supplied `Vec`, which may allocate if its internal buffer isn't big enough.\n    /// Returns a `Result` containing an empty tuple, aka `()`.\n    ///\n    /// # Example\n    ///\n    /// ```rust\n    /// use base64::{Engine as _, alphabet, engine::{self, general_purpose}};\n    /// const CUSTOM_ENGINE: engine::GeneralPurpose =\n    ///     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::PAD);\n    ///\n    /// fn main() {\n    ///     use base64::Engine;\n    ///     let mut buffer = Vec::<u8>::new();\n    ///     // with the default engine\n    ///     general_purpose::STANDARD\n    ///         .decode_vec(\"aGVsbG8gd29ybGR+Cg==\", &mut buffer,).unwrap();\n    ///     println!(\"{:?}\", buffer);\n    ///\n    ///     buffer.clear();\n    ///\n    ///     // with a custom engine\n    ///     CUSTOM_ENGINE.decode_vec(\n    ///         \"aGVsbG8gaW50ZXJuZXR-Cg==\",\n    ///         &mut buffer,\n    ///     ).unwrap();\n    ///     println!(\"{:?}\", buffer);\n    /// }\n    /// ```\n    #[cfg(any(feature = \"alloc\", test))]\n    #[inline]\n    fn decode_vec<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        buffer: &mut Vec<u8>,\n    ) -> Result<(), DecodeError> {\n        fn inner<E>(engine: &E, input_bytes: &[u8], buffer: &mut Vec<u8>) -> Result<(), DecodeError>\n        where\n            E: Engine + ?Sized,\n        {\n            let starting_output_len = buffer.len();\n            let estimate = engine.internal_decoded_len_estimate(input_bytes.len());\n\n            let total_len_estimate = estimate\n                .decoded_len_estimate()\n                .checked_add(starting_output_len)\n                .expect(\"Overflow when calculating output buffer length\");\n\n            buffer.resize(total_len_estimate, 0);\n\n            let buffer_slice = &mut buffer.as_mut_slice()[starting_output_len..];\n\n            let bytes_written = engine\n                .internal_decode(input_bytes, buffer_slice, estimate)\n                .map_err(|e| match e {\n                    DecodeSliceError::DecodeError(e) => e,\n                    DecodeSliceError::OutputSliceTooSmall => {\n                        unreachable!(\"Vec is sized conservatively\")\n                    }\n                })?\n                .decoded_len;\n\n            buffer.truncate(starting_output_len + bytes_written);\n\n            Ok(())\n        }\n\n        inner(self, input.as_ref(), buffer)\n    }\n\n    /// Decode the input into the provided output slice.\n    ///\n    /// Returns the number of bytes written to the slice, or an error if `output` is smaller than\n    /// the estimated decoded length.\n    ///\n    /// This will not write any bytes past exactly what is decoded (no stray garbage bytes at the end).\n    ///\n    /// See [`crate::decoded_len_estimate`] for calculating buffer sizes.\n    ///\n    /// See [`Engine::decode_slice_unchecked`] for a version that panics instead of returning an error\n    /// if the output buffer is too small.\n    #[inline]\n    fn decode_slice<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        output: &mut [u8],\n    ) -> Result<usize, DecodeSliceError> {\n        fn inner<E>(\n            engine: &E,\n            input_bytes: &[u8],\n            output: &mut [u8],\n        ) -> Result<usize, DecodeSliceError>\n        where\n            E: Engine + ?Sized,\n        {\n            engine\n                .internal_decode(\n                    input_bytes,\n                    output,\n                    engine.internal_decoded_len_estimate(input_bytes.len()),\n                )\n                .map(|dm| dm.decoded_len)\n        }\n\n        inner(self, input.as_ref(), output)\n    }\n\n    /// Decode the input into the provided output slice.\n    ///\n    /// Returns the number of bytes written to the slice.\n    ///\n    /// This will not write any bytes past exactly what is decoded (no stray garbage bytes at the end).\n    ///\n    /// See [`crate::decoded_len_estimate`] for calculating buffer sizes.\n    ///\n    /// See [`Engine::decode_slice`] for a version that returns an error instead of panicking if the output\n    /// buffer is too small.\n    ///\n    /// # Panics\n    ///\n    /// Panics if the provided output buffer is too small for the decoded data.\n    #[inline]\n    fn decode_slice_unchecked<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        output: &mut [u8],\n    ) -> Result<usize, DecodeError> {\n        fn inner<E>(engine: &E, input_bytes: &[u8], output: &mut [u8]) -> Result<usize, DecodeError>\n        where\n            E: Engine + ?Sized,\n        {\n            engine\n                .internal_decode(\n                    input_bytes,\n                    output,\n                    engine.internal_decoded_len_estimate(input_bytes.len()),\n                )\n                .map(|dm| dm.decoded_len)\n                .map_err(|e| match e {\n                    DecodeSliceError::DecodeError(e) => e,\n                    DecodeSliceError::OutputSliceTooSmall => {\n                        panic!(\"Output slice is too small\")\n                    }\n                })\n        }\n\n        inner(self, input.as_ref(), output)\n    }\n\n    /// Returns the symbol used for encode padding.\n    ///\n    /// Typically this is `'='`, but weird alphabets may use other values.\n    fn padding(&self) -> Symbol;\n}","attr_info":{"attributes":[{"DocComment":" An `Engine` provides low-level encoding and decoding operations that all other higher-level parts of the API use. Users of the library will generally not need to implement this."},{"DocComment":""},{"DocComment":" Different implementations offer different characteristics. The library currently ships with"},{"DocComment":" [`GeneralPurpose`] that offers good speed and works on any CPU, with more choices"},{"DocComment":" coming later, like a constant-time one when side channel resistance is called for, and vendor-specific vectorized ones for more speed."},{"DocComment":""},{"DocComment":" See [`general_purpose::STANDARD_NO_PAD`] if you just want standard base64. Otherwise, when possible, it's"},{"DocComment":" recommended to store the engine in a `const` so that references to it won't pose any lifetime"},{"DocComment":" issues, and to avoid repeating the cost of engine setup."},{"DocComment":""},{"DocComment":" Since almost nobody will need to implement `Engine`, docs for internal methods are hidden."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Config","variance":"Invariant"},{"index":2,"name":"Self_DecodeEstimate","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[{"clause_id":0,"span":{"Value":[1536,{"data":{"file_id":10,"beg":{"line":72,"col":18},"end":{"line":72,"col":22}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":18}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[1537,{"data":{"file_id":10,"beg":{"line":72,"col":25},"end":{"line":72,"col":29}},"generated_from_span":null}]},"origin":"WhereClauseOnTrait","trait_":{"regions":[],"skip_binder":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":18}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":2,"span":{"Value":[1538,{"data":{"file_id":10,"beg":{"line":74,"col":17},"end":{"line":74,"col":23}},"generated_from_span":null}]},"origin":{"TraitItem":0},"trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":23}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":3,"span":{"Value":[1539,{"data":{"file_id":10,"beg":{"line":76,"col":25},"end":{"line":76,"col":39}},"generated_from_span":null}]},"origin":{"TraitItem":1},"trait_":{"regions":[],"skip_binder":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":39}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[null,null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"internal_encode","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["internal_encode",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":91,"col":4},"end":{"line":91,"col":72}},"generated_from_span":null}},"source_text":"fn internal_encode(&self, input: &[u8], output: &mut [u8]) -> usize;","attr_info":{"attributes":[{"DocComment":" This is not meant to be called directly; it is only for `Engine` implementors."},{"DocComment":" See the other `encode*` functions on this trait."},{"DocComment":""},{"DocComment":" Encode the `input` bytes into the `output` buffer based on the mapping in `encode_table`."},{"DocComment":""},{"DocComment":" `output` will be long enough to hold the encoded data."},{"DocComment":""},{"DocComment":" Returns the number of bytes written."},{"DocComment":""},{"DocComment":" No padding should be written; that is handled separately."},{"DocComment":""},{"DocComment":" Must not write any bytes into the output slice other than the encoded data."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402},{"Value":[414,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":28},"Shared"]}]},{"Value":[415,{"Ref":[{"Var":{"Bound":[0,2]}},{"Deduplicated":28},"Mut"]}]}],"output":{"Deduplicated":0}},"default":null},"kind":{"TraitMethod":[4,0]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"internal_decoded_len_estimate","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["internal_decoded_len_estimate",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":99,"col":4},"end":{"line":99,"col":86}},"generated_from_span":null}},"source_text":"fn internal_decoded_len_estimate(&self, input_len: usize) -> Self::DecodeEstimate;","attr_info":{"attributes":[{"DocComment":" This is not meant to be called directly; it is only for `Engine` implementors."},{"DocComment":""},{"DocComment":" As an optimization to prevent the decoded length from being calculated twice, it is"},{"DocComment":" sometimes helpful to have a conservative estimate of the decoded size before doing the"},{"DocComment":" decoding, so this calculation is done separately and passed to [Engine::decode()] as needed."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402},{"Deduplicated":0}],"output":{"Deduplicated":39}},"default":null},"kind":{"TraitMethod":[4,1]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"internal_decode","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["internal_decode",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":120,"col":4},"end":{"line":125,"col":50}},"generated_from_span":null}},"source_text":"fn internal_decode(\n        &self,\n        input: &[u8],\n        output: &mut [u8],\n        decode_estimate: Self::DecodeEstimate,\n    ) -> Result<DecodeMetadata, DecodeSliceError>;","attr_info":{"attributes":[{"DocComment":" This is not meant to be called directly; it is only for `Engine` implementors."},{"DocComment":" See the other `decode*` functions on this trait."},{"DocComment":""},{"DocComment":" Decode `input` base64 bytes into the `output` buffer."},{"DocComment":""},{"DocComment":" `decode_estimate` is the result of [Engine::internal_decoded_len_estimate()], which is passed in to avoid"},{"DocComment":" calculating it again (expensive on short inputs).`"},{"DocComment":""},{"DocComment":" Each complete 4-byte chunk of encoded data decodes to 3 bytes of decoded data, but this"},{"DocComment":" function must also handle the final possibly partial chunk."},{"DocComment":" If the input length is not a multiple of 4, or uses padding bytes to reach a multiple of 4,"},{"DocComment":" the trailing 2 or 3 bytes must decode to 1 or 2 bytes, respectively, as per the"},{"DocComment":" [RFC](https://tools.ietf.org/html/rfc4648#section-3.5)."},{"DocComment":""},{"DocComment":" Decoding must not write any bytes into the output slice other than the decoded data."},{"DocComment":""},{"DocComment":" Non-canonical trailing bits in the final symbols or non-canonical padding must be reported as"},{"DocComment":" errors unless the engine is configured otherwise."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402},{"Deduplicated":414},{"Deduplicated":415},{"Deduplicated":39}],"output":{"Deduplicated":93}},"default":null},"kind":{"TraitMethod":[4,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"config","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["config",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":128,"col":4},"end":{"line":128,"col":38}},"generated_from_span":null}},"source_text":"fn config(&self) -> &Self::Config;","attr_info":{"attributes":[{"DocComment":" Returns the config for this engine."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402}],"output":{"Deduplicated":404}},"default":null},"kind":{"TraitMethod":[4,3]}},null,null,{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":18},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Value":[416,{"TypeVar":{"Bound":[1,0]}}]},{"Deduplicated":28}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"encode_slice","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["encode_slice",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":227,"col":4},"end":{"line":256,"col":5}},"generated_from_span":null}},"source_text":"fn encode_slice<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        output_buf: &mut [u8],\n    ) -> Result<usize, EncodeSliceError> {\n        #[inline(always)]\n        fn inner<E>(\n            engine: &E,\n            input_bytes: &[u8],\n            output_buf: &mut [u8],\n        ) -> Result<usize, EncodeSliceError>\n        where\n            E: Engine + ?Sized,\n        {\n            let encoded_size = encoded_len(input_bytes.len(), engine.config().encode_padding())\n                .expect(\"usize overflow when calculating buffer size\");\n\n            if output_buf.len() < encoded_size {\n                return Err(EncodeSliceError::OutputSliceTooSmall);\n            }\n\n            let b64_output = &mut output_buf[0..encoded_size];\n\n            encode_with_padding(input_bytes, b64_output, engine, encoded_size);\n\n            Ok(encoded_size)\n        }\n\n        inner(self, input.as_ref(), output_buf)\n    }","attr_info":{"attributes":[{"DocComment":" Encode arbitrary octets as base64 into a supplied slice."},{"DocComment":" Writes into the supplied output buffer."},{"DocComment":""},{"DocComment":" This is useful if you wish to avoid allocation entirely (e.g. encoding into a stack-resident"},{"DocComment":" or statically-allocated buffer)."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":"```"},{"DocComment":" use base64::{Engine as _, engine::general_purpose};"},{"DocComment":" let s = b\"hello internet!\";"},{"DocComment":" let mut buf = Vec::new();"},{"DocComment":" // make sure we'll have a slice big enough for base64 + padding"},{"DocComment":" buf.resize(s.len() * 4 / 3 + 4, 0);"},{"DocComment":""},{"DocComment":" let bytes_written = general_purpose::STANDARD.encode_slice(s, &mut buf).unwrap();"},{"DocComment":""},{"DocComment":" // shorten our vec down to just what was written"},{"DocComment":" buf.truncate(bytes_written);"},{"DocComment":""},{"DocComment":" assert_eq!(s, general_purpose::STANDARD.decode(&buf).unwrap().as_slice());"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":10,"beg":{"line":226,"col":4},"end":{"line":226,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402},{"Deduplicated":2},{"Deduplicated":30}],"output":{"Deduplicated":49}},"default":{"id":20,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":18},{"Deduplicated":2},{"Deduplicated":23},{"Deduplicated":39}],"const_generics":[],"trait_refs":[{"Value":[40,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":18},{"Deduplicated":23},{"Deduplicated":39}],"const_generics":[],"trait_refs":[]}}}}]},{"Value":[41,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":416},{"Deduplicated":28}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[4,6]}},null,null,null,null,{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"padding","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["padding",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":457,"col":4},"end":{"line":457,"col":32}},"generated_from_span":null}},"source_text":"fn padding(&self) -> Symbol;","attr_info":{"attributes":[{"DocComment":" Returns the symbol used for encode padding."},{"DocComment":""},{"DocComment":" Typically this is `'='`, but weird alphabets may use other values."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402}],"output":{"Deduplicated":7}},"default":null},"kind":{"TraitMethod":[4,11]}}],"vtable":null},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":220,"col":0},"end":{"line":220,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap reference-to-reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsMut`] which is used for converting between mutable references."},{"DocComment":" If you need to do a costly conversion it is better to implement [`From`] with type"},{"DocComment":" `&T` or write a custom function."},{"DocComment":""},{"DocComment":" # Relation to `Borrow`"},{"DocComment":""},{"DocComment":" `AsRef` has the same signature as [`Borrow`], but [`Borrow`] is different in a few aspects:"},{"DocComment":""},{"DocComment":" - Unlike `AsRef`, [`Borrow`] has a blanket impl for any `T`, and can be used to accept either"},{"DocComment":"   a reference or a value. (See also note on `AsRef`'s reflexibility below.)"},{"DocComment":" - [`Borrow`] also requires that [`Hash`], [`Eq`] and [`Ord`] for a borrowed value are"},{"DocComment":"   equivalent to those of the owned value. For this reason, if you want to"},{"DocComment":"   borrow only a single field of a struct you can implement `AsRef`, but not [`Borrow`]."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsRef` auto-dereferences if the inner type is a reference or a mutable reference"},{"DocComment":" (e.g.: `foo.as_ref()` will work the same if `foo` has type `&mut Foo` or `&&mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [dereferenceable types], e.g. `foo.as_ref()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_ref()`. Instead, many smart pointers provide an `as_ref` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsRef::as_ref`] should not be"},{"DocComment":" used for the sole purpose of dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [dereferenceable types]: core::ops::Deref"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::Deref#deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &i32 = x.as_ref();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &i32 = &x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`Deref`] should consider implementing `AsRef<T>` as follows:"},{"DocComment":""},{"DocComment":" [`Deref`]: core::ops::Deref"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::Deref;"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsRef<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     T: ?Sized,"},{"DocComment":"     <SomeType as Deref>::Target: AsRef<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_ref(&self) -> &T {"},{"DocComment":"         self.deref().as_ref()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsRef` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsRef<T> for T`"},{"DocComment":" with [`as_ref`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&T where T: AsRef<U>` which allows `AsRef` to auto-dereference, see \"Generic Implementations\""},{"DocComment":" above)."},{"DocComment":""},{"DocComment":" [`as_ref`]: AsRef::as_ref"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsRef<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" By using trait bounds we can accept arguments of different types as long as they can be"},{"DocComment":" converted to the specified type `T`."},{"DocComment":""},{"DocComment":" For example: By creating a generic function that takes an `AsRef<str>` we express that we"},{"DocComment":" want to accept all references that can be converted to [`&str`] as an argument."},{"DocComment":" Since both [`String`] and [`&str`] implement `AsRef<str>` we can accept both as input argument."},{"DocComment":""},{"DocComment":" [`&str`]: primitive@str"},{"DocComment":" [`Borrow`]: crate::borrow::Borrow"},{"DocComment":" [`Eq`]: crate::cmp::Eq"},{"DocComment":" [`Ord`]: crate::cmp::Ord"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn is_hello<T: AsRef<str>>(s: T) {"},{"DocComment":"    assert_eq!(\"hello\", s.as_ref());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let s = \"hello\";"},{"DocComment":" is_hello(s);"},{"DocComment":""},{"DocComment":" let s = \"hello\".to_string();"},{"DocComment":" is_hello(s);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":"AsRef","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"as_ref","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]},{"Ident":["as_ref",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":223,"col":4},"end":{"line":223,"col":27}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts this type into a shared reference of the (usually inferred) input type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402}],"output":{"Deduplicated":404}},"default":null},"kind":{"TraitMethod":[5,0]}}],"vtable":{"id":18,"generics":{"regions":[],"types":[{"Deduplicated":23}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A marker for types that can be dropped."},{"DocComment":""},{"DocComment":" This should be used for `[const]` bounds,"},{"DocComment":" as non-const bounds will always hold for every type."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Destruct","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"drop_glue","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Destruct",0]},{"Ident":["drop_glue",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":1063,"col":0},"end":{"line":1063,"col":38}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":413}],"output":{"Deduplicated":57}},"default":null},"kind":{"TraitMethod":[6,0]}}],"vtable":null},{"def_id":7,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Send",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":92,"col":0},"end":{"line":92,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that can be transferred across thread boundaries."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines it's"},{"DocComment":" appropriate."},{"DocComment":""},{"DocComment":" An example of a non-`Send` type is the reference-counting pointer"},{"DocComment":" [`rc::Rc`][`Rc`]. If two threads attempt to clone [`Rc`]s that point to the same"},{"DocComment":" reference-counted value, they might try to update the reference count at the"},{"DocComment":" same time, which is [undefined behavior][ub] because [`Rc`] doesn't use atomic"},{"DocComment":" operations. Its cousin [`sync::Arc`][arc] does use atomic operations (incurring"},{"DocComment":" some overhead) and thus is `Send`."},{"DocComment":""},{"DocComment":" See [the Nomicon](../../nomicon/send-and-sync.html) and the [`Sync`] trait for more details."},{"DocComment":""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Send","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":21,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sync",0]}],"span":{"Untagged":{"data":{"file_id":14,"beg":{"line":657,"col":0},"end":{"line":657,"col":26}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types for which it is safe to share references between threads."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines"},{"DocComment":" it's appropriate."},{"DocComment":""},{"DocComment":" The precise definition is: a type `T` is [`Sync`] if and only if `&T` is"},{"DocComment":" [`Send`]. In other words, if there is no possibility of"},{"DocComment":" [undefined behavior][ub] (including data races) when passing"},{"DocComment":" `&T` references between threads."},{"DocComment":""},{"DocComment":" As one would expect, primitive types like [`u8`] and [`f64`]"},{"DocComment":" are all [`Sync`], and so are simple aggregate types containing them,"},{"DocComment":" like tuples, structs and enums. More examples of basic [`Sync`]"},{"DocComment":" types include \"immutable\" types like `&T`, and those with simple"},{"DocComment":" inherited mutability, such as [`Box<T>`][box], [`Vec<T>`][vec] and"},{"DocComment":" most other collection types. (Generic parameters need to be [`Sync`]"},{"DocComment":" for their container to be [`Sync`].)"},{"DocComment":""},{"DocComment":" A somewhat surprising consequence of the definition is that `&mut T`"},{"DocComment":" is `Sync` (if `T` is `Sync`) even though it seems like that might"},{"DocComment":" provide unsynchronized mutation. The trick is that a mutable"},{"DocComment":" reference behind a shared reference (that is, `& &mut T`)"},{"DocComment":" becomes read-only, as if it were a `& &T`. Hence there is no risk"},{"DocComment":" of a data race."},{"DocComment":""},{"DocComment":" A shorter overview of how [`Sync`] and [`Send`] relate to referencing:"},{"DocComment":" * `&T` is [`Send`] if and only if `T` is [`Sync`]"},{"DocComment":" * `&mut T` is [`Send`] if and only if `T` is [`Send`]"},{"DocComment":" * `&T` and `&mut T` are [`Sync`] if and only if `T` is [`Sync`]"},{"DocComment":""},{"DocComment":" Types that are not `Sync` are those that have \"interior"},{"DocComment":" mutability\" in a non-thread-safe form, such as [`Cell`][cell]"},{"DocComment":" and [`RefCell`][refcell]. These types allow for mutation of"},{"DocComment":" their contents even through an immutable, shared reference. For"},{"DocComment":" example the `set` method on [`Cell<T>`][cell] takes `&self`, so it requires"},{"DocComment":" only a shared reference [`&Cell<T>`][cell]. The method performs no"},{"DocComment":" synchronization, thus [`Cell`][cell] cannot be `Sync`."},{"DocComment":""},{"DocComment":" Another example of a non-`Sync` type is the reference-counting"},{"DocComment":" pointer [`Rc`][rc]. Given any reference [`&Rc<T>`][rc], you can clone"},{"DocComment":" a new [`Rc<T>`][rc], modifying the reference counts in a non-atomic way."},{"DocComment":""},{"DocComment":" For cases when one does need thread-safe interior mutability,"},{"DocComment":" Rust provides [atomic data types], as well as explicit locking via"},{"DocComment":" [`sync::Mutex`][mutex] and [`sync::RwLock`][rwlock]. These types"},{"DocComment":" ensure that any mutation cannot cause data races, hence the types"},{"DocComment":" are `Sync`. Likewise, [`sync::Arc`][arc] provides a thread-safe"},{"DocComment":" analogue of [`Rc`][rc]."},{"DocComment":""},{"DocComment":" Any types with interior mutability must also use the"},{"DocComment":" [`cell::UnsafeCell`][unsafecell] wrapper around the value(s) which"},{"DocComment":" can be mutated through a shared reference. Failing to doing this is"},{"DocComment":" [undefined behavior][ub]. For example, [`transmute`][transmute]-ing"},{"DocComment":" from `&T` to `&mut T` is invalid."},{"DocComment":""},{"DocComment":" See [the Nomicon][nomicon-send-and-sync] for more details about `Sync`."},{"DocComment":""},{"DocComment":" [box]: ../../std/boxed/struct.Box.html"},{"DocComment":" [vec]: ../../std/vec/struct.Vec.html"},{"DocComment":" [cell]: crate::cell::Cell"},{"DocComment":" [refcell]: crate::cell::RefCell"},{"DocComment":" [rc]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [atomic data types]: crate::sync::atomic"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [unsafecell]: crate::cell::UnsafeCell"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"},{"DocComment":" [transmute]: crate::mem::transmute"},{"DocComment":" [nomicon-send-and-sync]: ../../nomicon/send-and-sync.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Sync","diagnostic_item":"Sync","has_errors":false},"src":"Normal","is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":22,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":9,"item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Config",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":461,"col":0},"end":{"line":471,"col":1}},"generated_from_span":null}},"source_text":"pub trait Config {\n    /// Returns `true` if padding should be added after the encoded output.\n    ///\n    /// Padding is added outside the engine's `encode()` since the engine may be used\n    /// to encode only a chunk of the overall output, so it can't always know when\n    /// the output is \"done\" and would therefore need padding (if configured).\n    // It could be provided as a separate parameter when encoding, but that feels like\n    // leaking an implementation detail to the user, and it's hopefully more convenient\n    // to have to only pass one thing (the engine) to any part of the API.\n    fn encode_padding(&self) -> bool;\n}","attr_info":{"attributes":[{"DocComment":" The minimal level of configuration that engines must support."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"encode_padding","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Config",0]},{"Ident":["encode_padding",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":470,"col":4},"end":{"line":470,"col":37}},"generated_from_span":null}},"source_text":"fn encode_padding(&self) -> bool;","attr_info":{"attributes":[{"DocComment":" Returns `true` if padding should be added after the encoded output."},{"DocComment":""},{"DocComment":" Padding is added outside the engine's `encode()` since the engine may be used"},{"DocComment":" to encode only a chunk of the overall output, so it can't always know when"},{"DocComment":" the output is \"done\" and would therefore need padding (if configured)."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402}],"output":{"Deduplicated":24}},"default":null},"kind":{"TraitMethod":[9,0]}}],"vtable":{"id":23,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":10,"item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["DecodeEstimate",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":478,"col":0},"end":{"line":485,"col":1}},"generated_from_span":null}},"source_text":"pub trait DecodeEstimate {\n    /// Returns a conservative (err on the side of too big) estimate of the decoded length to use\n    /// for pre-allocating buffers, etc.\n    ///\n    /// The estimate must be no larger than the next largest complete triple of decoded bytes.\n    /// That is, the final quad of symbols to decode may be assumed to be complete with no padding.\n    fn decoded_len_estimate(&self) -> usize;\n}","attr_info":{"attributes":[{"DocComment":" The decode estimate used by an engine implementation. Users do not need to interact with this;"},{"DocComment":" it is only for engine implementors."},{"DocComment":""},{"DocComment":" Implementors may store relevant data here when constructing this to avoid having to calculate"},{"DocComment":" them again during actual decoding."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"decoded_len_estimate","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["DecodeEstimate",0]},{"Ident":["decoded_len_estimate",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":484,"col":4},"end":{"line":484,"col":44}},"generated_from_span":null}},"source_text":"fn decoded_len_estimate(&self) -> usize;","attr_info":{"attributes":[{"DocComment":" Returns a conservative (err on the side of too big) estimate of the decoded length to use"},{"DocComment":" for pre-allocating buffers, etc."},{"DocComment":""},{"DocComment":" The estimate must be no larger than the next largest complete triple of decoded bytes."},{"DocComment":" That is, the final quad of symbols to decode may be assumed to be complete with no padding."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402}],"output":{"Deduplicated":0}},"default":null},"kind":{"TraitMethod":[10,0]}}],"vtable":{"id":24,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnOnce",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":242,"col":0},"end":{"line":242,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The version of the call operator that takes a by-value receiver."},{"DocComment":""},{"DocComment":" Instances of `FnOnce` can be called, but might not be callable multiple"},{"DocComment":" times. Because of this, if the only thing known about a type is that it"},{"DocComment":" implements `FnOnce`, it can only be called once."},{"DocComment":""},{"DocComment":" `FnOnce` is implemented automatically by closures that might consume captured"},{"DocComment":" variables, as well as all types that implement [`FnMut`], e.g., (safe)"},{"DocComment":" [function pointers] (since `FnOnce` is a supertrait of [`FnMut`])."},{"DocComment":""},{"DocComment":" Since both [`Fn`] and [`FnMut`] are subtraits of `FnOnce`, any instance of"},{"DocComment":" [`Fn`] or [`FnMut`] can be used where a `FnOnce` is expected."},{"DocComment":""},{"DocComment":" Use `FnOnce` as a bound when you want to accept a parameter of function-like"},{"DocComment":" type and only need to call it once. If you need to call the parameter"},{"DocComment":" repeatedly, use [`FnMut`] as a bound; if you also need it to not mutate"},{"DocComment":" state, use [`Fn`]."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Using a `FnOnce` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn consume_with_relish<F>(func: F)"},{"DocComment":"     where F: FnOnce() -> String"},{"DocComment":" {"},{"DocComment":"     // `func` consumes its captured variables, so it cannot be run more"},{"DocComment":"     // than once."},{"DocComment":"     println!(\"Consumed: {}\", func());"},{"DocComment":""},{"DocComment":"     println!(\"Delicious!\");"},{"DocComment":""},{"DocComment":"     // Attempting to invoke `func()` again will throw a `use of moved"},{"DocComment":"     // value` error for `func`."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let x = String::from(\"x\");"},{"DocComment":" let consume_and_return_x = move || x;"},{"DocComment":" consume_with_relish(consume_and_return_x);"},{"DocComment":""},{"DocComment":" // `consume_and_return_x` can no longer be invoked at this point"},{"DocComment":" ```"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"FnOnce","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Args","variance":"Unknown"},{"index":2,"name":"Self_Output","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"call_once","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnOnce",0]},{"Ident":["call_once",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":250,"col":4},"end":{"line":250,"col":70}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the call operation."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":{"Other":"rust-call"},"is_variadic":false,"inputs":[{"Deduplicated":18},{"Deduplicated":23}],"output":{"Deduplicated":39}},"default":null},"kind":{"TraitMethod":[11,0]}}],"vtable":{"id":30,"generics":{"regions":[],"types":[{"Deduplicated":23},{"Deduplicated":39}],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]}],"span":{"Untagged":{"data":{"file_id":28,"beg":{"line":1053,"col":0},"end":{"line":1053,"col":29}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `?` formatting."},{"DocComment":""},{"DocComment":" `Debug` should format the output in a programmer-facing, debugging context."},{"DocComment":""},{"DocComment":" Generally speaking, you should just `derive` a `Debug` implementation."},{"DocComment":""},{"DocComment":" When used with the alternate format specifier `#?`, the output is pretty-printed."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all fields implement `Debug`. When"},{"DocComment":" `derive`d for structs, it will use the name of the `struct`, then `{`, then a"},{"DocComment":" comma-separated list of each field's name and `Debug` value, then `}`. For"},{"DocComment":" `enum`s, it will use the name of the variant and, if applicable, `(`, then the"},{"DocComment":" `Debug` values of the fields, then `)`."},{"DocComment":""},{"DocComment":" # Stability"},{"DocComment":""},{"DocComment":" Derived `Debug` formats are not stable, and so may change with future Rust"},{"DocComment":" versions. Additionally, `Debug` implementations of types provided by the"},{"DocComment":" standard library (`std`, `core`, `alloc`, etc.) are not stable, and"},{"DocComment":" may also change with future Rust versions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Deriving an implementation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implementing:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_struct(\"Point\")"},{"DocComment":"          .field(\"x\", &self.x)"},{"DocComment":"          .field(\"y\", &self.y)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are a number of helper methods on the [`Formatter`] struct to help you with manual"},{"DocComment":" implementations, such as [`debug_struct`]."},{"DocComment":""},{"DocComment":" [`debug_struct`]: Formatter::debug_struct"},{"DocComment":""},{"DocComment":" Types that do not wish to use the standard suite of debug representations"},{"DocComment":" provided by the `Formatter` trait (`debug_struct`, `debug_tuple`,"},{"DocComment":" `debug_list`, `debug_set`, `debug_map`) can do something totally custom by"},{"DocComment":" manually writing an arbitrary representation to the `Formatter`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt;"},{"DocComment":" # struct Point {"},{"DocComment":" #     x: i32,"},{"DocComment":" #     y: i32,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Point [{} {}]\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Debug` implementations using either `derive` or the debug builder API"},{"DocComment":" on [`Formatter`] support pretty-printing using the alternate flag: `{:#?}`."},{"DocComment":""},{"DocComment":" Pretty-printing with `#?`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" let expected = \"The origin is: Point {"},{"DocComment":"     x: 0,"},{"DocComment":"     y: 0,"},{"DocComment":" }\";"},{"DocComment":" assert_eq!(format!(\"The origin is: {origin:#?}\"), expected);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"Debug","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]},{"Ident":["fmt",0]}],"span":{"Untagged":{"data":{"file_id":28,"beg":{"line":1084,"col":4},"end":{"line":1084,"col":51}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_tuple(\"\")"},{"DocComment":"          .field(&self.longitude)"},{"DocComment":"          .field(&self.latitude)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let position = Position { longitude: 1.987, latitude: 2.983 };"},{"DocComment":" assert_eq!(format!(\"{position:?}\"), \"(1.987, 2.983)\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{position:#?}\"), \"("},{"DocComment":"     1.987,"},{"DocComment":"     2.983,"},{"DocComment":" )\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":402},{"Value":[417,{"Ref":[{"Var":{"Bound":[0,1]}},{"Value":[418,{"Adt":{"id":32,"generics":{"regions":[{"Var":{"Bound":[0,2]}}],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"Mut"]}]}],"output":{"Deduplicated":371}},"default":null},"kind":{"TraitMethod":[12,0]}}],"vtable":{"id":31,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]}],"span":{"Untagged":{"data":{"file_id":34,"beg":{"line":42,"col":0},"end":{"line":42,"col":24}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for dealing with iterators."},{"DocComment":""},{"DocComment":" This is the main iterator trait. For more about the concept of iterators"},{"DocComment":" generally, please see the [module-level documentation]. In particular, you"},{"DocComment":" may want to know how to [implement `Iterator`][impl]."},{"DocComment":""},{"DocComment":" [module-level documentation]: crate::iter"},{"DocComment":" [impl]: crate::iter#implementing-iterator"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"Iterator","diagnostic_item":"Iterator","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"Self_Item","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"next","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["iter",0]},{"Ident":["traits",0]},{"Ident":["iterator",0]},{"Ident":["Iterator",0]},{"Ident":["next",0]}],"span":{"Untagged":{"data":{"file_id":34,"beg":{"line":78,"col":4},"end":{"line":78,"col":45}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Advances the iterator and returns the next value."},{"DocComment":""},{"DocComment":" Returns [`None`] when iteration is finished. Individual iterator"},{"DocComment":" implementations may choose to resume iteration, and so calling `next()`"},{"DocComment":" again may or may not eventually start returning [`Some(Item)`] again at some"},{"DocComment":" point."},{"DocComment":""},{"DocComment":" [`Some(Item)`]: Some"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let a = [1, 2, 3];"},{"DocComment":""},{"DocComment":" let mut iter = a.into_iter();"},{"DocComment":""},{"DocComment":" // A call to next() returns the next value..."},{"DocComment":" assert_eq!(Some(1), iter.next());"},{"DocComment":" assert_eq!(Some(2), iter.next());"},{"DocComment":" assert_eq!(Some(3), iter.next());"},{"DocComment":""},{"DocComment":" // ... and then None once it's over."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":""},{"DocComment":" // More calls may or may not return `None`. Here, they always will."},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" assert_eq!(None, iter.next());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"IteratorNext","diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":413}],"output":{"Value":[419,{"Adt":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":23}],"const_generics":[],"trait_refs":[]},"builtin":nul