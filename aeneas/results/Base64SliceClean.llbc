er than the decoded data."},{"DocComment":""},{"DocComment":" Non-canonical trailing bits in the final symbols or non-canonical padding must be reported as"},{"DocComment":" errors unless the engine is configured otherwise."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160},{"Deduplicated":172},{"Deduplicated":173},{"Deduplicated":19}],"output":{"Value":[174,{"Adt":{"id":5,"generics":{"regions":[],"types":[{"Value":[175,{"Adt":{"id":9,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]},"builtin":null}}]},{"Deduplicated":131}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"default":null},"kind":{"TraitMethod":[4,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"config","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["config",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":128,"col":4},"end":{"line":128,"col":38}},"generated_from_span":null}},"source_text":"fn config(&self) -> &Self::Config;","attr_info":{"attributes":[{"DocComment":" Returns the config for this engine."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160}],"output":{"Deduplicated":162}},"default":null},"kind":{"TraitMethod":[4,3]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":204},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Value":[176,{"TypeVar":{"Bound":[1,0]}}]},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"encode","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["encode",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":148,"col":4},"end":{"line":164,"col":5}},"generated_from_span":null}},"source_text":"fn encode<T: AsRef<[u8]>>(&self, input: T) -> String {\n        fn inner<E>(engine: &E, input_bytes: &[u8]) -> String\n        where\n            E: Engine + ?Sized,\n        {\n            let encoded_size = encoded_len(input_bytes.len(), engine.config().encode_padding())\n                .expect(\"integer overflow when calculating buffer size\");\n\n            let mut buf = vec![0; encoded_size];\n\n            encode_with_padding(input_bytes, &mut buf[..], engine, encoded_size);\n\n            String::from_utf8(buf).expect(\"Invalid UTF8\")\n        }\n\n        inner(self, input.as_ref())\n    }","attr_info":{"attributes":[{"DocComment":" Encode arbitrary octets as base64 using the provided `Engine`."},{"DocComment":" Returns a `String`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use base64::{Engine as _, engine::{self, general_purpose}, alphabet};"},{"DocComment":""},{"DocComment":" let b64 = general_purpose::STANDARD.encode(b\"hello world~\");"},{"DocComment":" println!(\"{}\", b64);"},{"DocComment":""},{"DocComment":" const CUSTOM_ENGINE: engine::GeneralPurpose ="},{"DocComment":"     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::NO_PAD);"},{"DocComment":""},{"DocComment":" let b64_url = CUSTOM_ENGINE.encode(b\"hello internet~\");"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":147,"col":4},"end":{"line":147,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160},{"Deduplicated":2}],"output":{"Deduplicated":124}},"default":{"id":26,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":7},{"Deduplicated":19}],"const_generics":[],"trait_refs":[{"Value":[16,{"kind":"SelfId","trait_decl_ref":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":6},{"Deduplicated":7},{"Deduplicated":19}],"const_generics":[],"trait_refs":[]}}}}]},{"Value":[17,{"kind":{"Clause":{"Bound":[0,0]}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":176},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}}]}]}}},"kind":{"TraitMethod":[4,4]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":205},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":176},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"encode_string","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["encode_string",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":188,"col":4},"end":{"line":201,"col":5}},"generated_from_span":null}},"source_text":"fn encode_string<T: AsRef<[u8]>>(&self, input: T, output_buf: &mut String) {\n        fn inner<E>(engine: &E, input_bytes: &[u8], output_buf: &mut String)\n        where\n            E: Engine + ?Sized,\n        {\n            let mut sink = chunked_encoder::StringSink::new(output_buf);\n\n            chunked_encoder::ChunkedEncoder::new(engine)\n                .encode(input_bytes, &mut sink)\n                .expect(\"Writing to a String shouldn't fail\");\n        }\n\n        inner(self, input.as_ref(), output_buf);\n    }","attr_info":{"attributes":[{"DocComment":" Encode arbitrary octets as base64 into a supplied `String`."},{"DocComment":" Writes into the supplied `String`, which may allocate if its internal buffer isn't big enough."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use base64::{Engine as _, engine::{self, general_purpose}, alphabet};"},{"DocComment":" const CUSTOM_ENGINE: engine::GeneralPurpose ="},{"DocComment":"     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::NO_PAD);"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     let mut buf = String::new();"},{"DocComment":"     general_purpose::STANDARD.encode_string(b\"hello world~\", &mut buf);"},{"DocComment":"     println!(\"{}\", buf);"},{"DocComment":""},{"DocComment":"     buf.clear();"},{"DocComment":"     CUSTOM_ENGINE.encode_string(b\"hello internet~\", &mut buf);"},{"DocComment":"     println!(\"{}\", buf);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":187,"col":4},"end":{"line":187,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160},{"Deduplicated":2},{"Value":[177,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":124},"Mut"]}]}],"output":{"Deduplicated":36}},"default":{"id":27,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":7},{"Deduplicated":19}],"const_generics":[],"trait_refs":[{"Deduplicated":16},{"Deduplicated":17}]}}},"kind":{"TraitMethod":[4,5]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":6},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":176},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"encode_slice","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["encode_slice",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":227,"col":4},"end":{"line":256,"col":5}},"generated_from_span":null}},"source_text":"fn encode_slice<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        output_buf: &mut [u8],\n    ) -> Result<usize, EncodeSliceError> {\n        #[inline(always)]\n        fn inner<E>(\n            engine: &E,\n            input_bytes: &[u8],\n            output_buf: &mut [u8],\n        ) -> Result<usize, EncodeSliceError>\n        where\n            E: Engine + ?Sized,\n        {\n            let encoded_size = encoded_len(input_bytes.len(), engine.config().encode_padding())\n                .expect(\"usize overflow when calculating buffer size\");\n\n            if output_buf.len() < encoded_size {\n                return Err(EncodeSliceError::OutputSliceTooSmall);\n            }\n\n            let b64_output = &mut output_buf[0..encoded_size];\n\n            encode_with_padding(input_bytes, b64_output, engine, encoded_size);\n\n            Ok(encoded_size)\n        }\n\n        inner(self, input.as_ref(), output_buf)\n    }","attr_info":{"attributes":[{"DocComment":" Encode arbitrary octets as base64 into a supplied slice."},{"DocComment":" Writes into the supplied output buffer."},{"DocComment":""},{"DocComment":" This is useful if you wish to avoid allocation entirely (e.g. encoding into a stack-resident"},{"DocComment":" or statically-allocated buffer)."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":"```"},{"DocComment":" use base64::{Engine as _, engine::general_purpose};"},{"DocComment":" let s = b\"hello internet!\";"},{"DocComment":" let mut buf = Vec::new();"},{"DocComment":" // make sure we'll have a slice big enough for base64 + padding"},{"DocComment":" buf.resize(s.len() * 4 / 3 + 4, 0);"},{"DocComment":""},{"DocComment":" let bytes_written = general_purpose::STANDARD.encode_slice(s, &mut buf).unwrap();"},{"DocComment":""},{"DocComment":" // shorten our vec down to just what was written"},{"DocComment":" buf.truncate(bytes_written);"},{"DocComment":""},{"DocComment":" assert_eq!(s, general_purpose::STANDARD.decode(&buf).unwrap().as_slice());"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":226,"col":4},"end":{"line":226,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160},{"Deduplicated":2},{"Value":[178,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":8},"Mut"]}]}],"output":{"Deduplicated":27}},"default":{"id":11,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":7},{"Deduplicated":19}],"const_generics":[],"trait_refs":[{"Deduplicated":16},{"Deduplicated":17}]}}},"kind":{"TraitMethod":[4,6]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":206},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":176},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"decode","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["decode",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":278,"col":4},"end":{"line":302,"col":5}},"generated_from_span":null}},"source_text":"fn decode<T: AsRef<[u8]>>(&self, input: T) -> Result<Vec<u8>, DecodeError> {\n        fn inner<E>(engine: &E, input_bytes: &[u8]) -> Result<Vec<u8>, DecodeError>\n        where\n            E: Engine + ?Sized,\n        {\n            let estimate = engine.internal_decoded_len_estimate(input_bytes.len());\n            let mut buffer = vec![0; estimate.decoded_len_estimate()];\n\n            let bytes_written = engine\n                .internal_decode(input_bytes, &mut buffer, estimate)\n                .map_err(|e| match e {\n                    DecodeSliceError::DecodeError(e) => e,\n                    DecodeSliceError::OutputSliceTooSmall => {\n                        unreachable!(\"Vec is sized conservatively\")\n                    }\n                })?\n                .decoded_len;\n\n            buffer.truncate(bytes_written);\n\n            Ok(buffer)\n        }\n\n        inner(self, input.as_ref())\n    }","attr_info":{"attributes":[{"DocComment":" Decode the input into a new `Vec`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use base64::{Engine as _, alphabet, engine::{self, general_purpose}};"},{"DocComment":""},{"DocComment":" let bytes = general_purpose::STANDARD"},{"DocComment":"     .decode(\"aGVsbG8gd29ybGR+Cg==\").unwrap();"},{"DocComment":" println!(\"{:?}\", bytes);"},{"DocComment":""},{"DocComment":" // custom engine setup"},{"DocComment":" let bytes_url = engine::GeneralPurpose::new("},{"DocComment":"              &alphabet::URL_SAFE,"},{"DocComment":"              general_purpose::NO_PAD)"},{"DocComment":"     .decode(\"aGVsbG8gaW50ZXJuZXR-Cg\").unwrap();"},{"DocComment":" println!(\"{:?}\", bytes_url);"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":277,"col":4},"end":{"line":277,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160},{"Deduplicated":2}],"output":{"Deduplicated":126}},"default":{"id":28,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":7},{"Deduplicated":19}],"const_generics":[],"trait_refs":[{"Deduplicated":16},{"Deduplicated":17}]}}},"kind":{"TraitMethod":[4,7]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":207},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":176},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"decode_vec","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["decode_vec",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":336,"col":4},"end":{"line":373,"col":5}},"generated_from_span":null}},"source_text":"fn decode_vec<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        buffer: &mut Vec<u8>,\n    ) -> Result<(), DecodeError> {\n        fn inner<E>(engine: &E, input_bytes: &[u8], buffer: &mut Vec<u8>) -> Result<(), DecodeError>\n        where\n            E: Engine + ?Sized,\n        {\n            let starting_output_len = buffer.len();\n            let estimate = engine.internal_decoded_len_estimate(input_bytes.len());\n\n            let total_len_estimate = estimate\n                .decoded_len_estimate()\n                .checked_add(starting_output_len)\n                .expect(\"Overflow when calculating output buffer length\");\n\n            buffer.resize(total_len_estimate, 0);\n\n            let buffer_slice = &mut buffer.as_mut_slice()[starting_output_len..];\n\n            let bytes_written = engine\n                .internal_decode(input_bytes, buffer_slice, estimate)\n                .map_err(|e| match e {\n                    DecodeSliceError::DecodeError(e) => e,\n                    DecodeSliceError::OutputSliceTooSmall => {\n                        unreachable!(\"Vec is sized conservatively\")\n                    }\n                })?\n                .decoded_len;\n\n            buffer.truncate(starting_output_len + bytes_written);\n\n            Ok(())\n        }\n\n        inner(self, input.as_ref(), buffer)\n    }","attr_info":{"attributes":[{"DocComment":" Decode the `input` into the supplied `buffer`."},{"DocComment":""},{"DocComment":" Writes into the supplied `Vec`, which may allocate if its internal buffer isn't big enough."},{"DocComment":" Returns a `Result` containing an empty tuple, aka `()`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use base64::{Engine as _, alphabet, engine::{self, general_purpose}};"},{"DocComment":" const CUSTOM_ENGINE: engine::GeneralPurpose ="},{"DocComment":"     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::PAD);"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     use base64::Engine;"},{"DocComment":"     let mut buffer = Vec::<u8>::new();"},{"DocComment":"     // with the default engine"},{"DocComment":"     general_purpose::STANDARD"},{"DocComment":"         .decode_vec(\"aGVsbG8gd29ybGR+Cg==\", &mut buffer,).unwrap();"},{"DocComment":"     println!(\"{:?}\", buffer);"},{"DocComment":""},{"DocComment":"     buffer.clear();"},{"DocComment":""},{"DocComment":"     // with a custom engine"},{"DocComment":"     CUSTOM_ENGINE.decode_vec("},{"DocComment":"         \"aGVsbG8gaW50ZXJuZXR-Cg==\","},{"DocComment":"         &mut buffer,"},{"DocComment":"     ).unwrap();"},{"DocComment":"     println!(\"{:?}\", buffer);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":335,"col":4},"end":{"line":335,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160},{"Deduplicated":2},{"Value":[179,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":127},"Mut"]}]}],"output":{"Deduplicated":129}},"default":{"id":29,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":7},{"Deduplicated":19}],"const_generics":[],"trait_refs":[{"Deduplicated":16},{"Deduplicated":17}]}}},"kind":{"TraitMethod":[4,8]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":208},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":176},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"decode_slice","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["decode_slice",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":387,"col":4},"end":{"line":410,"col":5}},"generated_from_span":null}},"source_text":"fn decode_slice<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        output: &mut [u8],\n    ) -> Result<usize, DecodeSliceError> {\n        fn inner<E>(\n            engine: &E,\n            input_bytes: &[u8],\n            output: &mut [u8],\n        ) -> Result<usize, DecodeSliceError>\n        where\n            E: Engine + ?Sized,\n        {\n            engine\n                .internal_decode(\n                    input_bytes,\n                    output,\n                    engine.internal_decoded_len_estimate(input_bytes.len()),\n                )\n                .map(|dm| dm.decoded_len)\n        }\n\n        inner(self, input.as_ref(), output)\n    }","attr_info":{"attributes":[{"DocComment":" Decode the input into the provided output slice."},{"DocComment":""},{"DocComment":" Returns the number of bytes written to the slice, or an error if `output` is smaller than"},{"DocComment":" the estimated decoded length."},{"DocComment":""},{"DocComment":" This will not write any bytes past exactly what is decoded (no stray garbage bytes at the end)."},{"DocComment":""},{"DocComment":" See [`crate::decoded_len_estimate`] for calculating buffer sizes."},{"DocComment":""},{"DocComment":" See [`Engine::decode_slice_unchecked`] for a version that panics instead of returning an error"},{"DocComment":" if the output buffer is too small."},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":386,"col":4},"end":{"line":386,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160},{"Deduplicated":2},{"Deduplicated":178}],"output":{"Deduplicated":130}},"default":{"id":30,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":7},{"Deduplicated":19}],"const_generics":[],"trait_refs":[{"Deduplicated":16},{"Deduplicated":17}]}}},"kind":{"TraitMethod":[4,9]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":209},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":176},{"Deduplicated":8}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"decode_slice_unchecked","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["decode_slice_unchecked",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":427,"col":4},"end":{"line":452,"col":5}},"generated_from_span":null}},"source_text":"fn decode_slice_unchecked<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        output: &mut [u8],\n    ) -> Result<usize, DecodeError> {\n        fn inner<E>(engine: &E, input_bytes: &[u8], output: &mut [u8]) -> Result<usize, DecodeError>\n        where\n            E: Engine + ?Sized,\n        {\n            engine\n                .internal_decode(\n                    input_bytes,\n                    output,\n                    engine.internal_decoded_len_estimate(input_bytes.len()),\n                )\n                .map(|dm| dm.decoded_len)\n                .map_err(|e| match e {\n                    DecodeSliceError::DecodeError(e) => e,\n                    DecodeSliceError::OutputSliceTooSmall => {\n                        panic!(\"Output slice is too small\")\n                    }\n                })\n        }\n\n        inner(self, input.as_ref(), output)\n    }","attr_info":{"attributes":[{"DocComment":" Decode the input into the provided output slice."},{"DocComment":""},{"DocComment":" Returns the number of bytes written to the slice."},{"DocComment":""},{"DocComment":" This will not write any bytes past exactly what is decoded (no stray garbage bytes at the end)."},{"DocComment":""},{"DocComment":" See [`crate::decoded_len_estimate`] for calculating buffer sizes."},{"DocComment":""},{"DocComment":" See [`Engine::decode_slice`] for a version that returns an error instead of panicking if the output"},{"DocComment":" buffer is too small."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the provided output buffer is too small for the decoded data."},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":5,"beg":{"line":426,"col":4},"end":{"line":426,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Opaque","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160},{"Deduplicated":2},{"Deduplicated":178}],"output":{"Deduplicated":132}},"default":{"id":31,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":6},{"Deduplicated":2},{"Deduplicated":7},{"Deduplicated":19}],"const_generics":[],"trait_refs":[{"Deduplicated":16},{"Deduplicated":17}]}}},"kind":{"TraitMethod":[4,10]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"padding","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["padding",0]}],"span":{"Untagged":{"data":{"file_id":5,"beg":{"line":457,"col":4},"end":{"line":457,"col":32}},"generated_from_span":null}},"source_text":"fn padding(&self) -> Symbol;","attr_info":{"attributes":[{"DocComment":" Returns the symbol used for encode padding."},{"DocComment":""},{"DocComment":" Typically this is `'='`, but weird alphabets may use other values."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":160}],"output":{"Deduplicated":5}},"default":null},"kind":{"TraitMethod":[4,11]}}],"vtable":null},{"def_id":5,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["AsRef",0]}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":220,"col":0},"end":{"line":220,"col":52}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Used to do a cheap reference-to-reference conversion."},{"DocComment":""},{"DocComment":" This trait is similar to [`AsMut`] which is used for converting between mutable references."},{"DocComment":" If you need to do a costly conversion it is better to implement [`From`] with type"},{"DocComment":" `&T` or write a custom function."},{"DocComment":""},{"DocComment":" # Relation to `Borrow`"},{"DocComment":""},{"DocComment":" `AsRef` has the same signature as [`Borrow`], but [`Borrow`] is different in a few aspects:"},{"DocComment":""},{"DocComment":" - Unlike `AsRef`, [`Borrow`] has a blanket impl for any `T`, and can be used to accept either"},{"DocComment":"   a reference or a value. (See also note on `AsRef`'s reflexibility below.)"},{"DocComment":" - [`Borrow`] also requires that [`Hash`], [`Eq`] and [`Ord`] for a borrowed value are"},{"DocComment":"   equivalent to those of the owned value. For this reason, if you want to"},{"DocComment":"   borrow only a single field of a struct you can implement `AsRef`, but not [`Borrow`]."},{"DocComment":""},{"DocComment":" **Note: This trait must not fail**. If the conversion can fail, use a"},{"DocComment":" dedicated method which returns an [`Option<T>`] or a [`Result<T, E>`]."},{"DocComment":""},{"DocComment":" # Generic Implementations"},{"DocComment":""},{"DocComment":" `AsRef` auto-dereferences if the inner type is a reference or a mutable reference"},{"DocComment":" (e.g.: `foo.as_ref()` will work the same if `foo` has type `&mut Foo` or `&&mut Foo`)."},{"DocComment":""},{"DocComment":" Note that due to historic reasons, the above currently does not hold generally for all"},{"DocComment":" [dereferenceable types], e.g. `foo.as_ref()` will *not* work the same as"},{"DocComment":" `Box::new(foo).as_ref()`. Instead, many smart pointers provide an `as_ref` implementation which"},{"DocComment":" simply returns a reference to the [pointed-to value] (but do not perform a cheap"},{"DocComment":" reference-to-reference conversion for that value). However, [`AsRef::as_ref`] should not be"},{"DocComment":" used for the sole purpose of dereferencing; instead ['`Deref` coercion'] can be used:"},{"DocComment":""},{"DocComment":" [dereferenceable types]: core::ops::Deref"},{"DocComment":" [pointed-to value]: core::ops::Deref::Target"},{"DocComment":" ['`Deref` coercion']: core::ops::Deref#deref-coercion"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let x = Box::new(5i32);"},{"DocComment":" // Avoid this:"},{"DocComment":" // let y: &i32 = x.as_ref();"},{"DocComment":" // Better just write:"},{"DocComment":" let y: &i32 = &x;"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Types which implement [`Deref`] should consider implementing `AsRef<T>` as follows:"},{"DocComment":""},{"DocComment":" [`Deref`]: core::ops::Deref"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use core::ops::Deref;"},{"DocComment":" # struct SomeType;"},{"DocComment":" # impl Deref for SomeType {"},{"DocComment":" #     type Target = [u8];"},{"DocComment":" #     fn deref(&self) -> &[u8] {"},{"DocComment":" #         &[]"},{"DocComment":" #     }"},{"DocComment":" # }"},{"DocComment":" impl<T> AsRef<T> for SomeType"},{"DocComment":" where"},{"DocComment":"     T: ?Sized,"},{"DocComment":"     <SomeType as Deref>::Target: AsRef<T>,"},{"DocComment":" {"},{"DocComment":"     fn as_ref(&self) -> &T {"},{"DocComment":"         self.deref().as_ref()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Reflexivity"},{"DocComment":""},{"DocComment":" Ideally, `AsRef` would be reflexive, i.e. there would be an `impl<T: ?Sized> AsRef<T> for T`"},{"DocComment":" with [`as_ref`] simply returning its argument unchanged."},{"DocComment":" Such a blanket implementation is currently *not* provided due to technical restrictions of"},{"DocComment":" Rust's type system (it would be overlapping with another existing blanket implementation for"},{"DocComment":" `&T where T: AsRef<U>` which allows `AsRef` to auto-dereference, see \"Generic Implementations\""},{"DocComment":" above)."},{"DocComment":""},{"DocComment":" [`as_ref`]: AsRef::as_ref"},{"DocComment":""},{"DocComment":" A trivial implementation of `AsRef<T> for T` must be added explicitly for a particular type `T`"},{"DocComment":" where needed or desired. Note, however, that not all types from `std` contain such an"},{"DocComment":" implementation, and those cannot be added by external code due to orphan rules."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" By using trait bounds we can accept arguments of different types as long as they can be"},{"DocComment":" converted to the specified type `T`."},{"DocComment":""},{"DocComment":" For example: By creating a generic function that takes an `AsRef<str>` we express that we"},{"DocComment":" want to accept all references that can be converted to [`&str`] as an argument."},{"DocComment":" Since both [`String`] and [`&str`] implement `AsRef<str>` we can accept both as input argument."},{"DocComment":""},{"DocComment":" [`&str`]: primitive@str"},{"DocComment":" [`Borrow`]: crate::borrow::Borrow"},{"DocComment":" [`Eq`]: crate::cmp::Eq"},{"DocComment":" [`Ord`]: crate::cmp::Ord"},{"DocComment":" [`String`]: ../../std/string/struct.String.html"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn is_hello<T: AsRef<str>>(s: T) {"},{"DocComment":"    assert_eq!(\"hello\", s.as_ref());"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let s = \"hello\";"},{"DocComment":" is_hello(s);"},{"DocComment":""},{"DocComment":" let s = \"hello\".to_string();"},{"DocComment":" is_hello(s);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"AsRef","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"s