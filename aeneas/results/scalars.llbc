nt":"assert_eq!((-1_i32).wrapping_shl(7), -128);"},{"DocComment":"assert_eq!(42_i32.wrapping_shl(32), 42);"},{"DocComment":"assert_eq!(42_i32.wrapping_shl(1).wrapping_shl(31), 0);"},{"DocComment":"assert_eq!((-1_i32).wrapping_shl(128), -1);"},{"DocComment":"assert_eq!(5_i32.wrapping_shl(1025), 10);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":4},{"Deduplicated":3}],"output":{"Deduplicated":4}},"src":"Normal","body":"Opaque"},{"def_id":69,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":3},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_shr",0]}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":2974,"col":8},"end":{"line":2974,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Panic-free bitwise shift-right; yields `self >> mask(rhs)`,"},{"DocComment":" where `mask` removes any high-order bits of `rhs` that"},{"DocComment":" would cause the shift to exceed the bitwidth of the type."},{"DocComment":""},{"DocComment":" Beware that, unlike most other `wrapping_*` methods on integers, this"},{"DocComment":" does *not* give the same result as doing the shift in infinite precision"},{"DocComment":" then truncating as needed. Instead, the behaviour of this method matches what shift instructions"},{"DocComment":" do on many processors, and is what the `>>` operator does when overflow"},{"DocComment":" checks are disabled, but numerically it's weird.  Consider, instead,"},{"DocComment":" using [`Self::unbounded_shr`] which has nicer behaviour."},{"DocComment":""},{"DocComment":" Note that this is *not* the same as a rotate-right; the"},{"DocComment":" RHS of a wrapping shift-right is restricted to the range"},{"DocComment":" of the type, rather than the bits shifted out of the LHS"},{"DocComment":" being returned to the other end. The primitive integer"},{"DocComment":" types all implement a [`rotate_right`](Self::rotate_right) function,"},{"DocComment":" which may be what you want instead."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"assert_eq!(128_u32.wrapping_shr(7), 1);"},{"DocComment":"assert_eq!(0b1010_u32.wrapping_shr(0), 0b1010);"},{"DocComment":"assert_eq!(0b1010_u32.wrapping_shr(1), 0b101);"},{"DocComment":"assert_eq!(0b1010_u32.wrapping_shr(2), 0b10);"},{"DocComment":"assert_eq!(u32::MAX.wrapping_shr(1), i32::MAX.cast_unsigned());"},{"DocComment":"assert_eq!(42_u32.wrapping_shr(32), 42);"},{"DocComment":"assert_eq!(42_u32.wrapping_shr(1).wrapping_shr(31), 0);"},{"DocComment":"assert_eq!(128_u32.wrapping_shr(128), 128);"},{"DocComment":"assert_eq!(10_u32.wrapping_shr(1025), 5);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":3},{"Deduplicated":3}],"output":{"Deduplicated":3}},"src":"Normal","body":"Opaque"},{"def_id":70,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["num",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":4},"kind":"InherentImplBlock"}}},{"Ident":["wrapping_shr",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":2461,"col":8},"end":{"line":2461,"col":57}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Panic-free bitwise shift-right; yields `self >> mask(rhs)`, where `mask`"},{"DocComment":" removes any high-order bits of `rhs` that would cause the shift to exceed the bitwidth of the type."},{"DocComment":""},{"DocComment":" Beware that, unlike most other `wrapping_*` methods on integers, this"},{"DocComment":" does *not* give the same result as doing the shift in infinite precision"},{"DocComment":" then truncating as needed. Instead, the behaviour of this method matches what shift instructions"},{"DocComment":" do on many processors, and is what the `>>` operator does when overflow"},{"DocComment":" checks are disabled, but numerically it's weird.  Consider, instead,"},{"DocComment":" using [`Self::unbounded_shr`] which has nicer behaviour."},{"DocComment":""},{"DocComment":" Note that this is *not* the same as a rotate-right; the RHS of a wrapping shift-right is restricted"},{"DocComment":" to the range of the type, rather than the bits shifted out of the LHS being returned to the other"},{"DocComment":" end. The primitive integer types all implement a [`rotate_right`](Self::rotate_right) function,"},{"DocComment":" which may be what you want instead."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":"assert_eq!((-128_i32).wrapping_shr(7), -1);"},{"DocComment":"assert_eq!(42_i32.wrapping_shr(32), 42);"},{"DocComment":"assert_eq!(42_i32.wrapping_shr(1).wrapping_shr(31), 0);"},{"DocComment":" assert_eq!((-128_i16).wrapping_shr(64), -128);"},{"DocComment":"assert_eq!(10_i32.wrapping_shr(1025), 5);"},{"DocComment":" ```"}],"inline":"Always","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Fore