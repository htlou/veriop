whereas this\n    // messier syntax works on 1.48\n    let complete_chunk_output =\n        if let Some(complete_chunk_output) = complete_input_chunks.checked_mul(4) {\n            complete_chunk_output\n        } else {\n            return None;\n        };\n\n    if rem > 0 {\n        if padding {\n            complete_chunk_output.checked_add(4)\n        } else {\n            let encoded_rem = match rem {\n                1 => 2,\n                // only other possible remainder is 2\n                // can't use a separate _ => unreachable!() in const fns in ancient rust versions\n                _ => 3,\n            };\n            complete_chunk_output.checked_add(encoded_rem)\n        }\n    } else {\n        Some(complete_chunk_output)\n    }\n}","attr_info":{"attributes":[{"DocComment":" Calculate the base64 encoded length for a given input length, optionally including any"},{"DocComment":" appropriate padding bytes."},{"DocComment":""},{"DocComment":" Returns `None` if the encoded length can't be represented in `usize`. This will happen for"},{"DocComment":" input lengths in approximately the top quarter of the range of `usize`."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":0},{"Deduplicated":21}],"output":{"Deduplicated":24}},"src":"Normal","body":{"Structured":{"span":{"Value":[1201,{"data":{"file_id":18,"beg":{"line":101,"col":0},"end":{"line":129,"col":1}},"generated_from_span":null}]},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"Value":[1202,{"data":{"file_id":18,"beg":{"line":101,"col":61},"end":{"line":101,"col":74}},"generated_from_span":n