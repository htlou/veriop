ar":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":true,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[397,{"Ref":[{"Var":{"Free":0}},{"Value":[398,{"Adt":{"id":33,"generics":{"regions":[],"types":[{"Deduplicated":16},{"Deduplicated":23}],"const_generics":[],"trait_refs":[]},"builtin":null}}]},"Mut"]}]}],"output":{"Deduplicated":58}},"src":{"TraitImpl":{"impl_ref":{"id":35,"generics":{"regions":[],"types":[{"Deduplicated":16},{"Deduplicated":23}],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":398}],"const_generics":[],"trait_refs":[]}},"item_id":0,"reuses_default":false}},"body":"Opaque"},{"def_id":204,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["str",0]},{"Ident":["converts",0]},{"Ident":["from_utf8",0]}],"span":{"Untagged":{"data":{"file_id":76,"beg":{"line":89,"col":0},"end":{"line":89,"col":59}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Converts a slice of bytes to a string slice."},{"DocComment":""},{"DocComment":" This is an alias to [`str::from_utf8`]."},{"DocComment":""},{"DocComment":" A string slice ([`&str`]) is made of bytes ([`u8`]), and a byte slice"},{"DocComment":" ([`&[u8]`][byteslice]) is made of bytes, so this function converts between"},{"DocComment":" the two. Not all byte slices are valid string slices, however: [`&str`] requires"},{"DocComment":" that it is valid UTF-8. `from_utf8()` checks to ensure that the bytes are valid"},{"DocComment":" UTF-8, and then does the conversion."},{"DocComment":""},{"DocComment":" [`&str`]: str"},{"DocComment":" [byteslice]: slice"},{"DocComment":""},{"DocComment":" If you are sure that the byte slice is valid UTF-8, and you don't want to"},{"DocComment":" incur the overhead of the validity check, there is an unsafe version of"},{"DocComment":" this function, [`from_utf8_unchecked`], which has the same"},{"DocComment":" behavior but skips the check."},{"DocComment":""},{"DocComment":" If you need a `String` instead of a `&str`, consider"},{"DocComment":" [`String::from_utf8`][string]."},{"DocComment":""},{"DocComment":" [string]: ../../std/string/struct.String.html#method.from_utf8"},{"DocComment":""},{"DocComment":" Because you can stack-allocate a `[u8; N]`, and you can take a"},{"DocComment":" [`&[u8]`][byteslice] of it, this function is one way to have a"},{"DocComment":" stack-allocated string. There is an example of this in the"},{"DocComment":" examples section below."},{"DocComment":""},{"DocComment":" [byteslice]: slice"},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns `Err` if the slice is not UTF-8 with a description as to why the"},{"DocComment":" provided slice is not UTF-8."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::str;"},{"DocComment":""},{"DocComment":" // some bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We can use the ? (try) operator to check if the bytes are valid"},{"DocComment":" let sparkle_heart = str::from_utf8(&sparkle_heart)?;"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" # Ok::<_, str::Utf8Error>(())"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Incorrect bytes:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::str;"},{"DocComment":""},{"DocComment":" // some invalid bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![0, 159, 146, 150];"},{"DocComment":""},{"DocComment":" assert!(str::from_utf8(&sparkle_heart).is_err());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the docs for [`Utf8Error`] for more details on the kinds of"},{"DocComment":" errors that can be returned."},{"DocComment":""},{"DocComment":" A \"stack allocated string\":"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::str;"},{"DocComment":""},{"DocComment":" // some bytes, in a stack-allocated array"},{"DocComment":" let sparkle_heart = [240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We know these bytes are valid, so just use `unwrap()`."},{"DocComment":" let sparkle_heart: &str = str::from_utf8(&sparkle_heart).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"str_from_utf8","has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":127}],"output":{"Value":[399,{"Adt":{"id":8,"generics":{"regions":[],"types":[{"Deduplicated":237},{"Deduplicated":384}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}},"src":"Normal","body":"Opaque"},{"def_id":205,"item_meta":{"name":[{"Ident":["alloc",0]},{"Ident":["string",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":7},"kind":"InherentImplBlock"}}},{"Ident":["push_str",0]}],"span":{"Untagged":{"data":{"file_id":16,"beg":{"line":1122,"col":4},"end":{"line":1122,"col":44}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Appends a given string slice onto the end of this `String`."},{"DocComment":""},{"DocComment":" # Panics"},{"DocComment":""},{"DocComment":" Panics if the new capacity exceeds `isize::MAX` _bytes_."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let mut s = String::from(\"foo