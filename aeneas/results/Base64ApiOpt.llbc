8. The vector you moved in is also included."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Basic usage:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![240, 159, 146, 150];"},{"DocComment":""},{"DocComment":" // We know these bytes are valid, so we'll use `unwrap()`."},{"DocComment":" let sparkle_heart = String::from_utf8(sparkle_heart).unwrap();"},{"DocComment":""},{"DocComment":" assert_eq!(\"💖\", sparkle_heart);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Incorrect bytes:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" // some invalid bytes, in a vector"},{"DocComment":" let sparkle_heart = vec![0, 159, 146, 150];"},{"DocComment":""},{"DocComment":" assert!(String::from_utf8(sparkle_heart).is_err());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" See the docs for [`FromUtf8Error`] for more details on what you can do"},{"DocComment":" with this error."},{"DocComment":""},{"DocComment":" [`from_utf8_unchecked`]: String::from_utf8_unchecked"},{"DocComment":" [`Vec<u8>`]: crate::vec::Vec \"Vec\""},{"DocComment":" [`&str`]: prim@str \"&str\""},{"DocComment":" [`into_bytes`]: String::into_bytes"}],"inline":"Hint","rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":"string_from_utf8","has_errors":false},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":97}],"output":{"Deduplicated":141}},"src":"Normal","body":"Opaque"},{"def_id":57,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"},{"index":1,"name":"E","variance":"Unknown"}],"const_generics":[],"trai