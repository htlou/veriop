,1]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"internal_decode","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["internal_decode",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":120,"col":4},"end":{"line":125,"col":50}},"generated_from_span":null}},"source_text":"fn internal_decode(\n        &self,\n        input: &[u8],\n        output: &mut [u8],\n        decode_estimate: Self::DecodeEstimate,\n    ) -> Result<DecodeMetadata, DecodeSliceError>;","attr_info":{"attributes":[{"DocComment":" This is not meant to be called directly; it is only for `Engine` implementors."},{"DocComment":" See the other `decode*` functions on this trait."},{"DocComment":""},{"DocComment":" Decode `input` base64 bytes into the `output` buffer."},{"DocComment":""},{"DocComment":" `decode_estimate` is the result of [Engine::internal_decoded_len_estimate()], which is passed in to avoid"},{"DocComment":" calculating it again (expensive on short inputs).`"},{"DocComment":""},{"DocComment":" Each complete 4-byte chunk of encoded data decodes to 3 bytes of decoded data, but this"},{"DocComment":" function must also handle the final possibly partial chunk."},{"DocComment":" If the input length is not a multiple of 4, or uses padding bytes to reach a multiple of 4,"},{"DocComment":" the trailing 2 or 3 bytes must decode to 1 or 2 bytes, respectively, as per the"},{"DocComment":" [RFC](https://tools.ietf.org/html/rfc4648#section-3.5)."},{"DocComment":""},{"DocComment":" Decoding must not write any bytes into the output slice other than the decoded data."},{"DocComment":""},{"DocComment":" Non-canonical trailing bits in the final symbols or non-canonical padding must be reported as"},{"DocComment":" errors unless the engine is configured otherwise."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":576},{"Deduplicated":588},{"Deduplicated":589},{"Deduplicated":45}],"output":{"Deduplicated":80}},"default":null},"kind":{"TraitMethod":[4,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Invariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"config","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["config",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":128,"col":4},"end":{"line":128,"col":38}},"generated_from_span":null}},"source_text":"fn config(&self) -> &Self::Config;","attr_info":{"attributes":[{"DocComment":" Returns the config for this engine."}],"inline":null,"rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":576}],"output":{"Deduplicated":578}},"default":null},"kind":{"TraitMethod":[4,3]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":58},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":11},{"Deduplicated":40}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"encode","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["encode",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":148,"col":4},"end":{"line":164,"col":5}},"generated_from_span":null}},"source_text":"fn encode<T: AsRef<[u8]>>(&self, input: T) -> String {\n        fn inner<E>(engine: &E, input_bytes: &[u8]) -> String\n        where\n            E: Engine + ?Sized,\n        {\n            let encoded_size = encoded_len(input_bytes.len(), engine.config().encode_padding())\n                .expect(\"integer overflow when calculating buffer size\");\n\n            let mut buf = vec![0; encoded_size];\n\n            encode_with_padding(input_bytes, &mut buf[..], engine, encoded_size);\n\n            String::from_utf8(buf).expect(\"Invalid UTF8\")\n        }\n\n        inner(self, input.as_ref())\n    }","attr_info":{"attributes":[{"DocComment":" Encode arbitrary octets as base64 using the provided `Engine`."},{"DocComment":" Returns a `String`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use base64::{Engine as _, engine::{self, general_purpose}, alphabet};"},{"DocComment":""},{"DocComment":" let b64 = general_purpose::STANDARD.encode(b\"hello world~\");"},{"DocComment":" println!(\"{}\", b64);"},{"DocComment":""},{"DocComment":" const CUSTOM_ENGINE: engine::GeneralPurpose ="},{"DocComment":"     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::NO_PAD);"},{"DocComment":""},{"DocComment":" let b64_url = CUSTOM_ENGINE.encode(b\"hello internet~\");"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":6,"beg":{"line":147,"col":4},"end":{"line":147,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":