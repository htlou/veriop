},{"DocComment":""},{"DocComment":" When used as a [slicing index], `RangeTo` produces a slice of all array"},{"DocComment":" elements before the index indicated by `end`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" let arr = [0, 1, 2, 3, 4];"},{"DocComment":" assert_eq!(arr[ ..  ], [0, 1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[ .. 3], [0, 1, 2      ]); // This is a `RangeTo`"},{"DocComment":" assert_eq!(arr[ ..=3], [0, 1, 2, 3   ]);"},{"DocComment":" assert_eq!(arr[1..  ], [   1, 2, 3, 4]);"},{"DocComment":" assert_eq!(arr[1.. 3], [   1, 2      ]);"},{"DocComment":" assert_eq!(arr[1..=3], [   1, 2, 3   ]);"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [slicing index]: crate::slice::SliceIndex"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"RangeTo","diagnostic_item":null,"has_errors":false},"generics":{"regions":[],"types":[{"index":0,"name":"Idx","variance":"Covariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"src":"Normal","kind":{"Struct":[{"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":289,"col":4},"end":{"line":289,"col":16}},"generated_from_span":null}},"attr_info":{"attributes":[{"DocComment":" The upper bound of the range (exclusive)."}],"inline":null,"rename":null,"public":true},"name":"end","is_positional":false,"ty":{"Deduplicated":29}}]},"layout":[{"key":"x86_64-unknown-linux-gnu","value":{"size":{"chosen":null,"guarantee":{"Value":[152,{"AtLeast":{"Value":[153,{"AlignTo":{"base":{"Value":[154,{"Plus":[{"Value":[155,{"Constant":{"Value":[69,[{"OffsetOf":[{"id":45,"generics":{"regions":[],"types":[{"Deduplicated":29}],"const_generics":[],"trait_refs":[]},"builtin":null},null,0]},{"Deduplicated":0}]]}}]},{"Deduplicated":7}]}]},"target_align":{"Deduplicated":11}}}]}}]}},"align":{"chosen":null,"guarantee":{"Deduplicated":115}},"discriminator":null,"inhabited":{"Dedu