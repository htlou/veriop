= engine::GeneralPurpose::new("},{"DocComment":"              &alphabet::URL_SAFE,"},{"DocComment":"              general_purpose::NO_PAD)"},{"DocComment":"     .decode(\"aGVsbG8gaW50ZXJuZXR-Cg\").unwrap();"},{"DocComment":" println!(\"{:?}\", bytes_url);"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":6,"beg":{"line":277,"col":4},"end":{"line":277,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":576},{"Deduplicated":2}],"output":{"Deduplicated":107}},"default":{"id":26,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[{"Deduplicated":29},{"Deduplicated":2},{"Deduplicated":36},{"Deduplicated":45}],"const_generics":[],"trait_refs":[{"Deduplicated":73},{"Deduplicated":74}]}}},"kind":{"TraitMethod":[4,7]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":120},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":11},{"Deduplicated":40}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"decode_vec","item_meta":{"name":[{"Ident":["base64",0]},{"Ident":["engine",0]},{"Ident":["Engine",0]},{"Ident":["decode_vec",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":336,"col":4},"end":{"line":373,"col":5}},"generated_from_span":null}},"source_text":"fn decode_vec<T: AsRef<[u8]>>(\n        &self,\n        input: T,\n        buffer: &mut Vec<u8>,\n    ) -> Result<(), DecodeError> {\n        fn inner<E>(engine: &E, input_bytes: &[u8], buffer: &mut Vec<u8>) -> Result<(), DecodeError>\n        where\n            E: Engine + ?Sized,\n        {\n            let starting_output_len = buffer.len();\n            let estimate = engine.internal_decoded_len_estimate(input_bytes.len());\n\n            let total_len_estimate = estimate\n                .decoded_len_estimate()\n                .checked_add(starting_output_len)\n                .expect(\"Overflow when calculating output buffer length\");\n\n            buffer.resize(total_len_estimate, 0);\n\n            let buffer_slice = &mut buffer.as_mut_slice()[starting_output_len..];\n\n            let bytes_written = engine\n                .internal_decode(input_bytes, buffer_slice, estimate)\n                .map_err(|e| match e {\n                    DecodeSliceError::DecodeError(e) => e,\n                    DecodeSliceError::OutputSliceTooSmall => {\n                        unreachable!(\"Vec is sized conservatively\")\n                    }\n                })?\n                .decoded_len;\n\n            buffer.truncate(starting_output_len + bytes_written);\n\n            Ok(())\n        }\n\n        inner(self, input.as_ref(), buffer)\n    }","attr_info":{"attributes":[{"DocComment":" Decode the `input` into the supplied `buffer`."},{"DocComment":""},{"DocComment":" Writes into the supplied `Vec`, which may allocate if its internal buffer isn't big enough."},{"DocComment":" Returns a `Result` containing an empty tuple, aka `()`."},{"DocComment":""},{"DocComment":" # Example"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" use base64::{Engine as _, alphabet, engine::{self, general_purpose}};"},{"DocComment":" const CUSTOM_ENGINE: engine::GeneralPurpose ="},{"DocComment":"     engine::GeneralPurpose::new(&alphabet::URL_SAFE, general_purpose::PAD);"},{"DocComment":""},{"DocComment":" fn main() {"},{"DocComment":"     use base64::Engine;"},{"DocComment":"     let mut buffer = Vec::<u8>::new();"},{"DocComment":"     // with the default engine"},{"DocComment":"     general_purpose::STANDARD"},{"DocComment":"         .decode_vec(\"aGVsbG8gd29ybGR+Cg==\", &mut buffer,).unwrap();"},{"DocComment":"     println!(\"{:?}\", buffer);"},{"DocComment":""},{"DocComment":"     buffer.clear();"},{"DocComment":""},{"DocComment":"     // with a custom engine"},{"DocComment":"     CUSTOM_ENGINE.decode_vec("},{"DocComment":"         \"aGVsbG8gaW50ZXJuZXR-Cg==\","},{"DocComment":"         &mut buffer,"},{"DocComment":"     ).unwrap();"},{"DocComment":"     println!(\"{:?}\", buffer);"},{"DocComment":" }"},{"DocComment":" ```"},{"Builtin":{"Inline":["Hint",{"Untagged":{"data":{"file_id":6,"beg":{"line":335,"col":4},"end":{"line":335,"col":13}},"generated_from_span":null}}]}}],"inline":"Hint","rename":null,"public":true},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":576},{"Deduplicated":2},{"Value":[591,{"Ref":[{"Var":{"Bound":[0,1]}},{"Deduplicated":108},"Mut"]}]}],"output":{"Deduplicated":110}},"default":{"id":27,"generics":{"regions":[{"Var":{"Bound":[0,0]}},{"Var":{"Bound":[0,1]}}],"types":[{"Deduplicated":29},{"Deduplicated":2},{"Deduplicated":36},{"Deduplicated":45}],"const_generics":[],"trait_refs":[{"Deduplicated":73},{"Deduplicated":74}]}}},"kind":{"TraitMethod":[4,8]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T","variance":"Contravariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":136},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":9,"generics":{"regions":[],"types":[{"Deduplicated":11},{"Deduplicated":40}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive