  Result ((core.result.Result Std.Usize block.DecompressError) × (Slice
    Std.U8))
  := do
  let (ss, new_back) ← sink.SliceSink.new output 0#usize
  let s ← lift (Array.to_slice (Std.Array.empty Std.U8))
  let (r, ss1, decompress_internal_back) ←
    block.decompress_safe.decompress_internal false
      sink.SliceSink.Insts.Lz4_flexSinkSink input ss s
  let output1 :=
    new_back { ss with output := (decompress_internal_back ss1).output }
  ok (r, output1)

end Lz4Apis
