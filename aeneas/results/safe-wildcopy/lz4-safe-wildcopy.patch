diff --git a/src/block/compress.rs b/src/block/compress.rs
index aebb97b..d570df2 100644
--- a/src/block/compress.rs
+++ b/src/block/compress.rs
@@ -523,7 +523,16 @@ fn push_u16(output: &mut impl Sink, el: u16) {
 #[inline(always)] // (always) necessary otherwise compiler fails to inline it
 #[cfg(feature = "safe-encode")]
 fn copy_literals_wild(output: &mut impl Sink, input: &[u8], input_start: usize, len: usize) {
-    output.extend_from_slice_wild(&input[input_start..input_start + len], len)
+    // The caller leaves at least MFLIMIT bytes after the literals. Each later
+    // sequence writes an offset and the block ends with at least five literals,
+    // so the extra bytes are overwritten before compression returns.
+    let copy_len = match len {
+        0..=8 => 8,
+        9..=16 => 16,
+        17..=24 => 24,
+        _ => len,
+    };
+    output.extend_from_slice_wild(&input[input_start..input_start + copy_len], len)
 }
 
