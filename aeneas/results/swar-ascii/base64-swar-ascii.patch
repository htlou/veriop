+// Each caller masks its input to six bits.
+#[inline(always)]
+fn encode_standard_word(word: u64) -> [u8; 8] {
+    // Spread eight six-bit indices into byte lanes, most significant first.
+    let mut lanes = word >> 16;
+    lanes = (lanes & 0x0000_0000_00ff_ffff) | ((lanes & 0x0000_ffff_ff00_0000) << 8);
+    lanes = (lanes & 0x0000_0fff_0000_0fff) | ((lanes & 0x00ff_f000_00ff_f000) << 4);
+    lanes = (lanes & 0x003f_003f_003f_003f) | ((lanes & 0x0fc0_0fc0_0fc0_0fc0) << 2);
+
+    // Each lane is at most 63. These operations cannot carry or borrow
+    // between lanes, including during the ASCII range adjustments.
+    let ge26 = ((lanes + 0x6666_6666_6666_6666) & 0x8080_8080_8080_8080) >> 7;
+    let ge52 = ((lanes + 0x4c4c_4c4c_4c4c_4c4c) & 0x8080_8080_8080_8080) >> 7;
+    let ge62 = ((lanes + 0x4242_4242_4242_4242) & 0x8080_8080_8080_8080) >> 7;
+    let ge63 = ((lanes + 0x4141_4141_4141_4141) & 0x8080_8080_8080_8080) >> 7;
+    let ascii = lanes + 0x4141_4141_4141_4141 + ge26 * 6 - ge52 * 75 - ge62 * 15 + ge63 * 3;
+    ascii.to_be_bytes()
+}
