duplicated":1014},"id":24649,"kind":{"StorageDead":608},"comments_before":[]},{"span":{"Deduplicated":1014},"id":24650,"kind":{"StorageDead":607},"comments_before":[]},{"span":{"Deduplicated":1014},"id":24651,"kind":{"StorageDead":606},"comments_before":[]},{"span":{"Deduplicated":1014},"id":24652,"kind":{"StorageDead":605},"comments_before":[]},{"span":{"Deduplicated":1014},"id":24653,"kind":{"StorageDead":604},"comments_before":[]},{"span":{"Deduplicated":1014},"id":24654,"kind":{"StorageDead":603},"comments_before":[]},{"span":{"Deduplicated":1014},"id":24655,"kind":{"StorageDead":602},"comments_before":[]},{"span":{"Deduplicated":1014},"id":23721,"kind":"Return","comments_before":[]}]},"comments":[[176,["we read 8 bytes at a time (u64) but only actually consume 6 of those bytes. Thus, we need","2 trailing bytes to be available to read.."]],[182,["Major performance wins from letting the optimizer do the bounds check once, mostly","on the output side"]],[192,["Hand-unrolling for 32 vs 16 or 8 bytes produces yields performance about equivalent","to unsafe pointer code on a Xeon E5-1650v3. 64 byte unrolling was slightly better for","large inputs but significantly worse for 50-byte input, unsurprisingly. I suspect","that it's a not uncommon use case to encode smallish chunks of data (e.g. a 64-byte","SHA-512 digest), so it would be nice if that fit in the unrolled loop at least once.","Plus, single-digit percentage performance differences might well be quite different","on different hardware."]],[267,["Encode what's left after the fast loop."]],[274,["start at the first index not handled by fast loop, which may be 0."]]]}}},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":4}},{"Ident":["get",0]}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":183,"col":4},"end":{"line":183,"col":43}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":"Hint","rename":null,"publ