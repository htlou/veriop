{"Adt":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":0}],"const_generics":[],"trait_refs":[]},"builtin":null}}]},{"Deduplicated":192}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":true,"generics":{"regions":[],"types":[{"index":0,"name":"T","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[],"vtable":{"Unknown":"polymorphic impl in monomorphic mode"}},{"def_id":6,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["slice",0]},{"Ident":["index",0]},{"Impl":{"Trait":6}}],"span":{"Untagged":{"data":{"file_id":4,"beg":{"line":25,"col":0},"end":{"line":27,"col":31}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":16},{"Deduplicated":7}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[{"Value":[1,{"kind":{"TraitImpl":{"id":16,"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},"trait_decl_ref":{"regions":[],"skip_binder":{"id":4,"generics":{"regions":[],"types":[{"Deduplicated":16},{"Deduplicated":7}],"const_generics":[],"trait_refs":[]}}}}]}],"consts":[],"types":[],"methods":[],"vtable":"Lazy"},{"def_id":7,"item_meta":{"name":[{"Ident":["lz4_flex",0]},{"Ident":["sink",0]},{"Impl":{"Trait":7}}],"span":{"Untagged":{"data":{"file_id":11,"beg":{"line":116,"col":0},"end":{"line":200,"col":1}},"generated_from_span":null}},"source_text":"impl Sink for SliceSink<'_> {\n    /// Returns a raw ptr to the first unfilled byte of the Sink. Analogous to `[pos..].as_ptr()`.\n    #[inline]\n    #[cfg(not(all(feature = \"safe-encode\", feature = \"safe-decode\")))]\n    unsafe fn pos_mut_ptr(&mut self) -> *mut u8 {\n        unsafe { self.base_mut_ptr().add(self.pos()) as *mut u8 }\n    }\n\n    /// Pushes a byte to the end of the Sink.\n    #[inline]\n    fn byte_at(&mut self, pos: usize) -> u8 {\n        self.output[pos]\n    }\n\n    /// Pushes a byte to the end of the Sink.\n    #[inline]\n    #[cfg(feature = \"safe-encode\")]\n    fn push(&mut self, byte: u8) {\n        self.output[self.pos] = byte;\n        self.pos += 1;\n    }\n\n    #[cfg(not(all(feature = \"safe-encode\", feature = \"safe-decode\")))]\n    unsafe fn base_mut_ptr(&mut self) -> *mut u8 {\n        self.output.as_mut_ptr()\n    }\n\n    #[inline]\n    fn pos(&self) -> usize {\n        self.pos\n    }\n\n    #[inline]\n    fn capacity(&self) -> usize {\n        self.output.len()\n    }\n\n    #[cfg(not(all(feature = \"safe-encode\", feature = \"safe-decode\")))]\n    #[inline]\n    unsafe fn set_pos(&mut self, new_pos: usize) {\n        debug_assert!(new_pos <= self.capacity());\n        self.pos = new_pos;\n    }\n\n    #[inline]\n    #[cfg(feature = \"safe-decode\")]\n    fn extend_with_fill(&mut self, byte: u8, len: usize) {\n        self.output[self.pos..self.pos + len].fill(byte);\n        self.pos += len;\n    }\n\n    /// Extends the Sink with `data`.\n    #[inline]\n    fn extend_from_slice(&mut self, data: &[u8]) {\n        self.extend_from_slice_wild(data, data.len())\n    }\n\n    #[inline]\n    fn extend_from_slice_wild(&mut self, data: &[u8], copy_len: usize) {\n        assert!(copy_len <= data.len());\n        slice_copy(data, &mut self.output[self.pos..(self.pos) + data.len()]);\n        self.pos += copy_len;\n    }\n\n    /// Copies `len` bytes starting from `start` to the end of the Sink.\n    /// # Panics\n    /// Panics if `start` >= `pos`.\n    #[inline]\n    #[cfg(feature = \"safe-decode\")]\n    fn extend_from_within(&mut self, start: usize, wild_len: usize, copy_len: usize) {\n        self.output.copy_within(start..start + wild_len, self.pos);\n        self.pos += copy_len;\n    }\n\n    #[inline]\n    #[cfg(feature = \"safe-decode\")]\n    #[cfg_attr(feature = \"nightly\", optimize(size))] // to avoid loop unrolling\n    fn extend_from_within_overlapping(&mut self, start: usize, num_bytes: usize) {\n        let offset = self.pos - start;\n        for i in start + offset..start + offset + num_bytes {\n            self.output[i] = self.output[i - offset];\n        }\n        self.pos += num_bytes;\n    }\n}","attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":4}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[],"vtable":"Lazy"},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["result",0]},{"Impl":{"Trait":8}}],"span":{"Untagged":{"data":{"file_id":10,"beg":{"line":2165,"col":0},"end":{"line":2165,"col":42}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"src":"Normal","impl_trait":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":54}],"const_generics":[],"trait_refs":[]}},"is_negative":false,"is_unsafe":false,"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":