ture":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":18},{"Deduplicated":23}],"output":{"Deduplicated":23}},"default":null},"kind":{"TraitMethod":[35,0]}}],"vtable":null},{"def_id":36,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["TryInto",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":617,"col":0},"end":{"line":617,"col":33}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" An attempted conversion that consumes `self`, which may or may not be"},{"DocComment":" expensive."},{"DocComment":""},{"DocComment":" Library authors should usually not directly implement this trait,"},{"DocComment":" but should prefer implementing the [`TryFrom`] trait, which offers"},{"DocComment":" greater flexibility and provides an equivalent `TryInto`"},{"DocComment":" implementation for free, thanks to a blanket implementation in the"},{"DocComment":" standard library. For more information on this, see the"},{"DocComment":" documentation for [`Into`]."},{"DocComment":""},{"DocComment":" Prefer using [`TryInto`] over [`TryFrom`] when specifying trait bounds on a generic function"},{"DocComment":" to ensure that types that only implement [`TryInto`] can be used as well."},{"DocComment":""},{"DocComment":" # Implementing `TryInto`"},{"DocComment":""},{"DocComment":" This suffers the same restrictions and reasoning as implementing"},{"DocComment":" [`Into`], see there for details."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":"TryInto","has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[],"types":[{"index":0,"name":"Self","variance":"Unknown"},{"index":1,"name":"T","variance":"Unknown"},{"index":2,"name":"Self_Error","variance":"Invariant"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"try_into","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["convert",0]},{"Ident":["TryInto",0]},{"Ident":["try_into",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":624,"col":4},"end":{"line":624,"col":48}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the conversion."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":18}],"output":{"Deduplicated":246}},"default":null},"kind":{"TraitMethod":[36,0]}}],"vtable":null},{"def_id":37,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnOnce",0]},{"Instantiated":{"params":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"T0","variance":"Unknown"},{"index":1,"name":"T1","variance":"Unknown"},{"index":2,"name":"T2","variance":"Unknown"},{"index":3,"name":"T3","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"regions":[],"types":[{"Deduplicated":2},{"Deduplicated":11},{"Deduplicated":14}],"const_generics":[],"trait_refs":[]},"kind":"Other"}}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":242,"col":0},"end":{"line":242,"col":35}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" The version of the call operator that takes a by-value receiver."},{"DocComment":""},{"DocComment":" Instances of `FnOnce` can be called, but might not be callable multiple"},{"DocComment":" times. Because of this, if the only thing known about a type is that it"},{"DocComment":" implements `FnOnce`, it can only be called once."},{"DocComment":""},{"DocComment":" `FnOnce` is implemented automatically by closures that might consume captured"},{"DocComment":" variables, as well as all types that implement [`FnMut`], e.g., (safe)"},{"DocComment":" [function pointers] (since `FnOnce` is a supertrait of [`FnMut`])."},{"DocComment":""},{"DocComment":" Since both [`Fn`] and [`FnMut`] are subtraits of `FnOnce`, any instance of"},{"DocComment":" [`Fn`] or [`FnMut`] can be used where a `FnOnce` is expected."},{"DocComment":""},{"DocComment":" Use `FnOnce` as a bound when you want to accept a parameter of function-like"},{"DocComment":" type and only need to call it once. If you need to call the parameter"},{"DocComment":" repeatedly, use [`FnMut`] as a bound; if you also need it to not mutate"},{"DocComment":" state, use [`Fn`]."},{"DocComment":""},{"DocComment":" See the [chapter on closures in *The Rust Programming Language*][book] for"},{"DocComment":" some more information on this topic."},{"DocComment":""},{"DocComment":" Also of note is the special syntax for `Fn` traits (e.g."},{"DocComment":" `Fn(usize, bool) -> usize`). Those interested in the technical details of"},{"DocComment":" this can refer to [the relevant section in the *Rustonomicon*][nomicon]."},{"DocComment":""},{"DocComment":" [book]: ../../book/ch13-01-closures.html"},{"DocComment":" [function pointers]: fn"},{"DocComment":" [nomicon]: ../../nomicon/hrtb.html"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ## Using a `FnOnce` parameter"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" fn consume_with_relish<F>(func: F)"},{"DocComment":"     where F: FnOnce() -> String"},{"DocComment":" {"},{"DocComment":"     // `func` consumes its captured variables, so it cannot be run more"},{"DocComment":"     // than once."},{"DocComment":"     println!(\"Consumed: {}\", func());"},{"DocComment":""},{"DocComment":"     println!(\"Delicious!\");"},{"DocComment":""},{"DocComment":"     // Attempting to invoke `func()` again will throw a `use of moved"},{"DocComment":"     // value` error for `func`."},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let x = String::from(\"x\");"},{"DocComment":" let consume_and_return_x = move || x;"},{"DocComment":" consume_with_relish(consume_and_return_x);"},{"DocComment":""},{"DocComment":" // `consume_and_return_x` can no longer be invoked at this point"},{"DocComment":" ```"},{"Builtin":"Fundamental"}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":"FnOnce","diagnostic_item":null,"has_errors":false},"src":"Normal","is_unsafe":false,"generics":{"regions":[{"index":0,"name":null,"variance":"Unknown","mutability":"Unknown"}],"types":[{"index":0,"name":"T0","variance":"Unknown"},{"index":1,"name":"T1","variance":"Unknown"},{"index":2,"name":"T2","variance":"Unknown"},{"index":3,"name":"T3","variance":"Unknown"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[null],"methods":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"call_once","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["ops",0]},{"Ident":["function",0]},{"Ident":["FnOnce",0]},{"Ident":["call_once",0]}],"span":{"Untagged":{"data":{"file_id":23,"beg":{"line":250,"col":4},"end":{"line":250,"col":70}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Performs the call operation."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Foreign","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsa