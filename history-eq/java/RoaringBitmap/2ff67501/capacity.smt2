(set-logic QF_BV)
(declare-fun len () (_ BitVec 32))
(push 1)
(assert (bvsge len #x00000400))
(assert (bvsle len #x000186a0))
(assert (bvslt (bvsdiv (bvmul len #x00000005) #x00000004) len))
(check-sat)
(pop 1)
(push 1)
(assert (bvsge len #x00000400))
(assert (bvsle len #x000186a0))
(assert (bvsgt (bvsdiv (bvmul len #x00000005) #x00000004) #x0007a120))
(check-sat)
(pop 1)
(push 1)
(assert (bvsge len #x00000000))
(assert (bvslt len #x00000400))
(assert (bvslt (bvmul len #x00000002) len))
(check-sat)
(pop 1)
