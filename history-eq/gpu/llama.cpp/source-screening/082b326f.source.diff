+        (node->src[0]->type == GGML_TYPE_F32 || node->src[0]->type == GGML_TYPE_F16 ||
+         node->src[0]->type == GGML_TYPE_Q4_0 || node->src[0]->type == GGML_TYPE_Q8_0 ||
+         node->src[0]->type == GGML_TYPE_Q4_K)) {
+        kernel_name = "get_rows_f32";
