(set-logic QF_LIA)
(declare-const t0 Int) (declare-const t1 Int)
(declare-const r0 Int) (declare-const r1 Int)
(declare-const c0 Int) (declare-const c1 Int)
(assert (and (<= 0 t0) (< t0 128) (<= 0 t1) (< t1 128)
  (<= 0 r0) (< r0 4) (<= 0 r1) (< r1 4)
  (<= 0 c0) (< c0 8) (<= 0 c1) (< c1 8)))
(assert (= (+ (* (mod t0 16) 4) r0)
           (+ (* (mod t1 16) 4) r1)))
(assert (= (+ (* (div t0 16) 8) c0)
           (+ (* (div t1 16) 8) c1)))
(assert (or (not (= t0 t1)) (not (= r0 r1)) (not (= c0 c1))))
(check-sat)
