(set-logic QF_AUFLIA)
(declare-const e0 Int)
(assert (<= 0 e0 2))
(declare-const s0 Int)
(assert (<= 0 s0 3))
(declare-const v0 Int)
(declare-const e1 Int)
(assert (<= 0 e1 2))
(declare-const s1 Int)
(assert (<= 0 s1 3))
(declare-const v1 Int)
(declare-const e2 Int)
(assert (<= 0 e2 2))
(declare-const s2 Int)
(assert (<= 0 s2 3))
(declare-const v2 Int)
(declare-const e3 Int)
(assert (<= 0 e3 2))
(declare-const s3 Int)
(assert (<= 0 s3 3))
(declare-const v3 Int)
(assert (distinct s0 s1 s2 s3))
(define-fun off0 () Int (+ (ite (< e0 e0) 1 0) (ite (< e1 e0) 1 0) (ite (< e2 e0) 1 0) (ite (< e3 e0) 1 0)))
(define-fun card0 () Int (+ (ite (= e0 e0) 1 0) (ite (= e1 e0) 1 0) (ite (= e2 e0) 1 0) (ite (= e3 e0) 1 0)))
(define-fun old0 () Int (+ off0 (+ (ite (and (= e1 e0) (< s1 s0)) 1 0) (ite (and (= e2 e0) (< s2 s0)) 1 0) (ite (and (= e3 e0) (< s3 s0)) 1 0))))
(define-fun new0 () Int (+ off0 0))
(define-fun off1 () Int (+ (ite (< e0 e1) 1 0) (ite (< e1 e1) 1 0) (ite (< e2 e1) 1 0) (ite (< e3 e1) 1 0)))
(define-fun card1 () Int (+ (ite (= e0 e1) 1 0) (ite (= e1 e1) 1 0) (ite (= e2 e1) 1 0) (ite (= e3 e1) 1 0)))
(define-fun old1 () Int (+ off1 (+ (ite (and (= e0 e1) (< s0 s1)) 1 0) (ite (and (= e2 e1) (< s2 s1)) 1 0) (ite (and (= e3 e1) (< s3 s1)) 1 0))))
(define-fun new1 () Int (+ off1 (+ (ite (= e0 e1) 1 0))))
(define-fun off2 () Int (+ (ite (< e0 e2) 1 0) (ite (< e1 e2) 1 0) (ite (< e2 e2) 1 0) (ite (< e3 e2) 1 0)))
(define-fun card2 () Int (+ (ite (= e0 e2) 1 0) (ite (= e1 e2) 1 0) (ite (= e2 e2) 1 0) (ite (= e3 e2) 1 0)))
(define-fun old2 () Int (+ off2 (+ (ite (and (= e0 e2) (< s0 s2)) 1 0) (ite (and (= e1 e2) (< s1 s2)) 1 0) (ite (and (= e3 e2) (< s3 s2)) 1 0))))
(define-fun new2 () Int (+ off2 (+ (ite (= e0 e2) 1 0) (ite (= e1 e2) 1 0))))
(define-fun off3 () Int (+ (ite (< e0 e3) 1 0) (ite (< e1 e3) 1 0) (ite (< e2 e3) 1 0) (ite (< e3 e3) 1 0)))
(define-fun card3 () Int (+ (ite (= e0 e3) 1 0) (ite (= e1 e3) 1 0) (ite (= e2 e3) 1 0) (ite (= e3 e3) 1 0)))
(define-fun old3 () Int (+ off3 (+ (ite (and (= e0 e3) (< s0 s3)) 1 0) (ite (and (= e1 e3) (< s1 s3)) 1 0) (ite (and (= e2 e3) (< s2 s3)) 1 0))))
(define-fun new3 () Int (+ off3 (+ (ite (= e0 e3) 1 0) (ite (= e1 e3) 1 0) (ite (= e2 e3) 1 0))))
(define-fun oldOut () (Array Int Int) (store (store (store (store ((as const (Array Int Int)) 0) old0 v0) old1 v1) old2 v2) old3 v3))
(define-fun newOut () (Array Int Int) (store (store (store (store ((as const (Array Int Int)) 0) new0 v0) new1 v1) new2 v2) new3 v3))
(assert (or (not (= (select oldOut old0) (select newOut new0))) (not (= (select oldOut old1) (select newOut new1))) (not (= (select oldOut old2) (select newOut new2))) (not (= (select oldOut old3) (select newOut new3)))))
(check-sat)
