(set-logic QF_ABV)
(declare-fun scales () (Array (_ BitVec 32) (_ BitVec 8)))
(declare-fun idx () (_ BitVec 32))
(declare-fun qs () (_ BitVec 16))
(declare-fun qh () (_ BitVec 16))
(assert (bvult idx #x00000100))
(define-fun is () (_ BitVec 32) (bvlshr (bvand idx #x000000e0) #x00000005))
(define-fun b () (_ BitVec 32) (bvlshr (bvand idx #x00000020) #x00000005))
(define-fun low () Bool (bvult is #x00000004))
(define-fun sb ((i (_ BitVec 32))) (_ BitVec 32)
  ((_ zero_extend 24) (select scales i)))
(define-fun pack4 ((i (_ BitVec 32))) (_ BitVec 32)
  (bvor (sb i)
    (bvshl (sb (bvadd i #x00000001)) #x00000008)
    (bvshl (sb (bvadd i #x00000002)) #x00000010)
    (bvshl (sb (bvadd i #x00000003)) #x00000018)))

; Parent scale and min-byte expressions, after the uint8_t cast.
(define-fun old_sc () (_ BitVec 32)
  (bvand (bvor
    (bvand (sb (ite low is (bvadd is #x00000004))) #x0000000f)
    (bvlshr
      (bvand (sb (ite low is (bvsub is #x00000004)))
             (ite low #x00000030 #x000000c0))
      (ite low #x00000000 #x00000002))) #x000000ff))
(define-fun old_m () (_ BitVec 32)
  (bvand (bvor
    (bvlshr
      (bvand (sb (bvadd is #x00000004))
             (ite low #x0000000f #x000000f0))
      (ite low #x00000000 #x00000004))
    (bvlshr
      (bvand (sb (ite low (bvadd is #x00000004) is))
             (ite low #x00000030 #x000000c0))
      (ite low #x00000000 #x00000002))) #x000000ff))

; Child's packed uvec4 view: v.y = bytes 0..3, v.z = 4..7, v.w = 8..11.
(define-fun scale0 () (_ BitVec 32) (pack4 #x00000000))
(define-fun scale4 () (_ BitVec 32) (pack4 #x00000004))
(define-fun scale8 () (_ BitVec 32) (pack4 #x00000008))
(define-fun sc_hi () (_ BitVec 32)
  (bvor (bvand scale8 #x0f0f0f0f)
        (bvlshr (bvand scale0 #xc0c0c0c0) #x00000002)))
(define-fun m_hi () (_ BitVec 32)
  (bvor (bvlshr (bvand scale8 #xf0f0f0f0) #x00000004)
        (bvlshr (bvand scale4 #xc0c0c0c0) #x00000002)))
(define-fun byte_shift () (_ BitVec 32)
  (bvmul #x00000008 (bvand is #x00000003)))
(define-fun new_sc () (_ BitVec 32)
  (bvand (bvlshr (ite low scale0 sc_hi) byte_shift) #x0000003f))
(define-fun new_m () (_ BitVec 32)
  (bvand (bvlshr (ite low scale4 m_hi) byte_shift) #x0000003f))

; Q4_K: parent unpack8 selects a byte after shifting each nibble.
(define-fun nibble_word () (_ BitVec 32)
  (bvand (bvlshr ((_ zero_extend 16) qs)
                  (bvmul b #x00000004)) #x00000f0f))
(define-fun lane_shift () (_ BitVec 32)
  (bvmul (bvand idx #x00000001) #x00000008))
(define-fun old_q4 () (_ BitVec 32)
  (bvand (bvlshr nibble_word lane_shift) #x000000ff))
(define-fun new_q4 () (_ BitVec 32)
  (bvand (bvlshr ((_ zero_extend 16) qs)
                  (bvadd (bvmul b #x00000004) lane_shift)) #x0000000f))

; Q5_K: parent extracts one high bit and adds 16; child ORs it into a byte.
(define-fun hm () (_ BitVec 32)
  (bvshl #x00000101 is))
(define-fun old_h () (_ BitVec 32)
  (bvand (bvlshr (bvand ((_ zero_extend 16) qh) hm) lane_shift)
         #x000000ff))
(define-fun old_q5 () (_ BitVec 32)
  (bvadd old_q4 (ite (= old_h #x00000000) #x00000000 #x00000010)))
(define-fun new_h () (_ BitVec 32)
  (bvshl (bvand (bvlshr ((_ zero_extend 16) qh) is)
                   #x00000101) #x00000004))
(define-fun new_q5 () (_ BitVec 32)
  (bvand (bvlshr (bvor nibble_word new_h) lane_shift) #x000000ff))

(push 1) (assert (not (= old_sc new_sc))) (check-sat) (pop 1)
(push 1) (assert (not (= old_m new_m))) (check-sat) (pop 1)
(push 1) (assert (not (= old_q4 new_q4))) (check-sat) (pop 1)
(push 1) (assert (not (= old_q5 new_q5))) (check-sat) (pop 1)
