(set-logic QF_BV)
(declare-const a (_ BitVec 32))
(declare-const b (_ BitVec 32))
(assert (not (= b #x00000000)))
(define-fun fast () (_ BitVec 32)
  (ite (= (bvand b (bvsub b #x00000001)) #x00000000)
       (bvand a (bvsub b #x00000001))
       (bvurem a b)))
(assert (not (= fast (bvurem a b))))
(check-sat)
