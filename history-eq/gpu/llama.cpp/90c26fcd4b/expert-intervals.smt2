(set-logic QF_LIA)
(declare-const id0 Int)
(assert (<= 0 id0 1))
(declare-const s0 Int)
(assert (<= 0 s0 3))
(declare-const id1 Int)
(assert (<= 0 id1 1))
(declare-const s1 Int)
(assert (<= 0 s1 3))
(declare-const id2 Int)
(assert (<= 0 id2 1))
(declare-const s2 Int)
(assert (<= 0 s2 3))
(declare-const id3 Int)
(assert (<= 0 id3 1))
(declare-const s3 Int)
(assert (<= 0 s3 3))
(assert (distinct s0 s1 s2 s3))
(define-fun count0 () Int (+ (ite (= id0 0) 1 0) (ite (= id1 0) 1 0) (ite (= id2 0) 1 0) (ite (= id3 0) 1 0)))
(define-fun count1 () Int (+ (ite (= id0 1) 1 0) (ite (= id1 1) 1 0) (ite (= id2 1) 1 0) (ite (= id3 1) 1 0)))
(define-fun id-at ((t Int)) Int (ite (= t 0) id0 (ite (= t 1) id1 (ite (= t 2) id2 id3))))
(define-fun pos0 () Int (+ (ite (= s0 0) 0 0) (ite (= s1 0) 1 0) (ite (= s2 0) 2 0) (ite (= s3 0) 3 0)))
(define-fun pos1 () Int (+ (ite (= s0 1) 0 0) (ite (= s1 1) 1 0) (ite (= s2 1) 2 0) (ite (= s3 1) 3 0)))
(define-fun pos2 () Int (+ (ite (= s0 2) 0 0) (ite (= s1 2) 1 0) (ite (= s2 2) 2 0) (ite (= s3 2) 3 0)))
(define-fun pos3 () Int (+ (ite (= s0 3) 0 0) (ite (= s1 3) 1 0) (ite (= s2 3) 2 0) (ite (= s3 3) 3 0)))
(define-fun slot0 () Int (+ (ite (= id0 0) 0 count0) (ite (and (= id1 id0) (< pos1 pos0)) 1 0) (ite (and (= id2 id0) (< pos2 pos0)) 1 0) (ite (and (= id3 id0) (< pos3 pos0)) 1 0)))
(define-fun slot1 () Int (+ (ite (= id1 0) 0 count0) (ite (and (= id0 id1) (< pos0 pos1)) 1 0) (ite (and (= id2 id1) (< pos2 pos1)) 1 0) (ite (and (= id3 id1) (< pos3 pos1)) 1 0)))
(define-fun slot2 () Int (+ (ite (= id2 0) 0 count0) (ite (and (= id0 id2) (< pos0 pos2)) 1 0) (ite (and (= id1 id2) (< pos1 pos2)) 1 0) (ite (and (= id3 id2) (< pos3 pos2)) 1 0)))
(define-fun slot3 () Int (+ (ite (= id3 0) 0 count0) (ite (and (= id0 id3) (< pos0 pos3)) 1 0) (ite (and (= id1 id3) (< pos1 pos3)) 1 0) (ite (and (= id2 id3) (< pos2 pos3)) 1 0)))
(assert (or (ite (= id0 0) (or (< slot0 0) (>= slot0 count0)) (or (< slot0 count0) (>= slot0 4))) (ite (= id1 0) (or (< slot1 0) (>= slot1 count0)) (or (< slot1 count0) (>= slot1 4))) (ite (= id2 0) (or (< slot2 0) (>= slot2 count0)) (or (< slot2 count0) (>= slot2 4))) (ite (= id3 0) (or (< slot3 0) (>= slot3 count0)) (or (< slot3 count0) (>= slot3 4)))))
(check-sat)
