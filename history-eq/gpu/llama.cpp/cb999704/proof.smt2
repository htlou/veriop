(set-logic QF_BV)
(declare-fun iqs () (_ BitVec 8))
(define-fun iq () (_ BitVec 8)
  (bvadd (bvmul #x10 (bvlshr iqs #x05)) (bvand iqs #x0f)))
; The production copy_from_quant loop supplies iqs = 0,4,...,252.
(assert (= (bvand iqs #x03) #x00))
(push 1)
(assert (not (= (bvand iq #x03) #x00)))
(check-sat)
(pop 1)

; Packed32 qs[iq/4] overlays four consecutive uint8_t qs bytes.
; unpack8(uint32_t) yields least-significant byte in its first lane.
(declare-fun word () (_ BitVec 32))
(define-fun shift8 () (_ BitVec 8)
  (ite (= (bvand iqs #x10) #x00) #x00 #x04))
(define-fun shift32 () (_ BitVec 32)
  (ite (= (bvand iqs #x10) #x00) #x00000000 #x00000004))
(define-fun newword () (_ BitVec 32)
  (bvand (bvlshr word shift32) #x0f0f0f0f))
(define-fun old0 () (_ BitVec 8)
  (bvand (bvlshr ((_ extract 7 0) word) shift8) #x0f))
(define-fun old1 () (_ BitVec 8)
  (bvand (bvlshr ((_ extract 15 8) word) shift8) #x0f))
(define-fun old2 () (_ BitVec 8)
  (bvand (bvlshr ((_ extract 23 16) word) shift8) #x0f))
(define-fun old3 () (_ BitVec 8)
  (bvand (bvlshr ((_ extract 31 24) word) shift8) #x0f))
(assert (or
  (not (= old0 ((_ extract 7 0) newword)))
  (not (= old1 ((_ extract 15 8) newword)))
  (not (= old2 ((_ extract 23 16) newword)))
  (not (= old3 ((_ extract 31 24) newword)))))
(check-sat)
