  %#1 = load i32, ptr %page_block_size3, align 8
  %div = sdiv i32 noundef %m, %#1
  %sub.recomposed = srem i32 noundef %m, %#1
  %conv = sext i32 %div to i64
  %conv5 = sext i32 noundef %b to i64
  %#2 = load i64, ptr nowrite noundef %args, align 8
  %mul6 = mul nsw i64 %#2, %conv5
  %#3 = gep ptr %#0, 4 x i64 %mul6
  %arrayidx = gep ptr %#3, 4 x i64 %conv
  %#4 = load i32, ptr %arrayidx, align 4
  tail call void @tma_load_4d(noundef ptr noundef %desc, noundef ptr noundef %barrier, noundef ptr noundef %smem, noundef i32 noundef %k, noundef i32 %sub.recomposed, noundef i32 noundef %h, noundef i32 %#4)
  br label %cleanup

if.then:
  tail call void @tma_load_4d(noundef ptr noundef %desc, noundef ptr noundef %barrier, noundef ptr noundef %smem, noundef i32 noundef %k, noundef i32 noundef %m, noundef i32 noundef %h, noundef i32 noundef %b)
  br label %cleanup

cleanup:
  ret void
}
