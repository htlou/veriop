(define-fun old_error () (_ BitVec 16) (ite (= old_v0 #xff) (concat #x00 b0) (ite (= old_v1 #xff) (concat #x01 b1) (ite (= old_v2 #xff) (concat #x02 b2) (ite (= old_v3 #xff) (concat #x03 b3) (ite (= old_v4 #xff) (concat #x04 b4) (ite (= old_v5 #xff) (concat #x05 b5) (ite (= old_v6 #xff) (concat #x06 b6) (ite (= old_v7 #xff) (concat #x07 b7) #x0800)))))))))
(define-fun old_accum () (_ BitVec 64) (bvor (bvor (bvor (bvor (bvor (bvor (bvor (bvshl ((_ zero_extend 56) old_v0) (_ bv58 64)) (bvshl ((_ zero_extend 56) old_v1) (_ bv52 64))) (bvshl ((_ zero_extend 56) old_v2) (_ bv46 64))) (bvshl ((_ zero_extend 56) old_v3) (_ bv40 64))) (bvshl ((_ zero_extend 56) old_v4) (_ bv34 64))) (bvshl ((_ zero_extend 56) old_v5) (_ bv28 64))) (bvshl ((_ zero_extend 56) old_v6) (_ bv22 64))) (bvshl ((_ zero_extend 56) old_v7) (_ bv16 64))))
