(define-fun mutant_error () (_ BitVec 16) (ite (= (select table b7) #xff) (concat #x00 b7) (ite (= (select table b6) #xff) (concat #x01 b6) (ite (= (select table b5) #xff) (concat #x02 b5) (ite (= (select table b4) #xff) (concat #x03 b4) (ite (= (select table b3) #xff) (concat #x04 b3) (ite (= (select table b2) #xff) (concat #x05 b2) (ite (= (select table b1) #xff) (concat #x06 b1) (ite (= (select table b0) #xff) (concat #x07 b0) #x0800)))))))))
