import C4d36f98.HlpcBoth
open Aeneas Aeneas.Std Result
set_option maxHeartbeats 0

/-! Commit 4d36f98 (compress part): `block::compress::copy_literals_wild`, generic over
`T0` with a `sink::Sink T0` trait instance (a record of methods).
Old: for `len ≤ 8` (≤16, ≤24) calls
`output.extend_from_slice_wild(&input[start..start+8], len)` (16, 24), else exact.
New: `output.extend_from_slice_wild(&input[start..start+len], len)`.
Counterexample: input `[7]`, start 0, len 1. The old version panics on `input[0..8]`
*before* touching the sink, for EVERY trait instance and EVERY sink value; the new
version just calls the instance's `extend_from_slice_wild` with `input[0..1]`.
So Old ≠ New for every instance whose `extend_from_slice_wild` does not panic on that
call; we exhibit a concrete instance modelled on `SliceSink` (the Aeneas model of
`impl Sink for SliceSink::extend_from_slice_wild`, with the `copy_from_slice` body).
Verdict: NOT_EQUIV. -/

theorem usize_add_ok (x y : Usize) (h : x.val + y.val ≤ Usize.max) :
    ∃ z : Usize, x + y = ok z ∧ z.val = x.val + y.val :=
  WP.spec_imp_exists (Usize.add_spec h)

/-- input `[7]` (length 1) -/
def input1 : Slice U8 := Slice.from [7#u8] (by simp; scalar_tac)

/-- Old version panics for every Sink instance and every sink value. -/
theorem copy_wild_old_input1_fail {T0 : Type} (inst : sink.Sink T0) (output : T0) :
    L4d36f98HlpcOld.block.compress.copy_literals_wild inst output input1 0#usize 1#usize
      = fail .panic := by
  unfold L4d36f98HlpcOld.block.compress.copy_literals_wild
  obtain ⟨z, hz, hzv⟩ := usize_add_ok 0#usize 8#usize (by scalar_tac)
  simp [hz, core.slice.index.SliceIndexRangeUsizeSlice.index, input1, Slice.from_val, hzv]

/-- New version = one call of the instance's `extend_from_slice_wild` with `input[0..1] = input1`. -/
theorem copy_wild_new_input1 {T0 : Type} (inst : sink.Sink T0) (output : T0) :
    L4d36f98HlpcNew.block.compress.copy_literals_wild inst output input1 0#usize 1#usize
      = inst.extend_from_slice_wild output input1 1#usize := by
  unfold L4d36f98HlpcNew.block.compress.copy_literals_wild
  obtain ⟨z, hz, hzv⟩ := usize_add_ok 0#usize 1#usize (by scalar_tac)
  simp [hz, core.slice.index.SliceIndexRangeUsizeSlice.index, input1, Slice.from_val, hzv]

/-- Generic NOT_EQUIV: for any instance/sink on which `extend_from_slice_wild` does not
panic on `(input1, 1)`, old and new differ. -/
theorem copy_wild_not_equiv_of {T0 : Type} (inst : sink.Sink T0) (output : T0)
    (h : inst.extend_from_slice_wild output input1 1#usize ≠ fail .panic) :
    L4d36f98HlpcOld.block.compress.copy_literals_wild inst output input1 0#usize 1#usize ≠
    L4d36f98HlpcNew.block.compress.copy_literals_wild inst output input1 0#usize 1#usize := by
  rw [copy_wild_old_input1_fail, copy_wild_new_input1]
  exact fun e => h e.symm

/-! ### A concrete instance (model of `SliceSink`) -/

structure SliceSinkM where
  output : Slice U8
  pos : Usize

/-- Model of `impl Sink for SliceSink :: extend_from_slice_wild` (as generated by Aeneas for the
`SliceSink` impl, forward component only):
`assert!(copy_len <= data.len()); output[pos..pos+data.len()].copy_from_slice(data); pos += copy_len`. -/
def SliceSinkM.extend_from_slice_wild (self : SliceSinkM) (data : Slice U8) (copy_len : Usize) :
    Result SliceSinkM := do
  let i := Slice.len data
  massert (copy_len <= i)
  let i1 := Slice.len data
  let i2 ← self.pos + i1
  let (s, index_mut_back) ←
    core.slice.index.Slice.index_mut
      (core.slice.index.SliceIndexRangeUsizeSlice U8) self.output
      { start := self.pos, «end» := i2 }
  let s1 ← core.slice.Slice.copy_from_slice core.marker.CopyU8 s data
  let i3 ← self.pos + copy_len
  let s2 := index_mut_back s1
  ok { output := s2, pos := i3 }

/-- A concrete `sink.Sink` instance: `extend_from_slice_wild` as above; the other methods
are not used by `copy_literals_wild` and are stubbed with `fail .undef`. -/
def sliceSinkInst : sink.Sink SliceSinkM := {
  byte_at := fun _ _ => fail .undef
  push := fun _ _ => fail .undef
  pos := fun s => ok s.pos
  capacity := fun s => ok (Slice.len s.output)
  extend_with_fill := fun _ _ _ => fail .undef
  extend_from_slice := fun _ _ => fail .undef
  extend_from_slice_wild := SliceSinkM.extend_from_slice_wild
  extend_from_within := fun _ _ _ _ => fail .undef
  extend_from_within_overlapping := fun _ _ _ => fail .undef
}

/-- output buffer of 8 zero bytes -/
def zeros8 : Slice U8 := Slice.from (List.replicate 8 0#u8) (by simp; scalar_tac)
def sinkM0 : SliceSinkM := { output := zeros8, pos := 0#usize }

theorem sliceSink_ewild_input1_spec :
    sliceSinkInst.extend_from_slice_wild sinkM0 input1 1#usize
      ⦃ r => r.pos.val = 1 ∧ r.output.val = 7#u8 :: List.replicate 7 0#u8 ⦄ := by
  simp only [sliceSinkInst, SliceSinkM.extend_from_slice_wild]
  step*
  all_goals simp_all [sinkM0, zeros8, input1, Slice.from_val]
  · scalar_tac
  · simp [List.setSlice!]

/-- With the concrete instance, the sink call succeeds: output `[7,0,...,0]`, pos 1. -/
theorem sliceSink_ewild_input1_ok :
    ∃ r, sliceSinkInst.extend_from_slice_wild sinkM0 input1 1#usize = ok r ∧
      r.pos.val = 1 ∧ r.output.val = 7#u8 :: List.replicate 7 0#u8 :=
  WP.spec_imp_exists sliceSink_ewild_input1_spec

/-- Concrete counterexample: Old panics, New returns `ok r` with output `[7,0,..,0]`, pos 1. -/
theorem copy_wild_concrete_old_fail :
    L4d36f98HlpcOld.block.compress.copy_literals_wild sliceSinkInst sinkM0 input1 0#usize 1#usize
      = fail .panic :=
  copy_wild_old_input1_fail sliceSinkInst sinkM0

theorem copy_wild_concrete_new_ok :
    ∃ r, L4d36f98HlpcNew.block.compress.copy_literals_wild sliceSinkInst sinkM0 input1 0#usize 1#usize
      = ok r ∧ r.pos.val = 1 ∧ r.output.val = 7#u8 :: List.replicate 7 0#u8 := by
  rw [copy_wild_new_input1]
  exact sliceSink_ewild_input1_ok

theorem copy_wild_not_equiv :
    L4d36f98HlpcOld.block.compress.copy_literals_wild sliceSinkInst sinkM0 input1 0#usize 1#usize ≠
    L4d36f98HlpcNew.block.compress.copy_literals_wild sliceSinkInst sinkM0 input1 0#usize 1#usize := by
  apply copy_wild_not_equiv_of
  obtain ⟨r, hr, _⟩ := sliceSink_ewild_input1_ok
  rw [hr]
  simp

#print axioms usize_add_ok
#print axioms copy_wild_old_input1_fail
#print axioms copy_wild_new_input1
#print axioms copy_wild_not_equiv_of
#print axioms sliceSink_ewild_input1_spec
#print axioms sliceSink_ewild_input1_ok
#print axioms copy_wild_concrete_old_fail
#print axioms copy_wild_concrete_new_ok
#print axioms copy_wild_not_equiv
