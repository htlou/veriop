(set-logic QF_BV)
(declare-fun d0 () (_ BitVec 8))
(assert (bvule d0 #x09))
(define-fun b0 () (_ BitVec 8) (bvadd d0 #x30))
(declare-fun d1 () (_ BitVec 8))
(assert (bvule d1 #x09))
(define-fun b1 () (_ BitVec 8) (bvadd d1 #x30))
(declare-fun d2 () (_ BitVec 8))
(assert (bvule d2 #x09))
(define-fun b2 () (_ BitVec 8) (bvadd d2 #x30))
(declare-fun d3 () (_ BitVec 8))
(assert (bvule d3 #x09))
(define-fun b3 () (_ BitVec 8) (bvadd d3 #x30))
(declare-fun d4 () (_ BitVec 8))
(assert (bvule d4 #x09))
(define-fun b4 () (_ BitVec 8) (bvadd d4 #x30))
(declare-fun d5 () (_ BitVec 8))
(assert (bvule d5 #x09))
(define-fun b5 () (_ BitVec 8) (bvadd d5 #x30))
(declare-fun d6 () (_ BitVec 8))
(assert (bvule d6 #x09))
(define-fun b6 () (_ BitVec 8) (bvadd d6 #x30))
(declare-fun d7 () (_ BitVec 8))
(assert (bvule d7 #x09))
(define-fun b7 () (_ BitVec 8) (bvadd d7 #x30))
(define-fun val () (_ BitVec 64) (concat b7 (concat b6 (concat b5 (concat b4 (concat b3 (concat b2 (concat b1 b0))))))))
(define-fun sub () (_ BitVec 64) (bvsub val #x3030303030303030))
(define-fun mixed () (_ BitVec 64) (bvadd (bvmul sub #x000000000000000a) (bvlshr sub #x0000000000000008)))
(define-fun masked () (_ BitVec 64) (bvand mixed #x000000ff000000ff))
(define-fun masked2 () (_ BitVec 64) (bvand (bvlshr mixed #x0000000000000010) #x000000ff000000ff))
(define-fun swar () (_ BitVec 32) ((_ extract 31 0) (bvlshr (bvadd (bvmul masked #x000f424000000064) (bvmul masked2 #x0000271000000001)) #x0000000000000020)))
(define-fun scalar () (_ BitVec 32) (bvadd (bvmul ((_ zero_extend 24) d0) #x00989680) (bvadd (bvmul ((_ zero_extend 24) d1) #x000f4240) (bvadd (bvmul ((_ zero_extend 24) d2) #x000186a0) (bvadd (bvmul ((_ zero_extend 24) d3) #x00002710) (bvadd (bvmul ((_ zero_extend 24) d4) #x000003e8) (bvadd (bvmul ((_ zero_extend 24) d5) #x00000064) (bvadd (bvmul ((_ zero_extend 24) d6) #x0000000a) (bvmul ((_ zero_extend 24) d7) #x00000001)))))))))
(assert (not (= scalar swar)))
(check-sat)
