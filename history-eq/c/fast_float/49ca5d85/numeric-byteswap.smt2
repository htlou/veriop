(set-logic QF_BV)
(declare-fun raw () (_ BitVec 64))
(define-fun swapped () (_ BitVec 64)
  (bvor (bvlshr (bvand raw #xff00000000000000) #x0000000000000038)
    (bvor (bvlshr (bvand raw #x00ff000000000000) #x0000000000000028)
      (bvor (bvlshr (bvand raw #x0000ff0000000000) #x0000000000000018)
        (bvor (bvlshr (bvand raw #x000000ff00000000) #x0000000000000008)
          (bvor (bvshl (bvand raw #x00000000ff000000) #x0000000000000008)
            (bvor (bvshl (bvand raw #x0000000000ff0000) #x0000000000000018)
              (bvor (bvshl (bvand raw #x000000000000ff00) #x0000000000000028)
                    (bvshl (bvand raw #x00000000000000ff) #x0000000000000038)))))))))
(define-fun reversed () (_ BitVec 64)
  (concat ((_ extract 7 0) raw)
    (concat ((_ extract 15 8) raw)
      (concat ((_ extract 23 16) raw)
        (concat ((_ extract 31 24) raw)
          (concat ((_ extract 39 32) raw)
            (concat ((_ extract 47 40) raw)
              (concat ((_ extract 55 48) raw) ((_ extract 63 56) raw)))))))))
(assert (not (= swapped reversed)))
(check-sat)
