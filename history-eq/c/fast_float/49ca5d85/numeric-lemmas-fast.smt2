(define-fun b () (_ BitVec 64) (bvor ((_ zero_extend 56) x1) (bvshl ((_ zero_extend 56) x3) #x0000000000000020)))
(define-fun sum64 () (_ BitVec 64) (bvadd (bvmul a #x000f424000000064) (bvmul b #x0000271000000001)))
(define-fun weighted () (_ BitVec 32) (bvadd (bvmul ((_ zero_extend 24) x0) #x000f4240) (bvadd (bvmul ((_ zero_extend 24) x1) #x00002710) (bvadd (bvmul ((_ zero_extend 24) x2) #x00000064) ((_ zero_extend 24) x3)))))
(define-fun scalar () (_ BitVec 32) (bvadd (bvmul ((_ zero_extend 24) d0) #x00989680) (bvadd (bvmul ((_ zero_extend 24) d1) #x000f4240) (bvadd (bvmul ((_ zero_extend 24) d2) #x000186a0) (bvadd (bvmul ((_ zero_extend 24) d3) #x00002710) (bvadd (bvmul ((_ zero_extend 24) d4) #x000003e8) (bvadd (bvmul ((_ zero_extend 24) d5) #x00000064) (bvadd (bvmul ((_ zero_extend 24) d6) #x0000000a) (bvmul ((_ zero_extend 24) d7) #x00000001)))))))))
