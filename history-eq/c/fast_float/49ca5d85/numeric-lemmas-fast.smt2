(define-fun mixed () (_ BitVec 64) (bvadd (bvmul digits_val #x000000000000000a) (bvlshr digits_val #x0000000000000008)))
(define-fun p0 () (_ BitVec 8) (bvadd (bvmul d0 #x0a) d1))
(push 1)
(assert (not (= ((_ extract 7 0) mixed) p0)))
