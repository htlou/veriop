(define-fun b7 () (_ BitVec 8) (bvadd d7 #x30))
(define-fun val () (_ BitVec 64) (concat b7 (concat b6 (concat b5 (concat b4 (concat b3 (concat b2 (concat b1 b0))))))))
(define-fun digits_val () (_ BitVec 64) (concat d7 (concat d6 (concat d5 (concat d4 (concat d3 (concat d2 (concat d1 d0))))))))
(define-fun sub () (_ BitVec 64) (bvsub val #x3030303030303030))
(push 1)
