(pop 1)
(define-fun p1 () (_ BitVec 8) (bvadd (bvmul d2 #x0a) d3))
(push 1)
(assert (not (= ((_ extract 23 16) mixed) p1)))
(check-sat)
(pop 1)
(define-fun p2 () (_ BitVec 8) (bvadd (bvmul d4 #x0a) d5))
(push 1)
(assert (not (= ((_ extract 39 32) mixed) p2)))
(check-sat)
(pop 1)
(define-fun p3 () (_ BitVec 8) (bvadd (bvmul d6 #x0a) d7))
(push 1)
(assert (not (= ((_ extract 55 48) mixed) p3)))
(check-sat)
(pop 1)
(assert (= ((_ extract 7 0) mixed) p0))
(assert (= ((_ extract 23 16) mixed) p1))
(assert (= ((_ extract 39 32) mixed) p2))
(assert (= ((_ extract 55 48) mixed) p3))
(define-fun pairs_a () (_ BitVec 64) (bvor ((_ zero_extend 56) p0) (bvshl ((_ zero_extend 56) p2) #x0000000000000020)))
(define-fun pairs_b () (_ BitVec 64) (bvor ((_ zero_extend 56) p1) (bvshl ((_ zero_extend 56) p3) #x0000000000000020)))
(push 1)
(assert (not (= (bvand mixed #x000000ff000000ff) pairs_a)))
(check-sat)
(pop 1)
(push 1)
(assert (not (= (bvand (bvlshr mixed #x0000000000000010) #x000000ff000000ff) pairs_b)))
(check-sat)
(pop 1)
(declare-fun x0 () (_ BitVec 8))
(assert (bvule x0 #x63))
(declare-fun x1 () (_ BitVec 8))
(assert (bvule x1 #x63))
(declare-fun x2 () (_ BitVec 8))
(assert (bvule x2 #x63))
(declare-fun x3 () (_ BitVec 8))
(assert (bvule x3 #x63))
