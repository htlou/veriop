(set-logic QF_LIA)
(declare-fun x0 () Int)
(declare-fun x1 () Int)
(declare-fun x2 () Int)
(declare-fun x3 () Int)
(assert (and (<= 0 x0) (<= x0 99)))
(assert (and (<= 0 x1) (<= x1 99)))
(assert (and (<= 0 x2) (<= x2 99)))
(assert (and (<= 0 x3) (<= x3 99)))
(define-fun a () Int (+ x0 (* x2 4294967296)))
(define-fun b () Int (+ x1 (* x3 4294967296)))
(define-fun product () Int (+ (* a 4294967296000100) (* b 42949672960001)))
(define-fun high () Int (div (mod product 18446744073709551616) 4294967296))
(define-fun weighted () Int (+ (* x0 1000000) (* x1 10000) (* x2 100) x3))
(assert (not (= high weighted)))
(check-sat)
