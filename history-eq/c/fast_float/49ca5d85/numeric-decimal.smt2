(set-logic QF_LIA)
(declare-fun d0 () Int)
(declare-fun d1 () Int)
(declare-fun d2 () Int)
(declare-fun d3 () Int)
(declare-fun d4 () Int)
(declare-fun d5 () Int)
(declare-fun d6 () Int)
(declare-fun d7 () Int)
(assert (and (<= 0 d0) (<= d0 9)))
(assert (and (<= 0 d1) (<= d1 9)))
(assert (and (<= 0 d2) (<= d2 9)))
(assert (and (<= 0 d3) (<= d3 9)))
(assert (and (<= 0 d4) (<= d4 9)))
(assert (and (<= 0 d5) (<= d5 9)))
(assert (and (<= 0 d6) (<= d6 9)))
(assert (and (<= 0 d7) (<= d7 9)))
(define-fun scalar () Int (+ (* d0 10000000) (* d1 1000000) (* d2 100000) (* d3 10000) (* d4 1000) (* d5 100) (* d6 10) d7))
(define-fun pairs () Int (+ (* (+ (* 10 d0) d1) 1000000) (* (+ (* 10 d2) d3) 10000) (* (+ (* 10 d4) d5) 100) (+ (* 10 d6) d7)))
(assert (not (= scalar pairs)))
(check-sat)
