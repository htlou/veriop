(set-logic QF_BV)
(declare-const b0 (_ BitVec 8))
(declare-const b1 (_ BitVec 8))
(declare-const b2 (_ BitVec 8))
(declare-const b3 (_ BitVec 8))
(define-fun val () (_ BitVec 32) (concat b3 b2 b1 b0))
(define-fun is4 () Bool (= (bvand (bvor (bvadd val #x46464646) (bvsub val #x30303030)) #x80808080) #x00000000))
(define-fun digits () Bool (and (and (bvuge b0 #x30) (bvule b0 #x39)) (and (bvuge b1 #x30) (bvule b1 #x39)) (and (bvuge b2 #x30) (bvule b2 #x39)) (and (bvuge b3 #x30) (bvule b3 #x39))))
(define-fun t0 () (_ BitVec 32) (bvsub val #x30303030))
(define-fun t1 () (_ BitVec 32) (bvadd (bvmul t0 #x0000000a) (bvlshr t0 #x00000008)))
(define-fun swar () (_ BitVec 32) (bvand (bvlshr (bvmul (bvand t1 #x00ff00ff) #x00640001) #x00000010) #x0000ffff))
(define-fun d0 () (_ BitVec 32) ((_ zero_extend 24) (bvsub b0 #x30)))
(define-fun d1 () (_ BitVec 32) ((_ zero_extend 24) (bvsub b1 #x30)))
(define-fun d2 () (_ BitVec 32) ((_ zero_extend 24) (bvsub b2 #x30)))
(define-fun d3 () (_ BitVec 32) ((_ zero_extend 24) (bvsub b3 #x30)))
(define-fun scalar () (_ BitVec 32) (bvadd (bvmul (bvadd (bvmul (bvadd (bvmul d0 #x0000000a) d1) #x0000000a) d2) #x0000000a) d3))
(assert (and is4 (not (= swar scalar))))
(check-sat)
