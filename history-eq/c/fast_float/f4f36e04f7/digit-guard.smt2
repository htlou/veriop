(set-logic QF_BV)
(declare-const b0 (_ BitVec 8))
(declare-const b1 (_ BitVec 8))
(declare-const b2 (_ BitVec 8))
(declare-const b3 (_ BitVec 8))
(define-fun val () (_ BitVec 32) (concat b3 b2 b1 b0))
(define-fun is4 () Bool (= (bvand (bvor (bvadd val #x46464646) (bvsub val #x30303030)) #x80808080) #x00000000))
(define-fun digits () Bool (and (and (bvuge b0 #x30) (bvule b0 #x39)) (and (bvuge b1 #x30) (bvule b1 #x39)) (and (bvuge b2 #x30) (bvule b2 #x39)) (and (bvuge b3 #x30) (bvule b3 #x39))))
(assert (xor is4 digits))
(check-sat)
