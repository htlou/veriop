(set-logic QF_LIA)
(declare-fun n () Int)
(declare-fun cap () Int)
(assert (and (<= 1 n) (<= n 128) (<= 0 cap)))
; Sizes come from the exact historical constructors and the 64-bit layout logs.
(define-fun old-buffer () Int (+ 24 (* (+ (* 2 n) 2) 16)))
(define-fun new-buffer () Int (+ 24 (* (+ (* 2 n) 1) 16)))
(define-fun old-cctx () Int (+ 16 (* n 8)))
(define-fun new-cctx () Int (+ 16 (* (- n 1) 8)))
(define-fun old-buffer-ok () Bool (and (<= old-buffer cap) (<= old-buffer 5000)))
(define-fun new-buffer-ok () Bool (and (<= new-buffer cap) (<= new-buffer 5000)))
(define-fun old-cctx-ok () Bool (and (<= old-cctx cap) (<= old-cctx 5000)))
(define-fun new-cctx-ok () Bool (and (<= new-cctx cap) (<= new-cctx 5000)))
; A budget sufficient for the old allocation is always sufficient for the new one.
(push 1)
(assert (and old-buffer-ok (not new-buffer-ok)))
(check-sat)
(pop 1)
(push 1)
(assert (and old-cctx-ok (not new-cctx-ok)))
(check-sat)
(pop 1)
; There are valid budgets where only the new allocation succeeds.
(push 1)
(assert (and (= n 2) (= cap 104) new-buffer-ok (not old-buffer-ok)))
(check-sat)
(pop 1)
(push 1)
(assert (and (= n 2) (= cap 24) new-cctx-ok (not old-cctx-ok)))
(check-sat)
(pop 1)
