+    raw_data_item_uint64_optimize_elem_equiv x_;
+    raw_equiv_trans x x_ x'
+  | Tagged len v ->
+    raw_data_item_uint64_optimize_equiv v;
+    let x_ = Tagged len (raw_data_item_uint64_optimize v) in
+    raw_equiv_eq x x_;
+    raw_data_item_uint64_optimize_elem_equiv x_;
+    raw_equiv_trans x x_ x'
