+      raw_equiv_sym (snd x) (snd x_)
+    );
+    list_for_all2_exists (holds_on_pair2 raw_equiv) v_ v;
+    let x_ = Map len v_ in
+    raw_equiv_eq x x_;
+    raw_data_item_uint64_optimize_elem_equiv x_;
+    raw_equiv_trans x x_ x'
+  | Array len v ->
