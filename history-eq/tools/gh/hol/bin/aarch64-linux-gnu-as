#!/bin/bash
# stand-in for binutils cross-assembler: assemble stdin ("-") with clang 14 for aarch64 (+sha3 etc. enabled)
out=a.out
while [ $# -gt 0 ]; do case "$1" in -o) out="$2"; shift 2;; *) shift;; esac; done
exec clang --target=aarch64-linux-gnu -march=armv8.4-a+crypto+sha3 -c -x assembler -o "$out" -
