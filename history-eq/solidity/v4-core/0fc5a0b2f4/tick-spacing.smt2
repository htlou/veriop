(set-logic QF_BV)
(set-option :timeout 30000)
(declare-fun input () (_ BitVec 24))
(define-fun spacing () (_ BitVec 32) ((_ sign_extend 8) input))
(define-fun max-tick () (_ BitVec 32) (_ bv887272 32))
(define-fun min-tick () (_ BitVec 32) (bvneg max-tick))
(define-fun evm-sdiv ((a (_ BitVec 32)) (b (_ BitVec 32))) (_ BitVec 32)
  (ite (= b (_ bv0 32)) (_ bv0 32) (bvsdiv a b)))
(define-fun old-min () (_ BitVec 32) (bvmul (evm-sdiv min-tick spacing) spacing))
(define-fun old-max () (_ BitVec 32) (bvmul (evm-sdiv max-tick spacing) spacing))
(define-fun old-count () (_ BitVec 32)
  (bvadd (evm-sdiv (bvsub old-max old-min) spacing) (_ bv1 32)))
(define-fun new-count () (_ BitVec 32)
  (bvadd (bvsub (evm-sdiv max-tick spacing) (evm-sdiv min-tick spacing)) (_ bv1 32)))
(assert (not (= old-count new-count)))
(check-sat)
(get-info :reason-unknown)
