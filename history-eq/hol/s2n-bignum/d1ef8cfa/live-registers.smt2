(set-logic QF_BV)
(declare-fun rbp () (_ BitVec 64))
(declare-fun rsi () (_ BitVec 64))
(declare-fun rcx () (_ BitVec 64))
(declare-fun rdx () (_ BitVec 64))
(declare-fun r12 () (_ BitVec 64))
(declare-fun r14 () (_ BitVec 64))
(declare-fun r10 () (_ BitVec 64))
(declare-fun r11 () (_ BitVec 64))
(declare-fun r9 () (_ BitVec 64))
(define-fun zero () (_ BitVec 64) (_ bv0 64))
(define-fun one () (_ BitVec 64) (_ bv1 64))
(define-fun odd () Bool (= (bvand r14 one) one))

; Old: conditional selection, neg/add/neg, subtraction, conditional absolute values.
(define-fun oa () (_ BitVec 64) (ite odd rbp zero))
(define-fun oy () (_ BitVec 64) (ite odd (bvneg rsi) zero))
(define-fun oz () (_ BitVec 64) (ite odd rcx zero))
(define-fun ow () (_ BitVec 64) (ite odd rdx zero))
(define-fun ot () (_ BitVec 64) (bvadd oy r14))
(define-fun od () (_ BitVec 64) (bvsub r12 oa))
(define-fun oborrow () Bool (bvult r12 oa))
(define-fun obp () (_ BitVec 64) (ite oborrow r12 rbp))
(define-fun osi () (_ BitVec 64) (ite oborrow r14 rsi))
(define-fun orc () (_ BitVec 64) (bvadd (ite oborrow r10 rcx) (ite oborrow r10 rcx)))
(define-fun ord () (_ BitVec 64) (bvadd (ite oborrow r11 rdx) (ite oborrow r11 rdx)))
(define-fun o12 () (_ BitVec 64) (bvlshr (ite oborrow (bvneg od) od) one))
(define-fun o14 () (_ BitVec 64) (bvlshr (ite oborrow (bvneg ot) ot) one))
(define-fun o10 () (_ BitVec 64) (bvadd r10 oz))
(define-fun o11 () (_ BitVec 64) (bvadd r11 ow))
(define-fun o9 () (_ BitVec 64) (bvsub r9 one))

; New: bt/cmov selection, two subtracts, lea/not absolute value.
(define-fun na () (_ BitVec 64) (ite odd rbp zero))
(define-fun ny () (_ BitVec 64) (ite odd rsi zero))
(define-fun nz () (_ BitVec 64) (ite odd rcx zero))
(define-fun nw () (_ BitVec 64) (ite odd rdx zero))
(define-fun n14sub () (_ BitVec 64) (bvsub r14 ny))
(define-fun nrbxsub () (_ BitVec 64) (bvsub ny r14))
(define-fun nd () (_ BitVec 64) (bvsub r12 na))
(define-fun nborrow () Bool (bvult r12 na))
(define-fun nbp () (_ BitVec 64) (ite nborrow r12 rbp))
(define-fun nsi () (_ BitVec 64) (ite nborrow r14 rsi))
(define-fun nrc () (_ BitVec 64) (bvadd (ite nborrow r10 rcx) (ite nborrow r10 rcx)))
(define-fun nrd () (_ BitVec 64) (bvadd (ite nborrow r11 rdx) (ite nborrow r11 rdx)))
(define-fun n12 () (_ BitVec 64) (bvlshr (ite nborrow (bvnot (bvsub nd one)) nd) one))
(define-fun n14 () (_ BitVec 64) (bvlshr (ite nborrow nrbxsub n14sub) one))
(define-fun n10 () (_ BitVec 64) (bvadd r10 nz))
(define-fun n11 () (_ BitVec 64) (bvadd r11 nw))
(define-fun n9 () (_ BitVec 64) (bvsub r9 one))

(assert (or
  (not (= obp nbp)) (not (= osi nsi)) (not (= orc nrc))
  (not (= ord nrd)) (not (= o12 n12)) (not (= o14 n14))
  (not (= o10 n10)) (not (= o11 n11)) (not (= o9 n9))))
(check-sat)
