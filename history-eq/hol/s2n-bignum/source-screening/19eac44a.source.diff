+      MAP_EVERY EXPAND_TAC ["ahi"; "alo"] THEN
+      REWRITE_TAC[GSYM BIGNUM_FROM_MEMORY_BYTES; BIGNUM_FROM_MEMORY_BOUND];
+      REWRITE_TAC[INTEGER_CLOSED]] THEN
+    ASM_REWRITE_TAC[REAL_OF_NUM_LT; REAL_ARITH
