+
+  ABBREV_TAC `adiff = read (memory :> bytes (t,8 * 16)) s287` THEN
+  X86_STEPS_TAC BIGNUM_KSQR_32_64_EXEC (288--291) THEN
+  BIGNUM_KSQR_32_64_LEMMA_TAC 292 THEN
+  X86_STEPS_TAC BIGNUM_KSQR_32_64_EXEC [293] THEN
