+        .rep k
+        mov     rax, [z-8*2*k+8*k+8*i]
+        adcx    rax, [z-8*2*k+8*i]
+        adox    rax, [z-8*2*k+8*2*k+8*i]
+        mov     [z-8*2*k+8*k+8*i], rax
+        .set i,  (i+1)
+        .endr
