+   (393--408) (392--408) THEN
+  ENSURES_FINAL_STATE_TAC THEN ASM_REWRITE_TAC[] THEN
+  UNDISCH_THEN
+   `&(val(sum_s391:int64)) = &(val(sum_s286:int64)) - &(bitval carry_s388)`
+  SUBST_ALL_TAC THEN
+  UNDISCH_THEN
+   `&(val(sum_s286:int64)) = &(bitval carry_s283) + &(bitval carry_s282)`
