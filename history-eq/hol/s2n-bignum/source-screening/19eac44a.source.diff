+  (*** Simulate the interlocking part, just deduce top carry zeroness ***)
+
+  X86_ACCSTEPS_TAC BIGNUM_KSQR_32_64_EXEC
+   (sort (<)  (map (fun n -> 158 + 4 * n) (0--31) @
+               map (fun n -> 159 + 4 * n) (0--31) @ [286]))
+   (156--287) THEN
+  UNDISCH_TAC
+   `&2 pow 64 * &(bitval carry_s286) + &(val(sum_s286:int64)) =
