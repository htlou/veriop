(set-logic QF_LIA)
(define-fun B () Int 4294967296)
(define-fun B2 () Int 18446744073709551616)
(define-fun MAXPART () Int 18446744065119617025)
(declare-fun ac () Int)
(declare-fun ad () Int)
(declare-fun bc () Int)
(declare-fun bd () Int)
(assert (and (<= 0 ac) (<= ac MAXPART)
             (<= 0 ad) (<= ad MAXPART)
             (<= 0 bc) (<= bc MAXPART)
             (<= 0 bd) (<= bd MAXPART)))
(define-fun intermediate () Int (+ (div bd B) (mod ad B) (mod bc B)))
(define-fun old_high () Int (+ ac (div intermediate B) (div ad B) (div bc B)))
(define-fun old_low () Int (mod (+ (* intermediate B) (mod bd B)) B2))
(define-fun expanded () Int (+ (* ac B2) (* (+ ad bc) B) bd))
; Exact decomposition of the source's carries and shifts.
(push 1)
(assert (not (= expanded (+ (* old_high B2) old_low))))
(check-sat)
(pop 1)
; Both outputs fit in unsigned 64 bits, so the source's modular additions
; and conversions cannot change the mathematical result.
(push 1)
(assert (not (and (<= 0 old_high) (< old_high B2)
                  (<= 0 old_low) (< old_low B2))))
(check-sat)
(pop 1)
