(set-logic QF_NIA)
(define-fun B () Int 4294967296)
(define-fun B2 () Int 18446744073709551616)
(declare-fun a () Int)
(declare-fun b () Int)
(declare-fun c () Int)
(declare-fun d () Int)
(assert (and (<= 0 a) (< a B) (<= 0 b) (< b B)
             (<= 0 c) (< c B) (<= 0 d) (< d B)))
(define-fun x () Int (+ (* a B) b))
(define-fun y () Int (+ (* c B) d))
(define-fun ac () Int (* a c))
(define-fun ad () Int (* a d))
(define-fun bc () Int (* b c))
(define-fun bd () Int (* b d))
; A SAT model would refute the 64x64 multiplication expansion.
(assert (not (= (* x y) (+ (* ac B2) (* (+ ad bc) B) bd))))
(check-sat)
