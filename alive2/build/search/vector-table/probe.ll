define dso_local i64 @vector_lookup(ptr nocapture noundef readonly %0) local_unnamed_addr #0 {
  %2 = load i8, ptr %0, align 1, !tbaa !5
  %3 = and i8 %2, 3
  %4 = zext nneg i8 %3 to i32
  %5 = extractelement <4 x i64> <i64 4, i64 20, i64 300, i64 7000>, i32 %4
  ret i64 %5
}

