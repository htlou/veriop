define i4 @src(i4 noundef %a, i4 noundef %b) {
#0:
  %aw = zext i4 noundef %a to i8
  %bw = zext i4 noundef %b to i8
  %p = mul nuw i8 %aw, %bw
  %lo = trunc i8 %p to i4
  %hs = lshr i8 %p, 4
  %hi = trunc i8 %hs to i4
  %fold = xor i4 %lo, %hi
  ret i4 %fold
}
